i * 4] << 24) | (block[i * 4 + 1] << 16) | (block[i * 4 + 2] << 8) | block[i * 4 + 3]\\n        for i in range(16, 64):\\n            s0 = rotr(w[i - 15], 7) ^ rotr(w[i - 15], 18) ^ (w[i - 15] >> 3)\\n            s1 = rotr(w[i - 2], 17) ^ rotr(w[i - 2], 19) ^ (w[i - 2] >> 10)\\n            w[i] = (w[i - 16] + s0 + w[i - 7] + s1) & 0xFFFFFFFF\\n\\n        a, b, c, d, e, f, g, h = H\\n        for i in range(64):\\n            S1 = rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25)\\n            ch = (e & f) ^ ((0xFFFFFFFF ^ e) & g)\\n            temp1 = (h + S1 + ch + K[i] + w[i]) & 0xFFFFFFFF\\n            S0 = rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22)\\n            maj = (a & b) ^ (a & c) ^ (b & c)\\n            temp2 = (S0 + maj) & 0xFFFFFFFF\\n            h = g; g = f; f = e\\n            e = (d + temp1) & 0xFFFFFFFF\\n            d = c; c = b; b = a\\n            a = (temp1 + temp2) & 0xFFFFFFFF\\n\\n        H[0] = (H[0] + a) & 0xFFFFFFFF\\n        H[1] = (H[1] + b) & 0xFFFFFFFF\\n        H[2] = (H[2] + c) & 0xFFFFFFFF\\n        H[3] = (H[3] + d) & 0xFFFFFFFF\\n        H[4] = (H[4] + e) & 0xFFFFFFFF\\n        H[5] = (H[5] + f) & 0xFFFFFFFF\\n        H[6] = (H[6] + g) & 0xFFFFFFFF\\n        H[7] = (H[7] + h) & 0xFFFFFFFF\\n\\n    digest = ''.join(format(h, '08x') for h in H)\\n    vlmrun.log.print('ROUND2_SHA256=' + digest)\\n    return {'sha256': digest}\\n\"}"}}]},"index":0}],"system_fingerprint":"2026-05-19.0","session_id":"505a8b7f-74cc-4e51-bc35-ffce25649587"}

