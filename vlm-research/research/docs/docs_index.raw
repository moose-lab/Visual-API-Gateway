authentication\"}]},{\"group\":\"Platform\",\"pages\":[{\"title\":\"Pricing\",\"description\":\"How the Gateway bills a request. Live rates are on the model catalog.\",\"icon\":\"dollar-sign\",\"href\":\"/gateway/pricing\"},{\"title\":\"Rate Limits\",\"description\":\"Shared per-user budgets on public routes\",\"icon\":\"bolt-lightning\",\"href\":\"/gateway/rate-limits\"},{\"title\":\"Error Codes\",\"description\":\"HTTP errors from the Gateway API.\",\"icon\":\"circle-exclamation\",\"href\":\"/gateway/error-codes\"}]},{\"group\":\"OpenAI Compatibility\",\"pages\":[{\"title\":\"Visual Intelligence\",\"description\":\"VQA, detection, segmentation, pose, and document OCR through the OpenAI chat route\",\"icon\":\"eye\",\"href\":\"/gateway/visual-intelligence\"},{\"title\":\"Models\",\"description\":\"Gateway models live on the catalog.\",\"icon\":\"table-list\",\"href\":\"/gateway/models\"},{\"title\":\"Methods\",\"description\":\"Select what the model computes with method and method_params\",\"icon\":\"list-check\",\"href\":\"/gateway/methods\"},{\"title\":\"Response Formats\",\"description\":\"Text mode for agents, JSON mode and JSON schema mode for programmatic APIs\",\"icon\":\"brackets-curly\",\"href\":\"/gateway/response-formats\"},{\"title\":\"Supported Inputs\",\"description\":\"Content part types, per-modality limits, and format tradeoffs\",\"icon\":\"images\",\"href\":\"/gateway/multimodal-inputs\"},{\"title\":\"Response Types\",\"description\":\"Every payload type the Gateway returns for OCR, detection, segmentation, and keypoints\",\"icon\":\"shapes\",\"href\":\"/gateway/response-types\"},{\"title\":\"OpenAI SDK Compatibility\",\"description\":\"Point an existing OpenAI SDK client at the VLM Run Gateway\",\"icon\":\"arrow-right-arrow-left\",\"href\":\"/gateway/openai-compatibility\"}]},{\"group\":\"TypeSafe Compatibility\",\"pages\":[{\"title\":\"System One\",\"description\":\"Typed, calibrated decisions over text, JSON, and images in a single read\",\"ico