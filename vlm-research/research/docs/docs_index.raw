tlify-assets/_next/static/chunks/057c79b702cabd26.js?dpl=dpl_5S5n1ceL7YW6F9Hi3ne4FH8viMb1\",\"/mintlify-assets/_next/static/chunks/6cadf48bb7ae1a16.js?dpl=dpl_5S5n1ceL7YW6F9Hi3ne4FH8viMb1\",\"/mintlify-assets/_next/static/chunks/1a0bf1d33a977db0.js?dpl=dpl_5S5n1ceL7YW6F9Hi3ne4FH8viMb1\"],\"default\"]\n"])</script><script>self.__next_f.push([1,"5b:I[27201,[\"/mintlify-assets/_next/static/chunks/0ea0e179f06dc225.js?dpl=dpl_5S5n1ceL7YW6F9Hi3ne4FH8viMb1\",\"/mintlify-assets/_next/static/chunks/1e7a188add93a653.js?dpl=dpl_5S5n1ceL7YW6F9Hi3ne4FH8viMb1\"],\"IconMark\"]\n4b:[[\"$\",\"script\",null,{\"dangerouslySetInnerHTML\":{\"__html\":\"document.documentElement.setAttribute('data-page-mode', \\\"none\\\");\"}}],[\"$\",\"$L54\",null,{\"pageMetadata\":\"$44:props:pageMetadata\"}]]\n4c:[\"$\",\"$L55\",null,{\"pageMetadata\":\"$44:props:pageMetadata\"}]\n56:Ta233,"])</script><script>self.__next_f.push([1,"/* =============================================================================\n * VLM Run — Mintlify docs theme\n *\n * Mirrors the brand system defined in vlm-run/website\n * (tailwind.config.ts + app/globals.css + app/layout.tsx). Source of truth\n * for tokens lives in the website repo's CLAUDE.md \"Design Tokens\" table —\n * do not invent new colors here. If a color appears in design that is not\n * below, add it here first, then use it.\n *\n * Scope of this file (per docs theming brief):\n *   - Light mode is the priority; dark mode inherits Mintlify defaults.\n *   - Chrome + typography + components only. Not pixel-perfect parity with\n *     the marketing site.\n *\n * Fonts:\n *   - Body and headings → Aeonik Pro Regular, self-hosted in /fonts/\n *     (docs.json fonts.body.source and fonts.heading.source). Same file as\n *     vlm-run/website app/layout.tsx.\n * ========================================================================== */\n\n/* ----------------------------------------------------------------------------\n * 0a. Geist Mono — used by the website on table headers, first-column\n *     identifiers, and capability cells. Must precede all other rules\n *     because @import is only valid at the top of a stylesheet.\n * -------------------------------------------------------------------------- */\n\n@import url('https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400;500;600\u0026display=swap');\n\n/* ----------------------------------------------------------------------------\n * 1. Brand tokens\n * -------------------------------------------------------------------------- */\n\n:root {\n  /* `--vlm-primary` is the link / underline / active-state blue. We use\n     `primary-mid` (#1F5ACA) — the website's VlmLogo.tsx comment notes this is\n     \"the darker blue used by docs.vlm.run\". Reads more legibly than the\n     vivid `#1265FF` on long-form documentation pages. The vivid CTA blue\n     remains available below as `--vlm-primary-vivid`. */\n  --vlm-primary:        #1F5ACA;\n  --vlm-primary-hover:  #1848A2;\n  --vlm-primary-vivid:  #1265FF;\n  --vlm-primary-mid:    #1F5ACA;\n  --vlm-primary-dark:   #1848A2;\n  --vlm-primary-light:  #4D8BFF;\n  --vlm-primary-border: #234D9F;\n  --vlm-primary-tint:   #E0EAFA;\n  --vlm-primary-badge:  #EEF2F9;  /* dialed-down from #E6EDFC for subtler inline-code tint */\n\n  --vlm-navy:           #102A56;\n  --vlm-navy-dark:      #010917;\n  --vlm-navy-mid:       #102255;\n\n  --vlm-muted:          #576782;\n  /* Page surface: was #F5FAFF; toned to #FAFCFE so the cool tint does not\n     accumulate against the sidebar chrome and inline tints. */\n  --vlm-surface:        #FAFCFE;\n  --vlm-border:         #E1ECFA;  /* was #D1E9FF — paler to match lighter surface */\n  --vlm-dark-border:    #182231;\n\n  --vlm-toc-active:     #274275;\n\n  --vlm-cap-blue:       rgb(100, 151, 246);\n  --vlm-cap-green:      rgb(185, 246, 100);\n  --vlm-cap-purple:     rgb(177, 118, 255);\n\n  --vlm-shadow-btn:\n    rgba(0, 0, 0, 0.20) 0px -2px 0px 0px inset,\n    rgba(0, 0, 0, 0.20) 0px 1px 2px 0px;\n}\n\n/* Docs build version, surfaced as the footer freshness line. The value is\n   regenerated from public/VERSION by scripts/generate-version.mjs (run via\n   `make generate-version` and at Docker build time), so never edit it by hand. */\n/* GENERATED:docs-version:start — written by scripts/generate-version.mjs, do not edit by hand */\n:root {\n  --vlm-docs-version: \"Docs updated 2026-08-15\";\n}\n/* GENERATED:docs-version:end */\n\n/* ----------------------------------------------------------------------------\n * 2. Typography\n *    Mintlify renders Aeonik Pro on all h1-h6 once fonts.heading is\n *    set in docs.json. Heading sizes are Mintlify's defaults.\n * -------------------------------------------------------------------------- */\n\nbody {\n  color: var(--vlm-navy);\n  -webkit-font-smoothing: antialiased;\n  -moz-osx-font-smoothing: grayscale;\n}\n\nh1, h2, h3, h4, h5, h6 {\n  color: var(--vlm-navy);\n  letter-spacing: 0;\n}\n\n/* Mintlify's prose margins are 1.5em / 0.75em of the heading size, so an\n   h2 lands at 33px above and 17px below. Guide pages like docs.milliseconds.ai\n   use the looser Tailwind prose rhythm: 48px above an h2, 24px under it.\n   Direct children only, so headings inside cards and steps keep their own gaps.\n   A leading heading stays flush; #content already has mt-8 under the page title. */\n#content \u003e h2 {\n  margin-top: 3rem;\n  margin-bottom: 1.5rem;\n}\n\n#content \u003e h3 {\n  margin-top: 2.25rem;\n  margin-bottom: 1rem;\n}\n\n#content \u003e h4 {\n  margin-top: 1.75rem;\n  margin-bottom: 0.75rem;\n}\n\n#content \u003e :is(h2, h3, h4):first-child {\n  margin-top: 0;\n}\n\n/* A table was stacking three gaps: the previous block's margin, Mintlify's\n   scroll wrapper (my-1em + py-1em), and the table's own 1.5rem. That hole\n   showed up under a heading and under a normal paragraph. Keep the previous\n   block's margin and drop the wrapper and table top gaps. */\n#content \u003e :is(h2, h3, h4) + table {\n  margin-top: 0;\n}\n\n#content [data-table-wrapper=\"true\"] {\n  margin-top: 0;\n  padding-top: 0;\n}\n\n#content [data-table-wrapper=\"true\"] table {\n  margin-top: 0;\n}\n\n/* Long tables fold like expandable code: six rows, then “See all N rows”. */\n#content input.fold-rows {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  margin: 0;\n  opacity: 0;\n  pointer-events: none;\n}\n\n#content input.fold-rows:not(:checked) + [data-table-wrapper=\"true\"] tbody tr:nth-child(n + 7) {\n  display: none;\n}\n\n#content input.fold-rows:not(:checked) + [data-table-wrapper=\"true\"] {\n  position: relative;\n}\n\n#content input.fold-rows:not(:checked) + [data-table-wrapper=\"true\"]::after {\n  content: \"\";\n  position: absolute;\n  left: 0;\n  right: 0;\n  bottom: 0;\n  height: 2.75rem;\n  background: linear-gradient(to bottom, transparent, #fff);\n  pointer-events: none;\n}\n\n#content label.fold-rows-label {\n  display: flex;\n  justify-content: center;\n  margin-top: 0.25rem;\n  margin-bottom: 1.5rem;\n  font-size: 0.75rem;\n  font-weight: 500;\n  color: var(--vlm-muted);\n  cursor: pointer;\n}\n\n#content input.fold-rows:checked + [data-table-wrapper=\"true\"] + label.fold-rows-label .when-closed,\n#content input.fold-rows:not(:checked) + [data-table-wrapper=\"true\"] + label.fold-rows-label .when-open {\n  display: none;\n}\n\n/* Page tabs stay an underline row. Bigger type, navy instead of link blue. */\n#content [data-component-part=\"tabs-list\"] {\n  margin-top: 1.75rem !important;\n  gap: 1.75rem !important;\n}\n\n#content [data-component-part=\"tab-button\"] {\n  padding-top: 0.85rem !important;\n  padding-bottom: 0.7rem !important;\n  border-bottom-width: 2px !important;\n  color: var(--vlm-muted) !important;\n  font-size: 1rem !important;\n  font-weight: 500 !important;\n  line-height: 1.5rem !important;\n}\n\n#content [data-component-part=\"tab-button\"]:hover {\n  color: var(--vlm-navy) !important;\n}\n\n#content [data-component-part=\"tab-button\"][data-active=\"true\"] {\n  color: var(--vlm-navy) !important;\n  border-bottom-color: var(--vlm-navy) !important;\n}\n\np, li {\n  color: var(--vlm-muted);\n  letter-spacing: -0.01em;\n}\n\n/* ----------------------------------------------------------------------------\n * 2b. Sidebar group headings\n *     Same Geist Mono uppercase treatment as `thead th` (section 10), so a\n *     section label reads as a label rather than as a smaller page link.\n *     Scoped to #navigation-items, not #sidebar: the mobile drawer renders the\n *     same headers outside #sidebar, so an #sidebar rule silently skips mobile.\n *     Mintlify ships the heading as `.sidebar-group-header` wrapping an\n *     `h3.sidebar-title`; the inner element inherits font and size from the\n *     wrapper via Tailwind's `font-[inherit]`, so both are targeted to beat\n *     the utility classes on it.\n * -------------------------------------------------------------------------- */\n\n#navigation-items .sidebar-group-header,\n#navigation-items .sidebar-group-header .sidebar-title {\n  font-family: 'Geist Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;\n  font-size: 11px;\n  font-weight: 500;\n  letter-spacing: 0.12em;\n  text-transform: uppercase;\n  color: var(--vlm-muted);\n}\n\n/* ----------------------------------------------------------------------------\n * 3. Links\n *    Brand blue with the same 300ms ease-out feel as the website.\n * -------------------------------------------------------------------------- */\n\na {\n  color: var(--vlm-primary);\n  transition: color 200ms ease-out, opacity 200ms ease-out;\n}\n\na:hover {\n  color: var(--vlm-primary-hover);\n}\n\n/* In-prose links keep an underline for accessibility */\n.prose a,\narticle a {\n  text-decoration-color: color-mix(in srgb, var(--vlm-primary) 35%, transparent);\n  text-underline-offset: 3px;\n  transition: text-decoration-color 200ms ease-out, color 200ms ease-out;\n}\n\n.prose a:hover,\narticle a:hover {\n  text-decoration-color: var(--vlm-primary);\n}\n\n/* ----------------------------------------------------------------------------\n * 4. Primary CTA (top-right \"Dashboard\" button + any other primary navbar CTA)\n *    Match the website's primary-mid pill: 20px radius, navy border, inset\n *    shadow, hover lift. We target generic \"primary button\" patterns Mintlify\n *    uses; if a future Mintlify release renames classes, only this block\n *    needs to be retuned.\n * -------------------------------------------------------------------------- */\n\n#navbar a[href=\"https://app.vlm.run\"],\n.navbar a[href=\"https://app.vlm.run\"],\nheader a[href=\"https://app.vlm.run\"] {\n  border-radius: 20px !important;\n  border: 1px solid var(--vlm-primary-border) !important;\n  background-color: var(--vlm-primary-mid) !important;\n  color: #fff !important;\n  box-shadow: var(--vlm-shadow-btn);\n  transition:\n    transform 300ms ease-out,\n    box-shadow 300ms ease-out,\n    background-color 300ms ease-out,\n    opacity 300ms ease-out;\n}\n\n#navbar a[href=\"https://app.vlm.run\"]:hover,\n.navbar a[href=\"https://app.vlm.run\"]:hover,\nheader a[href=\"https://app.vlm.run\"]:hover {\n  transform: translateY(-1px);\n  background-color: var(--vlm-primary-dark) !important;\n  opacity: 0.95;\n}\n\n/* ----------------------------------------------------------------------------\n * 5. Sidebar / left navigation\n *    Active item picks up brand blue; everything else stays navy.\n * -------------------------------------------------------------------------- */\n\n/* #navigation-items, not #sidebar: the mobile drawer renders the same links\n   outside #sidebar, so an #sidebar rule silently skips every phone. */\n#navigation-items a,\n#sidebar a,\nnav[aria-label=\"Sidebar\"] a {\n  color: var(--vlm-navy);\n}\n\n#navigation-items a:hover,\n#sidebar a:hover,\nnav[aria-label=\"Sidebar\"] a:hover {\n  color: var(--vlm-primary);\n}\n\n#navigation-items a[aria-current=\"page\"],\n#navigation-items a[data-active=\"true\"],\n#sidebar a[aria-current=\"page\"],\n#sidebar a[data-active=\"true\"],\nnav[aria-label=\"Sidebar\"] a[aria-current=\"page\"] {\n  color: var(--vlm-primary) !important;\n  font-weight: 500;\n}\n\n/* Nested pages use the same inline padding as their group row, so a child\n   sits almost flush with its parent. Step each nesting level in. */\n#navigation-items li li \u003e a,\n#navigation-items li li \u003e div \u003e a,\n#navigation-items li li \u003e button,\n#navigation-items li li \u003e div \u003e button {\n  padding-left: 2.5rem !important;\n}\n\n#navigation-items li li li \u003e a,\n#navigation-items li li li \u003e div \u003e a,\n#navigation-items li li li \u003e button,\n#navigation-items li li li \u003e div \u003e button {\n  padding-left: 3.5rem !important;\n}\n\n/* ----------------------------------------------------------------------------\n * 6. \"On this page\"\n *    The label is an h2, so the default heading size would paint it large\n *    and the column sits 16.5rem wide beside the article. A quiet 13px\n *    index, pinned to the right, leaves a wider gutter and a wider article.\n * -------------------------------------------------------------------------- */\n\n/* API pages put the request and response panels in this same column, so\n   only size it down when it holds the index. */\n#content-side-layout:has(#table-of-contents) {\n  width: max-content !important;\n  max-width: 13rem !important;\n  margin-left: 0 !important;\n  margin-right: 0.75rem !important;\n  padding-right: 0 !important;\n  align-items: flex-end !important;\n  flex: 0 0 auto !important;\n  box-sizing: border-box !important;\n}\n\n/* Center the article between the sidebar and the index. API pages have no\n   #content, so their header keeps its natural left edge and lines up with the\n   body. */\n@media (min-width: 1280px) {\n  #content-area {\n    width: auto !important;\n    max-width: none !important;\n    flex: 1 1 auto !important;\n    margin-left: 0 !important;\n    margin-right: 0 !important;\n    padding-left: 2rem !important;\n    padding-right: 2rem !important;\n  }\n\n  #content-area:has(#content) \u003e header,\n  #content {\n    width: 100%;\n    max-width: 48rem;\n    margin-left: auto !important;\n    margin-right: auto !important;\n  }\n}\n\n#table-of-contents-layout {\n  width: max-content !important;\n  max-width: 13rem !important;\n  margin-left: auto !important;\n  padding-left: 0 !important;\n  padding-right: 0 !important;\n}\n\n#table-of-contents {\n  width: max-content !important;\n  max-width: 13rem !important;\n}\n\n#content-side-layout:has(#table-of-contents) h2 {\n  font-family: 'Aeonik Pro', ui-sans-serif, system-ui, sans-serif !important;\n  font-size: 0.8125rem !important;\n  line-height: 1.25rem !important;\n  font-weight: 500 !important;\n  letter-spacing: 0.01em !important;\n  color: var(--vlm-muted) !important;\n}\n\n#table-of-contents-content a,\n#table-of-contents a {\n  font-size: 0.8125rem !important;\n  line-height: 1.25rem !important;\n  color: var(--vlm-muted) !important;\n}\n\n#content-area {\n  width: auto !important;\n  max-width: none !important;\n}\n\n#content {\n  max-width: 48rem;\n}\n\n/* Pull a trailing word back onto the line above in short lists. */\n#content li {\n  text-wrap: pretty;\n}\n\n#toc a[aria-current=\"true\"],\n#toc a[aria-current=\"location\"],\n#toc a[data-active=\"true\"],\nnav[aria-label=\"On this page\"] a[aria-current=\"true\"],\nnav[aria-label=\"On this page\"] a[aria-current=\"location\"],\nnav[aria-label=\"On this page\"] a[data-active=\"true\"],\n#table-of-contents a[aria-current=\"true\"],\n#table-of-contents a[aria-current=\"location\"],\n#table-of-contents a[data-active=\"true\"] {\n  color: var(--vlm-toc-active) !important;\n  font-weight: 500;\n  box-shadow: none !important;\n  border: none !important;\n  padding-left: 0 !important;\n}\n\n/* ----------------------------------------------------------------------------\n * 7. Card (Mintlify \u003cCard\u003e + \u003cCards\u003e)\n *    Was: solid #f9f9f9 fill that fought the surface bg.\n *    Now: white card on surface, brand border, hover lift.\n * -------------------------------------------------------------------------- */\n\n.card,\n[class*=\"card\"][role=\"link\"],\na.card {\n  background-color: #ffffff;\n  border: 1px solid var(--vlm-border);\n  border-radius: 12px;\n  transition:\n    transform 300ms ease-out,\n    border-color 300ms ease-out,\n    box-shadow 300ms ease-out;\n}\n\n.card:hover,\n[class*=\"card\"][role=\"link\"]:hover,\na.card:hover {\n  transform: translateY(-1px);\n  border-color: var(--vlm-primary);\n  box-shadow: 0 4px 12px -4px color-mix(in srgb, var(--vlm-primary) 20%, transparent);\n}\n\n.card-demo {\n  color: var(--vlm-primary-mid);\n  background-color: var(--vlm-primary-tint);\n  border-color: var(--vlm-primary-tint);\n}\n\n/* ----------------------------------------------------------------------------\n * 8. Callouts: \u003cNote\u003e, \u003cTip\u003e, \u003cInfo\u003e, \u003cWarning\u003e, \u003cCheck\u003e\n *    Mintlify ships these with bg-*-50 / border-*-200 utility patterns.\n *    We re-tint Info/Note/Tip with brand-coherent values. Warning kept stock.\n * -------------------------------------------------------------------------- */\n\n/* Info / Note — soft brand-blue tint */\n.callout-info,\n[role=\"note\"][data-type=\"info\"],\n[role=\"note\"][data-type=\"note\"] {\n  background-color: var(--vlm-primary-badge);\n  border-color: var(--vlm-border);\n  color: var(--vlm-navy);\n}\n\n/* Tip — capability-green tint */\n.callout-tip,\n[role=\"note\"][data-type=\"tip\"] {\n  background-color: color-mix(in srgb, var(--vlm-cap-green) 18%, white);\n  border-color: color-mix(in srgb, var(--vlm-cap-green) 45%, white);\n  color: var(--vlm-navy);\n}\n\n/* ----------------------------------------------------------------------------\n * 9. Code blocks\n *    Mintlify is doing the Shiki theming via docs.json (github-light /\n *    dark-plus) and already wraps the code block in a bordered, rounded\n *    container (`data-component-part=\"code-block-root\"`). We deliberately\n *    do not add a second border on the inner \u003cpre\u003e, which would otherwise\n *    show as a faint hairline just inside Mintlify's chrome.\n * -------------------------------------------------------------------------- */\n\npre,\n[class*=\"code-block\"] pre {\n  border: 0;\n  border-radius: 0;\n  background: transparent;\n}\n\n/* Inline code is a quiet token, not a second link. Links stay primary\n   blue; a field name stays navy on a neutral chip so a sentence of\n   identifiers does not turn into a run of blue. */\n:not(pre) \u003e code {\n  background-color: #F0F2F5;\n  color: var(--vlm-navy);\n  padding: 0.05rem 0.15rem;\n  border-radius: 4px;\n  font-size: 0.875em;\n}\n\n#content a code,\n#header a code {\n  color: inherit;\n}\n\n/* Group label above the page title (Mintlify `.eyebrow`). The title\n   and description already name the page. */\n#header .eyebrow {\n  display: none;\n}\n\n/* ----------------------------------------------------------------------------\n * 10. Tables — mirror the website's PricingTable card treatment\n *     (vlm-run/website ▸ components/sections/PricingTable.tsx).\n *\n *     • Outer table reads as a bordered card (1px border, 6px radius,\n *       white body, surface-tinted header row).\n *     • Header cells: Geist Mono, 11px, 0.12em tracking, uppercase, navy.\n *     • First-column body cells: Geist Mono, 13px medium, navy — same\n *       treatment for any cell explicitly aligned center/right (where\n *       the website expects numeric / token-style values).\n *     • Other left-aligned body cells: sans, navy/80, 14px — for prose\n *       columns like \"When to use\" or \"Notes\".\n *     • Hairline horizontal separators between rows; no zebra stripes,\n *       no vertical dividers, no border under the last row.\n *\n *     The selectors target raw HTML \u003ctable\u003e the way Mintlify's MDX\n *     emits it (no Mintlify-specific wrapper class is required).\n * -------------------------------------------------------------------------- */\n\n/* The table itself plays the role of the website's wrapping \u003cdiv\u003e: it\n   carries the border, radius, and white background. `border-collapse:\n   separate` is required so border-radius actually clips the corners.\n   Note: `overflow: hidden` does NOT reliably clip \u003cthead\u003e/\u003ctbody\u003e\n   backgrounds in Chrome (table elements form their own layout root),\n   so we explicitly round the four corner cells below to keep the\n   surface-tint header from bleeding past the rounded outer border. */\n/* A heading's own margin-bottom is the gap. Mintlify wraps a table in a\n   scroll container with its own top margin and padding, and the table adds\n   another 1.5rem, so a heading followed by a table opens a hole. */\n#content \u003e :is(h2, h3, h4) + [data-table-wrapper] {\n  margin-top: 0 !important;\n  padding-top: 0 !important;\n}\n#content \u003e :is(h2, h3, h4) + [data-table-wrapper] table {\n  margin-top: 0;\n}\n\ntable {\n  width: 100%;\n  margin: 1.5rem 0;\n  border: 1px solid var(--vlm-border) !important;\n  border-radius: 6px;\n  border-collapse: separate !important;\n  border-spacing: 0 !important;\n  background-color: #ffffff;\n  font-size: 0.875rem;        /* text-body-sm (14px) */\n  color: var(--vlm-navy);\n}\n\n/* Header cells — surface tint applied per \u003cth\u003e (NOT per \u003ctr\u003e) so the\n   corner cells' border-radius can clip the tint to the rounded outer\n   border. */\nthead th {\n  background-color: var(--vlm-surface);\n  border: 0 !important;\n  border-bottom: 1px solid var(--vlm-border) !important;\n  /* 11.2px / 16px — a 20% trim from the previous 14/20, tighter than the\n     website's `py-3 px-5` on PricingTable.tsx for a more compact docs\n     reading rhythm. `!important` is required because Mintlify's Tailwind\n     Typography plugin ships `.prose :where(thead th)` with `padding-top: 0`,\n     which beats a plain `thead th` rule on specificity (0,1,0 vs 0,0,2). */\n  padding: 0.7rem 1rem !important;\n  font-family: 'Geist Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;\n  font-size: 11px;\n  font-weight: 500;\n  letter-spacing: 0.12em;\n  text-transform: uppercase;\n  color: var(--vlm-navy);\n  /* Center text within the padded header band so top + bottom breathe\n     symmetrically. `bottom` pinned the labels to the divider line. */\n  vertical-align: middle;\n}\n\n/* Unit hint in a price header. The repeated \"USD per 1M tokens\" line under\n   each table is this mark instead: one ? on the column that needs the unit. */\nthead th .unit-help {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: 0.875rem;\n  height: 0.875rem;\n  margin-left: 0.35rem;\n  border: 1px solid var(--vlm-border);\n  border-radius: 999px;\n  background: #fff;\n  color: var(--vlm-muted);\n  font-family: 'Aeonik Pro', ui-sans-serif, system-ui, sans-serif;\n  font-size: 0.625rem;\n  font-weight: 600;\n  letter-spacing: 0;\n  text-transform: none;\n  line-height: 1;\n  text-decoration: none;\n  vertical-align: 1px;\n  cursor: help;\n}\n\nthead th button:has(.unit-help) {\n  display: inline-flex;\n  align-items: center;\n  margin: 0;\n  padding: 0;\n  border: 0;\n  background: transparent;\n  color: inherit;\n  font: inherit;\n  letter-spacing: 0;\n  text-transform: none;\n  vertical-align: middle;\n  cursor: help;\n}\n\n/* Round the four corner cells to match the table's outer border-radius\n   so the surface tint and white body don't bleed past the rounded\n   outline. (overflow: hidden on \u003ctable\u003e doesn't clip reliably in Chrome.) */\nthead tr:first-child th:first-child {\n  border-top-left-radius: 6px;\n}\n\nthead tr:first-child th:last-child {\n  border-top-right-radius: 6px;\n}\n\ntbody tr:last-child td:first-child {\n  border-bottom-left-radius: 6px;\n}\n\ntbody tr:last-child td:last-child {\n  border-bottom-right-radius: 6px;\n}\n\n/* Multi-row headers (e.g. the rowspan/colspan domain table): the second\n   header row sits inside \u003cthead\u003e but should not have its own border.\n   `!important` on padding for the same prose-specificity reason as the\n   primary `thead th` rule above. */\nthead tr + tr th {\n  border-bottom: 1px solid var(--vlm-border) !important;\n  padding-top: 0.5rem !important;\n  padding-bottom: 0.75rem !important;\n  font-size: 10.5px;\n}\n\n/* Header cells with explicit align attributes still respect them */\nthead th[align=\"left\"]   { text-align: left; }\nthead th[align=\"center\"] { text-align: center; }\nthead th[align=\"right\"]  { text-align: right; }\n\n/* Inline \u003ccode\u003e inside header cells should look like uppercase mono text,\n   not a chip — the chip treatment is for body / prose code only. */\nthead th code {\n  background: transparent !important;\n  color: var(--vlm-navy) !important;\n  padding: 0 !important;\n  font-size: inherit !important;\n  letter-spacing: 0.12em !important;\n  text-transform: uppercase !important;\n}\n\n/* Body cells — generous padding, hairline rule between rows */\ntbody tr {\n  background-color: #ffffff;\n}\n\ntbody td {\n  border: 0 !important;\n  border-bottom: 1px solid var(--vlm-border) !important;\n  /* 11.2px / 16px — a 20% trim from the previous 14/20 to match the\n     header band's compact rhythm. Tighter than the website's `py-4 px-5`\n     because docs body cells are usually single-line prose, not pricing\n     tier cards. `!important` for the same prose-specificity reason as\n     the `thead th` rule above. */\n  padding: 0.7rem 1rem !important;\n  vertical-align: middle;     /* center single-line cells; multi-line wraps still anchor cleanly */\n  color: var(--vlm-navy);\n  line-height: 1.55;\n}\n\n/* For multi-line cells (e.g. agent-pricing notes column) we want top\n   alignment so the first line lines up with the first col identifier. */\ntbody td:has(br),\ntbody td:has(ul),\ntbody td:has(p) {\n  vertical-align: top;\n}\n\ntbody td ul {\n  margin: 0;\n  padding-left: 1.25rem;\n}\n\ntbody td li + li {\n  margin-top: 0.35em;\n}\n\ntbody td li kbd {\n  font-family: 'Geist Mono', ui-monospace, monospace;\n  font-weight: 600;\n  font-size: 0.8125rem;\n  line-height: 1.3;\n  letter-spacing: -0.01em;\n  color: var(--vlm-navy);\n  background: transparent;\n  border: 1px solid var(--vlm-border);\n  padding: 0.05rem 0.3rem;\n  margin: 0;\n  border-radius: 3px;\n  white-space: nowrap;\n  box-shadow: none !important;\n  text-shadow: none;\n  filter: none;\n  -webkit-box-shadow: none !important;\n}\n\n/* Keep inline identifiers (e.g. `document.markdown`,\n   `healthcare.phi-redaction`) from breaking mid-token. Scoped to \u003ccode\u003e\n   tokens specifically so prose-style first-column cells (like\n   \"All Redaction \u0026 Edit Domains\" with a long sub-list) can still wrap.\n   The website achieves the same effect by setting explicit column\n   widths in its PricingTable component. */\ntable code {\n  white-space: nowrap;\n}\n\n/* Drop the bottom rule on the final row so the rounded card stays clean */\ntbody tr:last-child td {\n  border-bottom: 0 !important;\n}\n\n/* Slight extra gutter on the first/last columns so content doesn't crowd\n   the card edge. Scaled down with the rest of the table padding: 28 →\n   22 → 18 across the recent tightening passes. `!important` overrides\n   Mintlify's prose `padding-inline-start/end: 0` on first/last cells. */\nthead th:first-child,\ntbody td:first-child {\n  padding-left: 1.125rem !important;     /* 18px */\n}\n\nthead th:last-child,\ntbody td:last-child {\n  padding-right: 1.125rem !important;    /* 18px */\n}\n\n/* Tables with rotated/vertical row-header labels in the first column\n   (e.g. the agents/introduction model comparison). Rotated text only\n   needs ~22px of width so the column padding is cut down sharply on\n   both the header and body cells. Scoped via `.rotated-row-headers`\n   so normal first-column \"key\" cells (pricing tables etc.) keep the\n   wider gutter. */\n.rotated-row-headers thead th:first-child,\n.rotated-row-headers tbody td:first-child {\n  padding-left: 0.5rem !important;       /* 8px */\n  padding-right: 0.5rem !important;      /* 8px */\n}\n\n/* Vertical divider between the row-header axis and the data columns —\n   body rows only. The header row keeps the seamless top band so the\n   tinted thead background reads as one continuous strip across the\n   table top. */\n.rotated-row-headers tbody td:first-child {\n  border-right: 1px solid var(--vlm-border) !important;\n}\n\n/* First column gets the navy \"key\" treatment but stays in the sans\n   body font — mono is reserved for column headers and inline \u003ccode\u003e\n   identifiers (handled by the rules below). Both selectors are needed\n   because rowspan'd row-headers (e.g. agents/introduction comparison)\n   shift the opening row's task label into td:nth-child(2); without\n   the +td rule that label would lose the medium-weight/navy treatment\n   that subsequent rows' first-children get, producing a row-to-row\n   visual mismatch. */\ntbody td:first-child,\ntbody td[rowspan] + td {\n  font-weight: 500;\n  color: var(--vlm-navy);\n}\n\n/* Centered \u0026 right-aligned body cells stay in sans for prose, but\n   render numeric tokens (single digits, \"+2\", \"1.0×\", etc.) at the\n   same medium-navy weight so the column rhythm holds. */\ntbody td[align=\"center\"],\ntbody td[align=\"right\"] {\n  font-weight: 500;\n  color: var(--vlm-navy);\n}\n\n/* Inline \u003ccode\u003e in any cell — including numeric centered cells\n   that happen to wrap their value in \u003ccode\u003e — uses the same mono\n   face the website applies to identifier-style values. */\ntable code {\n  font-family: 'Geist Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;\n  font-size: 13px;\n  font-weight: 500;\n}\n\n/* Honour explicit align attributes coming from the MDX */\ntd[align=\"left\"]   { text-align: left; }\ntd[align=\"center\"] { text-align: center; }\ntd[align=\"right\"]  { text-align: right; }\n\n/* Inline \u003ccode\u003e inside body cells: drop the prose chip background and\n   inherit the cell's mono-navy treatment, mirroring how the website's\n   PricingTable renders raw identifiers (e.g. `document.*`, `flex`).\n   The chipped primary-tint variant is reserved for inline code in\n   *prose* (handled by the `:not(pre) \u003e code` rule above). */\ntbody td code {\n  background: transparent !important;\n  color: inherit !important;\n  padding: 0 !important;\n  font-size: inherit !important;\n  border-radius: 0 !important;\n  font-weight: inherit !important;\n}\n\n/* Tables nested inside \u003cAccordion\u003e bodies (the agent pricing examples)\n   should still render as cards, but at a slightly tighter rhythm. */\n.accordion table,\n[data-accordion-content] table {\n  margin: 0.75rem 0;\n  font-size: 0.8125rem;       /* 13px */\n}\n\n.accordion tbody td,\n[data-accordion-content] tbody td,\n.accordion thead th,\n[data-accordion-content] thead th {\n  padding: 0.75rem 1rem !important;      /* 12px 16px */\n}\n\n.accordion thead th:first-child,\n[data-accordion-content] thead th:first-child,\n.accordion tbody td:first-child,\n[data-accordion-content] tbody td:first-child {\n  padding-left: 1.25rem !important;\n}\n\n.accordion thead th:last-child,\n[data-accordion-content] thead th:last-child,\n.accordion tbody td:last-child,\n[data-accordion-content] tbody td:last-child {\n  padding-right: 1.25rem !important;\n}\n\n/* Gateway /models catalog tables — compact type, wrapped status band, no\n   horizontal scroll on the main content column. Scoped via\n   `.gateway-models-catalog` wrappers in gateway/models.mdx. */\n.gateway-models-catalog table {\n  table-layout: fixed;\n  width: 100%;\n  font-size: 0.8125rem;       /* 13px */\n}\n\n.gateway-models-catalog thead th {\n  padding: 0.5rem 0.625rem !important;\n  font-size: 10px;\n  letter-spacing: 0.08em;\n  line-height: 1.35;\n  white-space: normal;\n  vertical-align: bottom;\n}\n\n.gateway-models-catalog tbody td {\n  padding: 0.5rem 0.625rem !important;\n  font-size: 0.8125rem;\n  line-height: 1.45;\n  vertical-align: top;\n}\n\n.gateway-models-catalog thead th:first-child,\n.gateway-models-catalog tbody td:first-child {\n  width: 26%;\n  padding-left: 0.75rem !important;\n  white-space: normal;\n  word-break: break-word;\n}\n\n.gateway-models-catalog thead th:nth-child(2),\n.gateway-models-catalog tbody td:nth-child(2) {\n  width: 4.75rem;\n  max-width: 4.75rem;\n  white-space: normal;\n  word-break: break-word;\n  hyphens: auto;\n  text-align: center;\n  font-size: 0.75rem;         /* 12px */\n  line-height: 1.35;\n}\n\n.gateway-models-catalog table code {\n  white-space: normal;\n  word-break: break-word;\n  font-size: 0.75rem;         /* 12px */\n}\n\n.gateway-models-catalog tbody td:first-child a {\n  word-break: break-word;\n}\n\n.gateway-models-catalog thead th:last-child,\n.gateway-models-catalog tbody td:last-child {\n  padding-right: 0.75rem !important;\n}\n\n/* Dark mode: drop the white card so Mintlify's stock dark-mode tables\n   show through. The chrome above is calibrated for the brand light\n   surface; in dark mode we let Mintlify own the look. */\nhtml.dark table {\n  background-color: transparent;\n  border-color: var(--vlm-dark-border) !important;\n}\n\nhtml.dark thead tr,\nhtml.dark thead tr th,\nhtml.dark tbody tr {\n  background-color: transparent;\n}\n\nhtml.dark thead th,\nhtml.dark tbody td {\n  color: inherit;\n  border-color: var(--vlm-dark-border) !important;\n}\n\n/* ----------------------------------------------------------------------------\n * 11. Integration hero — programmatic \"VLM Run × \u003cpartner\u003e\" figure\n *\n *     One CSS class for every integration page; replaces per-page\n *     composite images. Pairs the brand backdrop in /assets/blog-backdrop.png\n *     with two square logo tiles (vlm-run on the left, partner on the\n *     right) so adding a new integration is just a 3-line MDX block plus\n *     dropping the partner logo into /assets/integrations/.\n *\n *     Usage in MDX:\n *       \u003cdiv className=\"integration-hero\"\u003e\n *         \u003cdiv className=\"integration-hero-tile\"\u003e\n *           \u003cimg src=\"/assets/logo/vlm-run-icon.svg\" alt=\"VLM Run\" /\u003e\n *         \u003c/div\u003e\n *         \u003cdiv className=\"integration-hero-tile\"\u003e\n *           \u003cimg src=\"/assets/integrations/\u003cpartner\u003e.svg\" alt=\"\u003cPartner\u003e\" /\u003e\n *         \u003c/div\u003e\n *       \u003c/div\u003e\n * -------------------------------------------------------------------------- */\n\n.integration-hero {\n  width: 100%;\n  /* 2:1 keeps the backdrop's swirl readable without dominating the\n     above-the-fold space — matches the proportions of the existing\n     pre-composited integration heroes. */\n  aspect-ratio: 1024 / 500;\n  background-image: url('/assets/blog-backdrop.png');\n  background-size: cover;\n  background-position: center;\n  border: 1px solid var(--vlm-border);\n  border-radius: 8px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 4%;\n  margin: 1.5rem 0 2rem;\n  overflow: hidden;\n}\n\n.integration-hero-tile {\n  /* Tile width is a percentage of the hero so the layout scales with\n     the docs content column (which Mintlify resizes between ~720px and\n     ~1100px depending on viewport + sidebar state). */\n  width: 17.6%;\n  aspect-ratio: 1 / 1;\n  /* 96% alpha lets the backdrop tone through faintly so the tiles feel\n     \"set into\" the hero rather than stamped on top — softer than a\n     flat #ffffff. */\n  background-color: rgba(255, 255, 255, 0.96);\n  /* 1px hairline using the standard table/card border token instead of\n     the heavier 2px primary-light blue. Pairs with a light shadow for\n     depth that reads as subtle elevation, not a hard outline. */\n  border: 1px solid var(--vlm-border);\n  border-radius: 12px;\n  box-shadow:\n    0 1px 2px rgba(16, 42, 86, 0.04),\n    0 4px 12px rgba(31, 90, 202, 0.05);\n  overflow: hidden;\n}\n\n/* Mintlify's zoom wrapper is `display: contents`, so the img is a\n   direct child of the tile and prose margins drop it onto the\n   baseline. Center it on the tile. Percentage padding cannot live on\n   the tile: it resolves against the wide hero, not the tile, and\n   collapses the content box. Size the img instead. */\n.integration-hero-tile {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n\n.integration-hero-tile img,\n.integration-hero-tile svg {\n  display: block;\n  width: 60%;\n  height: 60%;\n  max-width: 60%;\n  margin: 0 !important;\n  object-fit: contain;\n  object-position: center;\n}\n\n/* Wide and tall marks letterbox inside a square. Size the box so the\n   drawn ink matches the VLM mark's height (wide) or width (tall). */\n.integration-hero-tile:has(img[alt=\"n8n\"]) img {\n  width: 90%;\n  height: 90%;\n  max-width: 90%;\n}\n\n.integration-hero-tile:has(img[alt=\"Zapier\"]) img {\n  width: 56%;\n  height: 56%;\n  max-width: 56%;\n}\n\n.integration-hero-tile:has(img[alt=\"MongoDB\"]) img {\n  width: 88%;\n  height: 88%;\n  max-width: 88%;\n}\n\n.integration-hero-tile:has(img[alt=\"Voxel51 FiftyOne\"]) img {\n  width: 68%;\n  height: 68%;\n  max-width: 68%;\n}\n\n.platform-figure {\n  position: relative;\n  border: 1px solid var(--vlm-border);\n  border-radius: 8px;\n  /* Bottom padding clears the screenshot's 12px/32px drop shadow.\n     overflow:hidden clips that shadow into the frame edge otherwise. */\n  padding: 3.5% 3% 56px;\n  margin: 1.5rem 0 2rem;\n  overflow: hidden;\n  background-color: #ffffff;\n}\n\n.platform-figure::before {\n  content: \"\";\n  position: absolute;\n  inset: 0;\n  background-image: url('/images/platform-background.png');\n  background-size: cover;\n  background-position: center;\n  background-repeat: no-repeat;\n  opacity: 0.6;\n  pointer-events: none;\n  z-index: 0;\n}\n\n/* Lift the screenshot above the backdrop layer.\n   Local Mintlify wraps images in [data-rmiz]. The published site wraps\n   them in display:contents \u003cpicture\u003e, which does not generate a box, so\n   z-index on the wrapper never applies and the ::before paints over the\n   image. Position the img itself. */\n.platform-figure \u003e *,\n.platform-figure img {\n  position: relative;\n  z-index: 1;\n}\n\n.platform-figure img {\n  display: block;\n  width: 100%;\n  height: auto;\n  border-radius: 16px;\n  border: 1px solid var(--vlm-border);\n  box-shadow:\n    0 1px 2px rgba(16, 42, 86, 0.10),\n    0 12px 32px rgba(31, 90, 202, 0.14);\n}\n\n.platform-card-grid .card img,\n.platform-card-grid [class*=\"card\"][role=\"link\"] img {\n  background-color: #ffffff;\n  background-image: url('/images/platform-background.png');\n  background-size: cover;\n  background-position: center;\n  background-repeat: no-repeat;\n  padding: 14px;\n  box-sizing: border-box;\n  border-radius: 10px 10px 0 0;\n  border: 1px solid var(--vlm-border);\n  border-bottom: 0;\n  box-shadow: 0 1px 2px rgba(16, 42, 86, 0.05);\n}\n\n/* ----------------------------------------------------------------------------\n * 12. Domain catalog tags  (legacy; retuned to capability palette)\n * -------------------------------------------------------------------------- */\n\n.domain-column {\n  width: 240px;\n  display: inline-block;\n}\n\n.function-column {\n  width: 240px;\n  display: inline-block;\n}\n\n.allowed-inputs-column {\n  width: 160px;\n  display: inline-block;\n}\n\n.description-column {\n  width: 100%;\n  display: inline-block;\n}\n\n.tag {\n  padding: 2px 8px;\n  border-radius: 12px;\n  font-size: 0.9em;\n  font-weight: 500;\n  display: inline-block;\n  margin-right: 8px;\n  margin-bottom: 4px;\n}\n\n/* Document AI — capability green */\n.tag-document {\n  background: color-mix(in srgb, var(--vlm-cap-green) 22%, white);\n  color: #2F6B14;\n}\n\n/* Image AI — capability blue */\n.tag-image {\n  background: color-mix(in srgb, var(--vlm-cap-blue) 22%, white);\n  color: var(--vlm-primary-dark);\n}\n\n/* Video AI — capability purple */\n.tag-video {\n  background: color-mix(in srgb, var(--vlm-cap-purple) 22%, white);\n  color: #5A2BB8;\n}\n\n/* Audio AI — primary-light tint */\n.tag-audio {\n  background: var(--vlm-primary-badge);\n  color: var(--vlm-primary-dark);\n}\n\n/* URL inputs — primary-blue tint */\n.tag-url {\n  background: var(--vlm-primary-badge);\n  color: var(--vlm-primary-dark);\n}\n\n/* Schema reference — softer purple than video to differentiate */\n.tag-ref {\n  background: color-mix(in srgb, var(--vlm-cap-purple) 14%, white);\n  color: #5A2BB8;\n}\n\n/* ----------------------------------------------------------------------------\n * 12. Utility classes ported from website's globals.css\n * -------------------------------------------------------------------------- */\n\n.no-scrollbar {\n  scrollbar-width: none;\n  -ms-overflow-style: none;\n}\n\n.no-scrollbar::-webkit-scrollbar {\n  display: none;\n}\n\n.glass {\n  background: rgba(255, 255, 255, 0.05);\n  border: 1px solid rgba(255, 255, 255, 0.1);\n}\n\n.shadow-btn {\n  box-shadow: var(--vlm-shadow-btn);\n}\n\n/* --------------------------------------------------------------------------\n * 13. Footer docs-version line\n *\n * The footer (`#footer`) is a `justify-between` flex row holding the social\n * icons on the left and the \"Powered by Mintlify\" mark on the right. We let it\n * wrap and drop a full-width third line carrying `--vlm-docs-version` (baked in\n * from public/VERSION by scripts/generate-version.mjs). If the variable is ever\n * empty the pseudo-element collapses to nothing, so the footer degrades safely.\n * -------------------------------------------------------------------------- */\n\n#footer {\n  flex-wrap: wrap;\n  row-gap: 1.25rem;\n}\n\n#footer::after {\n  content: var(--vlm-docs-version, \"\");\n  flex-basis: 100%;\n  order: 99;\n  font-family: 'Geist Mono', ui-monospace, monospace;\n  font-size: 12px;\n  letter-spacing: 0.02em;\n  color: var(--vlm-muted);\n}\n\n/* --------------------------------------------------------------------------\n * 14. Hero video\n *\n * Unlike `img`, a `\u003cvideo\u003e` gets no `max-width` reset, so inside a `\u003cFrame\u003e`\n * it renders at its own pixel size. `.hero-video` lets the launch video fill\n * the frame at its native aspect ratio.\n * -------------------------------------------------------------------------- */\n\n.hero-video {\n  display: block;\n  width: 100%;\n  height: auto;\n  border-radius: 6px;\n  background: var(--vlm-navy-dark);\n}\n\n/* --------------------------------------------------------------------------\n * 15. Changelog tag\n * -------------------------------------------------------------------------- */\n\np:has(\u003e .changelog-tag:first-child),\nspan:has(\u003e .changelog-tag:first-child) {\n  padding-left: 88px;\n  text-indent: -88px;\n}\n\n.changelog-tag {\n  display: inline-block;\n  box-sizing: border-box;\n  width: 76px;\n  margin-right: 8px;\n  padding: 1px 0;\n  text-align: center;\n  text-indent: 0;\n  border: 1px solid var(--vlm-border);\n  border-radius: 4px;\n  background: var(--vlm-primary-badge);\n  color: var(--vlm-muted);\n  font-family: 'Geist Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;\n  font-size: 11px;\n  font-weight: 500;\n  letter-spacing: 0.08em;\n  line-height: 1.5;\n  text-transform: uppercase;\n  vertical-align: 1px;\n}\n\n/* --------------------------------------------------------------------------\n * 16. Support dot\n * -------------------------------------------------------------------------- */\n\n.support-dot {\n  color: var(--vlm-primary-light);\n}\n\n/* --------------------------------------------------------------------------\n * 17. Legacy sidebar group\n *    The classic generate API stays out of the sidebar unless the URL has\n *    ?legacy=1. public/legacy.js sets data-legacy on \u003chtml\u003e and keeps it for\n *    the session.\n * -------------------------------------------------------------------------- */\n\nhtml:not([data-legacy=\"1\"]) #navigation-items \u003e div:has(a[href=\"/api-reference/structured-extraction\"]) {\n  display: none;\n}\n"])</script><script>self.__next_f.push([1,"4d:[[\"$\",\"style\",\"0\",{\"data-custom-css-index\":0,\"data-custom-css-path\":\"style.css\",\"dangerouslySetInnerHTML\":{\"__html\":\"$56\"}}]]\n"])</script><script>self.__next_f.push([1,"4e:[\"$\",\"$L57\",null,{\"customJsDisabled\":false,\"jsFiles\":[{\"_id\":\"68e429a6f5cdcba58d38f8a1\",\"filePath\":\"unifygtm.js\",\"subdomain\":\"autonomiai\",\"__v\":0,\"content\":\"!function(){var e=[\\\"identify\\\",\\\"page\\\",\\\"startAutoPage\\\",\\\"stopAutoPage\\\",\\\"startAutoIdentify\\\",\\\"stopAutoIdentify\\\"];function t(o){return Object.assign([],e.reduce(function(r,n){return r[n]=function(){return o.push([n,[].slice.call(arguments)]),o},r},{}))}window.unify||(window.unify=t(window.unify)),window.unifyBrowser||(window.unifyBrowser=t(window.unifyBrowser));var n=document.createElement(\\\"script\\\");n.async=!0,n.setAttribute(\\\"src\\\",\\\"https://tag.unifyintent.com/v1/Dt1UeY6ixuWJP4NWtEqUXj/script.js\\\"),n.setAttribute(\\\"data-api-key\\\",\\\"wk_jmZRryRw_E2pTA3dkRhWbxa1ckZfYapmsh1gwrkMM\\\"),n.setAttribute(\\\"id\\\",\\\"unifytag\\\"),(document.body||document.head).appendChild(n)}();\\n\"},{\"_id\":\"6ac66f2895d20a706317874a\",\"filePath\":\"legacy.js\",\"subdomain\":\"autonomiai\",\"__v\":0,\"content\":\"(function () {\\n  var key = \\\"vlm-docs-legacy\\\";\\n  function show() {\\n    try { sessionStorage.setItem(key, \\\"1\\\"); } catch (e) {}\\n    document.documentElement.setAttribute(\\\"data-legacy\\\", \\\"1\\\");\\n  }\\n  try {\\n    var flag = new URLSearchParams(window.location.search).get(\\\"legacy\\\");\\n    if (flag === \\\"1\\\") show();\\n    if (flag === \\\"0\\\") sessionStorage.removeItem(key);\\n    if (sessionStorage.getItem(key) === \\\"1\\\") {\\n      document.documentElement.setAttribute(\\\"data-legacy\\\", \\\"1\\\");\\n    } else {\\n      document.documentElement.removeAttribute(\\\"data-legacy\\\");\\n    }\\n  } catch (e) {}\\n  document.addEventListener(\\\"click\\\", function (event) {\\n    var link = event.target.closest \u0026\u0026 event.target.closest('a[href*=\\\"legacy=1\\\"]');\\n    if (link) show();\\n  }, true);\\n})();\\n\"}]}]\n"])</script><script>self.__next_f.push([1,"5a:T54e2,"])</script><script>self.__next_f.push([1,"\"use strict\";const{Fragment:_Fragment,jsx:_jsx,jsxs:_jsxs}=arguments[0];const{useMDXComponents:_provideComponents}=arguments[0];function _createMdxContent(props){const _components={a:`a`,code:`code`,li:`li`,p:`p`,pre:`pre`,span:`span`,strong:`strong`,ul:`ul`,..._provideComponents(),...props.components},{Card,CardGroup,CodeBlock,CodeGroup,Frame,Heading}=_components;if(!Card)_missingMdxReference(`Card`,true);if(!CardGroup)_missingMdxReference(`CardGroup`,true);if(!CodeBlock)_missingMdxReference(`CodeBlock`,true);if(!CodeGroup)_missingMdxReference(`CodeGroup`,true);if(!Frame)_missingMdxReference(`Frame`,true);if(!Heading)_missingMdxReference(`Heading`,true);return _jsxs(_Fragment,{children:[_jsx(_components.p,{children:`Visual intelligence is fragmented today. OCR, layout, detection, segmentation, pose, and transcription models each ship their own input format, output schema, and pricing.`}),`\n`,_jsxs(_components.p,{children:[`The Gateway is an open-weight visual intelligence platform you can own. Call open-weight VLMs, ViT models, and other specialized vision models through one OpenAI-compatible API, swap models by changing `,_jsx(_components.code,{children:`model`}),`, and run them on our GPUs or yours. We orchestrate the models, keep the GPUs busy, and benchmark the VLMs, so you can ship the pipeline. Start with the `,_jsx(_components.a,{href:`/gateway/quickstart`,children:`quickstart`}),`.`]}),`\n`,_jsx(Frame,{children:_jsx(`video`,{className:`hero-video`,src:`https://www.vlm.run/videos/gateway-launch.mp4`,autoPlay:true,muted:true,loop:true,playsInline:true,controls:true})}),`\n`,_jsx(Heading,{level:`2`,id:`unified-interface-for-visual-intelligence`,children:`Unified Interface for Visual Intelligence`}),`\n`,_jsxs(CodeGroup,{children:[_jsx(CodeBlock,{filename:`Python`,highlight:`[4]`,numberOfLines:`6`,language:`python`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light dark-plus`,style:{backgroundColor:`#fff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#24292e`,\"--shiki-dark\":`#D4D4D4`},language:`python`,children:_jsxs(_components.code,{language:`python`,numberOfLines:`6`,children:[_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#D73A49`,\"--shiki-dark\":`#C586C0`},children:`from`}),_jsx(_components.span,{style:{color:`#24292E`,\"--shiki-dark\":`#D4D4D4`},children:` openai `}),_jsx(_components.span,{style:{color:`#D73A49`,\"--shiki-dark\":`#C586C0`},children:`import`}),_jsx(_components.span,{style:{color:`#24292E`,\"--shiki-dark\":`#D4D4D4`},children:` OpenAI`})]}),`\n`,_jsx(_components.span,{className:`line`}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#24292E`,\"--shiki-dark\":`#D4D4D4`},children:`client `}),_jsx(_components.span,{style:{color:`#D73A49`,\"--shiki-dark\":`#D4D4D4`},children:`=`}),_jsx(_components.span,{style:{color:`#24292E`,\"--shiki-dark\":`#D4D4D4`},children:` OpenAI(`})]}),`\n`,_jsxs(_components.span,{className:`line line-highlight`,children:[_jsx(_components.span,{style:{color:`#E36209`,\"--shiki-dark\":`#9CDCFE`},children:`    base_url`}),_jsx(_components.span,{style:{color:`#D73A49`,\"--shiki-dark\":`#D4D4D4`},children:`=`}),_jsx(_components.span,{style:{color:`#032F62`,\"--shiki-dark\":`#CE9178`},children:`\"https://gateway.vlm.run/v1/openai\"`}),_jsx(_components.span,{style:{col