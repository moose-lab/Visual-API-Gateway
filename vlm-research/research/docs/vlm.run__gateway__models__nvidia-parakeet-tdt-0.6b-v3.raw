t.\",\"Billed per audio second on `json` and `verbose_json` replies. See [Pricing](https://docs.vlm.run/gateway/pricing).\",\"Weights: [`nvidia/parakeet-tdt-0.6b-v3`](https://huggingface.co/nvidia/parakeet-tdt-0.6b-v3).\"]}]},{\"id\":\"quickstart\",\"title\":\"Quick start\",\"blocks\":[{\"type\":\"code\",\"tabs\":[{\"label\":\"Python\",\"language\":\"python\",\"code\":\"from openai import OpenAI\\n\\nclient = OpenAI(\\n    base_url=\\\"https://gateway.vlm.run/v1/openai\\\",\\n    api_key=\\\"\u003cVLMRUN_API_KEY\u003e\\\",\\n)\\n\\nwith open(\\\"sample.mp3\\\", \\\"rb\\\") as audio_file:\\n    response = client.audio.transcriptions.create(\\n        model=\\\"nvidia/parakeet-tdt-0.6b-v3\\\",\\n        file=audio_file,\\n    )\\n\\nprint(response.text)\\n\"},{\"label\":\"Node.js\",\"language\":\"typescript\",\"code\":\"import fs from \\\"fs\\\";\\nimport OpenAI from \\\"openai\\\";\\n\\nconst client = new OpenAI({\\n  baseURL: \\\"https://gateway.vlm.run/v1/openai\\\",\\n  apiKey: process.env.VLMRUN_API_KEY,\\n});\\n\\nconst response = await client.audio.transcriptions.create({\\n  model: \\\"nvidia/parakeet-tdt-0.6b-v3\\\",\\n  file: fs.createReadStream(\\\"sample.mp3\\\"),\\n});\\n\\nconsole.log(response.text);\\n\"},{\"label\":\"CLI\",\"language\":\"bash\",\"code\":\"vlmrun gw transcribe sample.mp3 -m nvidia/parakeet-tdt-0.6b-v3\\n\"},{\"label\":\"cURL\",\"language\":\"bash\",\"code\":\"curl https://gateway.vlm.run/v1/openai/audio/transcriptions \\\\\\n  -X POST \\\\\\n  -H \\\"Authorization: Bearer $VLMRUN_API_KEY\\\" \\\\\\n  -F \\\"model=nvidia/parakeet-tdt-0.6b-v3\\\" \\\\\\n  -F \\\"file=@sample.mp3\\\"\\n\"}]}]},{\"id\":\"response\",\"title\":\"Response\",\"blocks\":[{\"type\":\"p\",\"text\":\"`response_format` defaults to `json`, which carries the transcript and a `usage` block:\"},{\"type\":\"code\",\"tabs\":[{\"label\":\"JSON\",\"language\":\"json\",\"code\":\"{\\n  \\\"id\\\": \\\"transcription-3d1df87d0037\\\",\\n  \\\"object\\\": \\\"audio.transcription\\\",\\n  \\\"model\\\": \\\"nvidia/parakeet-tdt-0.6b-v3\\\",\\n  \\\"backend\\\": \\\"nemo\\\",\\n  \\\"task\\\": \\\"transcribe\\\",\\n  \\\"duration\\\": 252.726,\\n  \\\"text\\\": \\\"McKeys Rocks is a rough and tumble area just outside Pittsburgh…\\\",\\n  \\\"usage\\\": {\\n    \\\"type\\\": \\\"duration\\\",\\n    \\\"input_audio_seconds\\\": 252.726,\\n    \\\"input_tokens\\\": 0,\\n    \\\"output_tokens\\\": 581,\\n    \\\"total_tokens\\\": 581,\\n    \\\"cost\\\": 0.004213\\n  }\\n}\\n\"}]},{\"type\":\"p\",\"text\":\"`usage.cost` is the metered charge in USD, and `input_audio_seconds` is the quantity it was computed from: the clip's duration at $0.06 per audio hour. See [Pricing](https://docs.vlm.run/gateway/pricing#transcription).\"},{\"type\":\"callout\",\"tone\":\"note\",\"text\":\"Only `json` and `verbose_json` carry a `usage` block. `text`, `srt`, and `vtt` return the transcript alone, so read the cost from one of the JSON formats if you need it.\"}]}]}}],\"$L35\"]\n"])</script><script>self.__next_f.push([1,"35:[\"$\",\"section\",null,{\"className\":\"relative z-[11]\",\"aria-labelledby\":\"cta-headline\",\"children\":[[\"$\",\"div\",null,{\"className\":\"pointer-events-none absolute inset-0\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"div\",null,{\"className\":\"absolute top-0 left-0 right-0 bg-body\",\"style\":{\"height\":\"45%\"}}],[\"$\",\"div\",null,{\"className\":\"absolute bottom-0 left-0 right-0 bg-navy-dark\",\"style\":{\"height\":\"55%\"},\"children\":[\"$\",\"div\",null,{\"aria-hidden\":\"true\",\"className\":\"pointer-events-none absolute top-0 bottom-0 border-x border-dark-border\",\"style\":{\"left\":\"max(20px, calc((var(--page-rail-width, 100vw) - 1168px) / 2))\",\"right\":\"max(20px, calc((var(--page-rail-width, 100vw) - 1168px) / 2))\"}}]}]]}],[\"$\",\"div\",null,{\"className\":\"relative z-10 mx-[6px] 3xl:mx-10 overflow-hidden rounded-[4px] bg-primary-mid [--rail-margin:6px] 3xl:[--rail-margin:2.5rem]\",\"children\":[[\"$\",\"