d0e54478bc56b.js?dpl=dpl_ECYyVTvmC2RAfYSm8YdEVejNFnj3\",\"/_next/static/chunks/9b6dc91b04fc3a63.js?dpl=dpl_ECYyVTvmC2RAfYSm8YdEVejNFnj3\",\"/_next/static/chunks/dd1b57ea2d4710e2.js?dpl=dpl_ECYyVTvmC2RAfYSm8YdEVejNFnj3\",\"/_next/static/chunks/007c35a18659a37e.js?dpl=dpl_ECYyVTvmC2RAfYSm8YdEVejNFnj3\",\"/_next/static/chunks/5280b42fa3af8d91.js?dpl=dpl_ECYyVTvmC2RAfYSm8YdEVejNFnj3\",\"/_next/static/chunks/6e14581506f1f17f.js?dpl=dpl_ECYyVTvmC2RAfYSm8YdEVejNFnj3\"],\"default\"]\n"])</script><script>self.__next_f.push([1,"34:[\"$\",\"$L36\",null,{\"capabilities\":[{\"title\":\"OCR\",\"teaser\":\"Boxes, text, and scores on every line.\",\"body\":[\"`ocr` runs text detection and recognition on an image or PDF page. The result is a list of regions: each with normalized geometry (`bbox_xywh`, often `poly_xy`), the recognized `text`, and a confidence `score`. On documents, each page's JSON content is `document.page.blocks` with one block per line or text region.\",\"Models that expose `ocr` include `paddleocr/pp-ocrv6` (default method) and `rednote-hilab/dots.mocr` (plain string form). Florence-2 also offers `ocr` / `ocr_with_region` on a single image.\"],\"whenToUse\":[\"You need where the text is as well as what it says: highlighting, redaction, form-field mapping, or scene-text overlays.\",\"Inputs are receipts, photos, screenshots, or other scene text where line-level boxes matter more than document hierarchy.\",\"You want confidence scores to filter low-quality lines (`method_params.score_threshold` on pp-ocrv6).\",\"Prefer `paddleocr/pp-ocrv6` for general-purpose line OCR with polygons. Prefer dots.mocr's `ocr` only when you want a plain reading-order string without generative Markdown structure.\"]},{\"title\":\"Markdown\",\"teaser\":\"Reading-order pages for RAG and review.\",\"body\":[\"`markdown` converts a page into reading-order Markdown (and sometimes HTML). You get headings, lists, tables, and paragraphs as a single string per image or page. There is no geometry: the payload is free-form text, and text mode marks each page with `format=\\\"markdown\\\"`.\",\"`markdown` is the default on `zai-org/glm-ocr` and `rednote-hilab/dots.mocr`.\"],\"whenToUse\":[\"You want page content that reads well in an LLM context window, a RAG index, or a human review UI.\",\"Structure matters (titles, sections, tables) more than pixel coordinates.\",\"You are building a PDF-to-Markdown or page-to-Markdown pipeline and do not need bounding boxes in the same call.\",\"Prefer glm-ocr or dots.mocr for multi-page PDFs. Use pp-ocrv6's `text` method only when you want stitched plain scene text without generative Markdown.\"]},{\"title\":\"Detect\",\"teaser\":\"Geometry first. Recognition when you need it.\",\"body\":[\"`detect` returns geometry without full recognition. On `paddleocr/pp-ocrv6`, `detect` is text detection: boxes and polygons for text lines, with no transcribed text.\"],\"whenToUse\":[\"You need region proposals first, then OCR only the crops you care about (layout-then-OCR pipelines).\",\"You want layout classes and reading order for document understanding, cropping tables or figures, or skipping headers and footers: use dots.mocr's `parse_layout_only`.\",\"You only need text-line boxes (for example to mask or crop text) and will recognize elsewhere: use pp-ocrv6 `detect`.\",\"Do not use `detect` when you need the transcribed string in the same call. Use `ocr` or `markdown` instead, or dots.mocr's `parse_layout` for layout regions that already include text.\"]},{\"title\":\"Segmentation\",\"teaser\":\"Pixel masks that follow the object.\",\"body\":[\"`segment` returns pixel masks rather than boxes. Each mask comes back with the region it covers, a label when you prompted with text, and a score. `segment_box` takes a box as the prompt instead of text, and `track` carries masks across the frames of a video under stable ids.\",\"`facebook/sam3` is the promptable segmentation model on the gateway.\"],\"whenToUse\":[\"Shape matters more than a rectangle: background removal, area and coverage measurement, or cutouts that follow an object's outline.\",\"You want to point at a thing rather than name a fixed class list: prompt with text, a box, or a click.\",\"You are following one object through a video and need the same id on every frame: use `track`.\",\"Do not use `segment` when a bounding box is enough. `detect` is cheaper and faster for counting and cropping.\"]},{\"title\":\"Pose\",\"teaser\":\"Joints, boxes, and confidence per person.\",\"body\":[\"`pose` returns 2D keypoints for every person in the frame, with a confidence score on each joint. Keypoints come back in normalized image coordinates alongside the person's bounding box.\",\"`usyd-community/vitpose-plus-large` is the pose model on the gateway.\"],\"whenToUse\":[\"You need body position rather than object identity: ergonomics and safety checks, sports and fitness form, physical therapy, gesture analysis.\",\"You want per-joint confidence so you can drop occluded limbs before computing angles.\",\"Do not use `pose` to find people in the first place. Detect them with `detect`, then run `pose` on the frames that matter.\"]},{\"title\":\"Chat and VQA\",\"teaser\":\"Open questions across images and video.\",\"body\":[\"Chat models take text plus up to 64 images, or one video, in the same message, and return the model's reply verbatim with no envelope. This is the standard chat completions shape, so an existing OpenAI client works unchanged.\",\"`qwen/qwen3.5-0.8b` and `qwen/qwen3.8-27b` serve chat today. Gemma 4, Kimi K3, MiniMax M3, and Gemini 3.7 Flash are available as frontier models.\"],\"whenToUse\":[\"Open questions and judgment calls that no fixed method covers.\",\"Structured extraction into your own JSON schema, where you decide the fields.\",\"You want reasoning across several images at once, or over a whole video, in one request.\",\"Prefer a task method (`ocr`, `markdown`, `detect`) when one exists. Those are cheaper, faster, and return a stable shape.\"]},{\"title\":\"Embeddings\",\"teaser\":\"One vector space for text, images, and video.\",\"body\":[\"`embed` returns a dense vector for the input. Text, images, and video share the same space, so you can search across all three with one index.\",\"`qwen/qwen3-vl-embedding-2b` is the embedding model on the gateway.\"],\"whenToUse\":[\"You are building multimodal search, deduplication, or clustering over a mixed corpus.\",\"You want retrieval for a RAG pipeline that holds pages and screenshots as well as text.\",\"Do not use `embed` when you need a written answer. Use a chat model for that.\"]}]}]\n"])</script><script>self.__next_f.push([1,"35:[\"$\",\"section\",null,{\"className\":\"relative z-[11]\",\"aria-labelledby\":\"cta-headline\",\"children\":[[\"$\",\"div\",null,{\"className\":\"pointer-events-none absolute inset-0\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"div\",null,{\"className\":\"absolute top-0 left-0 right-0 bg-body\",\"style\":{\"height\":\"45%\"}}],[\"$\",\"div\",null,{\"className\":\"absolute bottom-0 left-0 right-0 bg-navy-dark\",\"style\":{\"height\":\"55%\"},\"children\":[\"$\",\"div\",null,{\"aria-hidden\":\"true\",\"className\":\"pointer-events-none absolute top-0 bottom-0 border-x border-dark-border\",\"style\":{\"left\":\"max(20px, calc((var(--page-rail-width, 100vw) - 1168px) / 2))\",\"right\":\"max(20px, calc((var(--page-rail-width, 100vw) - 1168px) / 2))\"}}]}]]}],[\"$\",\"div\",null,{\"className\":\"relative z-10 mx-[6px] 3xl:mx-10 overflow-hidden rounded-[4px] bg-primary-mid [--rail-margin:6px] 3xl:[--rail-margin:2.5rem]\",\"children\":[[\"$\",\"div\",null,{\"aria-hidden\":\"true\",\"className\":\"pointer-events-none absolute top-0 bottom-0 border-x border-cta-border\",\"style\":{\"left\":\"calc(max(20px, calc((var(--page-rail-width, 100vw) - 1168px) / 2)) - var(--rail-margin, 6px))\",\"right\":\"calc(max(20px, calc((var(--page-rail-width, 100vw) - 1168px) / 2)) - var(--rail-margin, 6px))\"}}],[\"$\",\"d