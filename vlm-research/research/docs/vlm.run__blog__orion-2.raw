m.run?utm_source=website\u0026utm_medium=link\u0026utm_campaign=blog_cta\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"className\":\"inline-flex items-center justify-center gap-1.5 cursor-pointer transition-[transform,box-shadow,background-color,opacity] duration-300 ease-out hover:opacity-90 hover:-translate-y-px no-underline font-medium bg-white text-primary-mid rounded-[20px] border border-btn-white-border shadow-btn-white h-9 px-3 text-sm leading-4\",\"children\":[\"Chat with Orion\",[\"$\",\"svg\",null,{\"width\":14,\"height\":14,\"viewBox\":\"0 0 14 14\",\"fill\":\"none\",\"aria-hidden\":\"true\",\"children\":[\"$\",\"path\",null,{\"d\":\"M5.5 3.5L9 7l-3.5 3.5\",\"stroke\":\"currentColor\",\"strokeWidth\":\"1.5\",\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\"}]}]]}],[\"$\",\"a\",null,{\"href\":\"https://calendar.app.google/fSpmZfSCUk6mmrzx5\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"className\":\"inline-flex items-center justify-center gap-1.5 cursor-pointer transition-[transform,box-shadow,background-color,opacity] duration-300 ease-out hover:opacity-90 hover:-translate-y-px no-underline font-medium bg-white/15 text-white rounded-[20px] backdrop-blur-sm border-0 text-body-md px-3 py-2\",\"children\":\"Book a Demo\"}]]}]\n41:[\"$\",\"div\",null,{\"aria-hidden\":\"true\",\"className\":\"relative z-10 bg-navy-dark"])</script><script>self.__next_f.push([1,"\",\"style\":{\"height\":30},\"children\":[\"$\",\"div\",null,{\"aria-hidden\":\"true\",\"className\":\"pointer-events-none absolute top-0 bottom-0 border-x border-dark-border\",\"style\":{\"left\":\"max(20px, calc((var(--page-rail-width, 100vw) - 1168px) / 2))\",\"right\":\"max(20px, calc((var(--page-rail-width, 100vw) - 1168px) / 2))\"}}]}]\n"])</script><script>self.__next_f.push([1,"38:[\"$\",\"div\",null,{\"className\":\"blog-article prose-none max-w-none [\u0026\u003e*:first-child]:mt-0\",\"children\":[[\"$\",\"p\",\"b12fa196a22c\",{\"className\":\"my-5 text-blog-body text-blog-article\",\"children\":[\"We are excited to announce \",[\"$\",\"strong\",\"6ebdd6800aa6\",{\"className\":\"font-bold text-inherit\",\"children\":[\"Orion 2\"]}],\": our most capable visual agent, now with code execution. Since our Orion 1 launch in November last year, our customers have run hundreds of thousands of requests spanning millions of tool-calls in production every month. Serving at this scale taught us that the bottleneck in production visual agents isn't just accurate perception – it's reliable orchestration.\"]}],[\"$\",\"p\",\"d1d8fe7b5f4d\",{\"className\":\"my-5 text-blog-body text-blog-article\",\"children\":[\"Orion 2 generates and executes computer-vision code on the fly, expanding capabilities well beyond Orion 1 while being \",[\"$\",\"strong\",\"933b2af7dfa7\",{\"className\":\"font-bold text-inherit\",\"children\":[\"significantly faster\"]}],\", \",[\"$\",\"strong\",\"e30f96d80b9f\",{\"className\":\"font-bold text-inherit\",\"children\":[\"cheaper\"]}],\", and \",[\"$\",\"strong\",\"3be5a702de2c\",{\"className\":\"font-bold text-inherit\",\"children\":[\"more reliable\"]}],\". Try it now at \",[\"$\",\"a\",\"ac5788e970de\",{\"href\":\"https://chat.vlm.run/\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"className\":\"text-navy underline decoration-primary/30 underline-offset-[3px] transition-colors hover:text-primary\",\"children\":[\"chat.vlm.run\"]}],\", every example in this post is a live chat thread you can inspect and re-run.\"]}],[\"$\",\"h2\",\"h2-8\",{\"id\":\"visual-intelligence-now-with-code-mode\",\"className\":\"mt-10 mb-1 scroll-mt-28 font-sans text-blog-h2 font-semibold text-primary-mid\",\"children\":[\"Visual Intelligence, now with Code-Mode\"]}],[\"$\",\"p\",\"ddbcfdae50e8\",{\"className\":\"my-5 text-blog-body text-blog-article\",\"children\":[\"Complex computer vision tasks are inherently compositional: detect, crop, draw, measure, reason. Most vision agents are restricted to a predefined tool surface and a sequential tool-calling loop. With Orion 2, we combine deterministic tool-calling with dynamic code generation – the best of both worlds.\"]}],[\"$\",\"p\",\"23b10013d276\",{\"className\":\"my-5 text-blog-body text-blog-article\",\"children\":[\"Code as the orchestration substrate (aka \",[\"$\",\"a\",\"c821d569fda5\",{\"href\":\"https://blog.cloudflare.com/code-mode/\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"className\":\"text-navy underline decoration-primary/30 underline-offset-[3px] transition-colors hover:text-primary\",\"children\":[\"code-mode\"]}],\") has several properties that matter in production:\"]}],[\"$\",\"ul\",\"1d70d3e7656b-parent\",{\"className\":\"my-5 list-outside list-disc space-y-1.5 pl-5 text-blog-body text-blog-article marker:text-primary-mid/80\",\"children\":[[\"$\",\"li\",\"1d70d3e7656b\",{\"className\":\"pl-0.5\",\"children\":[[\"$\",\"strong\",\"38d4406e5ae0\",{\"className\":\"font-bold text-inherit\",\"children\":[\"Reusable\"]}],\": generated programs are artifacts; scripts can be saved, versioned, and re-run on new inputs without re-invoking the LLM agent.\"]}],[\"$\",\"li\",\"92e810caaa3d\",{\"className\":\"pl-0.5\",\"children\":[[\"$\",\"strong\",\"43453acae200\",{\"className\":\"font-bold text-inherit\",\"children\":[\"Inspectable\"]}],\": the executed code is something you can read, debug, diff, and verify; critical for our customers in regulated industries.\"]}],[\"$\",\"li\",\"f4d64a166e4e\",{\"className\":\"pl-0.5\",\"children\":[[\"$\",\"strong\",\"fc5b065dc161\",{\"className\":\"font-bold text-inherit\",\"children\":[\"Composable\"]}],\": loops, conditionals, fan-out, and parallel tool calls live in a single program instead of N model round-trips.\"]}],[\"$\",\"li\",\"6d38f6f7c85f\",{\"className\":\"pl-0.5\",\"children\":[[\"$\",\"strong\",\"777bd7cb7792\",{\"className\":\"font-bold text-inherit\",\"children\":[\"Deterministic\"]}],\": computation (counting, measuring, normalizing, geometry) runs in code, not in the model's head; eliminating an entire class of numeric hallucinations.\"]}]]}],\"$L42\",\"$L43\",\"$L44\",\"$L45\",\"$L46\",\"$L47\",\"$L48\",\"$L49\",\"$L4a\",\"$L4b\",\"$L4c\",\"$L4d\",\"$L4e\",\"$L4f\",\"$L50\",\"$L51\",\"$L52\",\"$L53\",\"$L54\",\"$L55\",\"$L56\",\"$L57\",\"$L58\",\"$L59\",\"$L5a\",\"$L5b\",\"$L5c\",\"$L5d\",\"$L5e\",\"$L5f\",\"$L60\",\"$L61\",\"$L62\",\"$L63\",\"$L64\",\"$L65\",\"$L66\",\"$L67\",\"$L68\",\"$L69\",\"$L6a\",\"$L6b\",\"$L6c\",\"$L6d\",\"$L6e\",\"$L6f\"]}]\n"])</script><script>self.__next_f.push([1,"72:I[280847,[\"/_next/static/chunks/b076810d0fd38179.js?dpl=dpl_ECYyVTvmC2RAfYSm8YdEVejNFnj3\",\"/_next/static/chunks/2b247885c6725624.js?dpl=dpl_ECYyVTvmC2RAfYSm8YdEVejNFnj3\",\"/_next/static/chunks/f214a4e47049aa46.js?dpl=dpl_ECYyVTvmC2RAfYSm8YdEVejNFnj3\",\"/_next/static/chunks/df2d0e54478bc56b.js?dpl=dpl_ECYyVTvmC2RAfYSm8YdEVejNFnj3\",\"/_next/static/chunks/9b6dc91b04fc3a63.js?dpl=dpl_ECYyVTvmC2RAfYSm8YdEVejNFnj3\",\"/_next/static/chunks/6f4d85975e93d001.js?dpl=dpl_ECYyVTvmC2RAfYSm8YdEVejNFnj3\"],\"default\"]\n73:I[735993,[\"/_next/static/chunks/b076810d0fd38179.js?dpl=dpl_ECYyVTvmC2RAfYSm8YdEVejNFnj3\",\"/_next/static/chunks/2b247885c6725624.js?dpl=dpl_ECYyVTvmC2RAfYSm8YdEVejNFnj3\",\"/_next/static/chunks/f214a4e47049aa46.js?dpl=dpl_ECYyVTvmC2RAfYSm8YdEVejNFnj3\",\"/_next/static/chunks/df2d0e54478bc56b.js?dpl=dpl_ECYyVTvmC2RAfYSm8YdEVejNFnj3\",\"/_next/static/chunks/9b6dc91b04fc3a63.js?dpl=dpl_ECYyVTvmC2RAfYSm8YdEVejNFnj3\",\"/_next/static/chunks/6f4d85975e93d001.js?dpl=dpl_ECYyVTvmC2RAfYSm8YdEVejNFnj3\"],\"default\"]\n42:[\"$\",\"p\",\"dd34080de38b\",{\"className\":\"my-5 text-blog-body text-blog-article\",\"children\":[\"\"]}]\n43:[\"$\",\"h2\",\"h3-63\",{\"id\":\"architecture-code-as-the-agent-harness\",\"className\":\"mt-10 mb-1 scroll-mt-28 font-sans text-blog-h2 font-semibold text-primary-mid\",\"children\":[\"Architecture: Code as the Agent Harness\"]}]\n44:[\"$\",\"p\",\"8a86d03b13c0\",{\"className\":\"my-5 text-blog-body text-blog-article\",\"children\":[\"Orion 2 is a \",[\"$\",\"strong\",\"9e82aa7dd4d0\",{\"className\":\"font-bold text-inherit\",\"children\":[\"visual agent harness\"]}],\": a planner and a code runtime wrapped around a vision-language model. At its core is a custom \",[\"$\",\"strong\",\"afc891bd9f35\",{\"className\":\"font-bold text-inherit\",\"children\":[\"visual DSL and runtime\"]}],\" we built to expose every tool we introduced with Orion 1 – detection, OCR, segmentation, cropping, image generation, and more – as native primitives the model can compose in code. Most notably, the entire Orion 1 tool surface is now fully programmable and deterministic. \"]}]\n45:[\"$\",\"figure\",\"7a2c409a2b8b\",{\"className\":\"my-8\",\"children\":[[\"$\",\"div\",null,{\"className\":\"rounded-xl overflow-hidden border border-border\",\"children\":[\"$\",\"$L2e\",null,{\"src\":\"https://cdn.sanity.io/images/12pgkx8l/production/2dd998a99a19b959238dcbed742c0d5cca6fd3a5-2336x912.png\",\"alt\":\"Architecture diagram of Orion 2. Four input types on the left (text, image, video, and document) flow into the Orion 2 agent. Inside, the model issues tool calls to three subsystems: Visual Tools \u0026 Runtime, Code Gen \u0026 Execution, and Visual Skills. Outputs on the right span five capability classes: Describe, Tag, Detect, Generate, and Act.\",\"width\":900,\"height\":506,\"className\":\"w-full h-auto\"}]}],[\"$\",\"figcaption\",null,{\"className\":\"mt-2 text-center text-body-sm text-muted\",\"children\":\"Orion 2 accepts text, images, video, and documents, compiles each request into an executable program, and dispatches visual tools, code execution, and learned skills from a single harness.\"}]]}]\n46:[\"$\",\"p\",\"74875a7621f6\",{\"className\":\"my-5 text-blog-body text-blog-article\",\"children\":[\"\"]}]\n47:[\"$\",\"p\",\"91158a2598eb\",{\"className\":\"my-5 text-blog-body text-blog-article\",\"children\":[\"Here is how a new request is handled in Orion 2: \"]}]\n"])</script><script>self.__next_f.push([1,"48:[\"$\",\"ol\",\"c0271ce601d1-parent\",{\"className\":\"my-5 list-decimal list-outside space-y-1.5 pl-5 text-blog-body text-blog-article\",\"children\":[[\"$\",\"li\",\"c0271ce601d1\",{\"className\":\"pl-0.5\",\"children\":[[\"$\",\"strong\",\"1c9e8dae4a19\",{\"className\":\"font-bold text-inherit\",\"children\":[\"Prompt → Spec:\"]}],\" An ambiguous request is compiled into an exact, executable program – written in our visual DSL, which reads like idiomatic Python.\"]}],[\"$\",\"li\",\"88680d652761\",{\"className\":\"pl-0.5\",\"children\":[[\"$\",\"strong\",\"5e0147d6b5a6\",{\"className\":\"font-bold text-inherit\",\"children\":[\"Execution:\"]}],\" The program runs in a sandboxed runtime with async-native parallelism: independent operations dispatch concurrently via asyncio, with no per-step model round-trips. The runtime ships with OpenCV for classical computer vision and the \",[\"$\",\"code\",\"97b9a9acdee6\",{\"className\":\"rounded-md bg-primary/10 px-1.5 py-0.5 font-mono text-code text-primary\",\"children\":[\"vlmrun\"]}],\" package, which exposes the full Orion tool surface – detection, OCR, segmentation, image generation – as importable primitives.\"]}],[\"$\",\"li\",\"f8ec27e01398\",{\"className\":\"pl-0.5\",\"children\":[[\"$\",\"strong\",\"264a3a154792\",{\"className\":\"font-bold text-inherit\",\"children\":[\"Self-correction: \"]}],\"Execution results return to the harness, which repairs and re-executes until the program runs to completion. Each turn also yields a (program, trace, outcome) record – fully verifiable supervision for our continual-learning flywheel.\"]}]]}]\n"])</script><script>self.__next_f.push([1,"49:[\"$\",\"p\",\"fa81341a35c0\",{\"className\":\"my-5 text-blog-body text-blog-article\",\"children\":[\"That record is also the groundwork for what comes next: close the loop with a visual judge, a harness that can score its own outputs, prefer better programs over worse ones, and improve recursively with every workload it serves. More on that soon.\"]}]\n4a:[\"$\",\"h2\",\"d2039e0081ae\",{\"id\":\"orion-1-vs-orion-2\",\"className\":\"mt-10 mb-1 scroll-mt-28 font-sans text-blog-h2 font-semibold text-primary-mid\",\"children\":[\"Orion 1 vs. Orion 2\"]}]\n4b:[\"$\",\"p\",\"1f9b276fd620\",{\"className\":\"my-5 text-blog-body text-blog-article\",\"children\":[\"The difference is easiest to see on a concrete task: the virtual try-on from the examples below, which composes detection, cropping, and image generation across two input images.\"]}]\n4c:[\"$\",\"p\",\"4fc53cec5e2e\",{\"className\":\"my-5 text-blog-body text-blog-article\",\"children\":[\"Orion 1's orchestration is lazy and interactive: one tool call, one LLM round-trip, repeat. Five visual operations means five round-trips, and every intermediate result (bounding boxes included) passes through the model's context before the next step:\"]}]\n4d:[\"$\",\"h4\",\"ec3f8b9d7025\",{\"id\":\"orion-1-sequential-tool-call-illustration\",\"className\":\"mb-1 mt-6 scroll-mt-28 font-sans text-blog-h4 font-normal text-primary-mid\",\"children\":[\"Orion 1: Sequential Tool-Call Illustration\"]}]\n70:Tbca,"])</script><script>self.__next_f.push([1,"\u003cpre class=\"shiki github-light\" style=\"background-color:#fff;color:#24292e\" tabindex=\"0\"\u003e\u003ccode\u003e\u003cspan class=\"line\"\u003e\u003cspan style=\"color:#6A737D\"\u003e# Tools are called sequentially, with LLM reasoning at each step\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan style=\"color:#24292E\"\u003eboxes      \u003c/span\u003e\u003cspan style=\"color:#D73A49\"\u003e=\u003c/span\u003e\u003cspan style=\"color:#24292E\"\u003e tool_call(\u003c/span\u003e\u003cspan style=\"color:#032F62\"\u003e\"detect\"\u003c/span\u003e\u003cspan style=\"color:#24292E\"\u003e, image, \u003c/span\u003e\u003cspan style=\"color:#E36209\"\u003etarget\u003c/span\u003e\u003cspan style=\"color:#D73A49\"\u003e=\u003c/span\u003e\u003cspan style=\"color:#032F62\"\u003e\"person\"\u003c/span\u003e\u003cspan style=\"color:#24292E\"\u003e)                  \u003c/span\u003e\u003cspan style=\"color:#6A737D\"\u003e# call 1\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan style=\"color:#24292E\"\u003eperson     \u003c/span\u003e\u003cspan style=\"color:#D73A49\"\u003e=\u003c/span\u003e\u003cspan style=\"color:#24292E\"\u003e tool_call(\u003c/span\u003e\u003cspan style=\"color:#032F62\"\u003e\"crop\"\u003c/span\u003e\u003cspan style=\"color:#24292E\"\u003e, image, \u003c/span\u003e\u003cspan style=\"color:#E36209\"\u003exywh\u003c/span\u003e\u003cspan style=\"color:#D73A49\"\u003e=\u003c/span\u003e\u003cspan style=\"color:#24292E\"\u003e[\u003c/span\u003e\u003cspan style=\"color:#005CC5\"\u003e0.22\u003c/span\u003e\u003cspan style=\"color:#24292E\"\u003e, \u003c/span\u003e\u003cspan style=\"color:#005CC5\"\u003e0.35\u003c/span\u003e\u003cspan style=\"color:#24292E\"\u003e, \u003c/span\u003e\u003cspan style=\"color:#005CC5\"\u003e0.04\u003c/span\u003e\u003cspan style=\"color:#24292E\"\u003e, \u003c/span\u003e\u003cspan style=\"color:#005CC5\"\u003e0.15\u003c/span\u003e\u003cspan style=\"color:#24292E\"\u003e])      \u003c/span\u003e\u003cspan style=\"color:#6A737D\"\u003e# call 2\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan style=\"color:#24292E\"\u003egarment    \u003c/span\u003e\u003cspan style=\"color:#D73A49\"\u003e=\u003c/span\u003e\u003cspan style=\"color:#24292E\"\u003e tool_call(\u003c/span\u003e\u003cspan style=\"color:#032F62\"\u003e\"detect\"\u003c/span\u003e\u003cspan style=\"color:#24292E\"\u003e, dress_img, \u003c/span\u003e\u003cspan style=\"color:#E36209\"\u003etarget\u003c/span\u003e\u003cspan style=\"color:#D73A49\"\u003e=\u003c/span\u003e\u003cspan style=\"color:#032F62\"\u003e\"garment\"\u003c/span\u003e\u003cspan style=\"color:#24292E\"\u003e)             \u003c/span\u003e\u003cspan style=\"color:#6A737D\"\u003e# call 3\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan style=\"color:#24292E\"\u003egarment    \u003c/span\u003e\u003cspan style=\"color:#D73A49\"\u003e=\u003c/span\u003e\u003cspan style=\"color:#24292E\"\u003e tool_call(\u003c/span\u003e\u003cspan style=\"color:#032F62\"\u003e\"crop\"\u003c/span\u003e\u003cspan style=\"color:#24292E\"\u003e, dress_img, \u003c/span\u003e\u003cspan style=\"color:#E36209\"\u003exywh\u003c/span\u003e\u003cspan style=\"color:#D73A49\"\u003e=\u003c/span\u003e\u003cspan style=\"color:#24292E\"\u003e[\u003c/span\u003e\u003cspan style=\"color:#005CC5\"\u003e0.33\u003c/span\u003e\u003cspan style=\"color:#24292E\"\u003e, \u003c/span\u003e\u003cspan style=\"color:#005CC5\"\u003e0.41\u003c/span\u003e\u003cspan style=\"color:#24292E\"\u003e, \u003c/span\u003e\u003cspan style=\"color:#005CC5\"\u003e0.05\u003c/span\u003e\u003cspan style=\"color:#24292E\"\u003e, \u003c/span\u003e\u003cspan style=\"color:#005CC5\"\u003e0.13\u003c/span\u003e\u003cspan style=\"color:#24292E\"\u003e])  \u003c/span\u003e\u003cspan style=\"color:#6A737D\"\u003e# call 4\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan style=\"color:#24292E\"\u003eresult     \u003c/span\u003e\u003cspan style=\"color:#D73A49\"\u003e=\u003c/span\u003e\u003cspan style=\"color:#24292E\"\u003e tool_call(\u003c/span\u003e\u003cspan style=\"color:#032F62\"\u003e\"generate\"\u003c/span\u003e\u003cspan style=\"color:#24292E\"\u003e, person, garment)                       \u003c/span\u003e\u003cspan style=\"color:#6A737D\"\u003e# call 5\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan style=\"color:#6A737D\"\u003e# ...the model parses every intermediate output before deciding the next tool.\u003c/span\u003e\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e"])</script><script>self.__next_f.push([1,"4e:[\"$\",\"figure\",\"code-66\",{\"className\":\"my-6 overflow-hidden rounded-xl border border-border bg-white\",\"children\":[\"$\",\"div\",null,{\"className\":\"blog-code-shiki overflow-x-auto\",\"dangerouslySetInnerHTML\":{\"__html\":\"$70\"}}]}]\n4f:[\"$\",\"p\",\"0d93049f2bf2\",{\"className\":\"my-5 text-blog-body text-blog-article\",\"children\":[\"Notice the coordinates in calls 2 and 4: the LLM reads them out of the detection results and calls them into the next tool call. Every hop like that costs a round-trip of latency and is a chance to transcribe something wrong.\"]}]\n50:[\"$\",\"h4\",\"780e455d0f88\",{\"id\":\"orion-2-efficient-code-mode-execution\",\"className\":\"mb-1 mt-6 scroll-mt-28 font-sans text-blog-h4 font-normal text-primary-mid\",\"children\":[\"Orion 2: Efficient Code-Mode Execution\"]}]\n51:[\"$\",\"p\",\"471067c84076\",{\"className\":\"my-5 text-blog-body text-blog-article\",\"children\":[\"Orion 2's orchestration is code. The model writes one program up front; intermediate results flow through variables instead of the model's context, independent operations run in parallel, and the whole workflow executes end-to-end before returning:\"]}]\n71:T122a,"])</script><script>self.__next_f.push([1,"\u003cpre class=\"shiki github-light\" style=\"background-color:#fff;color:#24292e\" tabindex=\"0\"\u003e\u003ccode\u003e\u003cspan class=\"line\"\u003e\u003cspan style=\"color:#6A737D\"\u003e# Tools can be called efficiently via native async python ops\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan style=\"color:#D73A49\"\u003eimport\u003c/span\u003e\u003cspan style=\"color:#24292E\"\u003e asyncio\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan style=\"color:#D73A49\"\u003easync\u003c/span\u003e\u003cspan style=\"color:#D73A49\"\u003e def\u003c/span\u003e\u003cspan style=\"color:#6F42C1\"\u003e process\u003c/span\u003e\u003cspan style=\"color:#24292E\"\u003e(ctx, person_image, dress_img):\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan style=\"color:#24292E\"\u003e    vlmrun \u003c/span\u003e\u003cspan style=\"color:#D73A49\"\u003e=\u003c/span\u003e\u003cspan style=\"color:#24292E\"\u003e ctx.import_lib(\u003c/span\u003e\u003cspan style=\"color:#032F62\"\u003e\"vlmrun\"\u003c/span\u003e\u003cspan style=\"color:#24292E\"\u003e)\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan style=\"color:#24292E\"\u003e    \u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan style=\"color:#D73A49\"\u003e    def\u003c/span\u003e\u003cspan style=\"color:#6F42C1\"\u003e crop\u003c/span\u003e\u003cspan style=\"color:#24292E\"\u003e(img, d):\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan style=\"color:#24292E\"\u003e        bx, by, bw, bh \u003c/span\u003e\u003cspan style=\"color:#D73A49\"\u003e=\u003c/span\u003e\u003cspan style=\"color:#24292E\"\u003e d[\u003c/span\u003e\u003cspan style=\"color:#032F62\"\u003e\"xywh\"\u003c/span\u003e\u003cspan style=\"color:#24292E\"\u003e]; W, H \u003c/span\u003e\u003cspan style=\"color:#D73A49\"\u003e=\u003c/span\u003e\u003cspan style=\"color:#24292E\"\u003e img.width, img.height\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan style=\"color:#D73A49\"\u003e        return\u003c/span\u003e\u003cspan style=\"color:#24292E\"\u003e img.crop(\u003c/span\u003e\u003cspan style=\"color:#005CC5\"\u003eint\u003c/span\u003e\u003cspan style=\"color:#24292E\"\u003e(by \u003c/span\u003e\u003cspan style=\"color:#D73A49\"\u003e*\u003c/span\u003e\u003cspan style=\"color:#24292E\"\u003e H), \u003c/span\u003e\u003cspan style=\"color:#005CC5\"\u003eint\u003c/span\u003e\u003cspan style=\"color:#24292E\"\u003e((by \u003c/span\u003e\u003cspan style=\"color:#D73A49\"\u003e+\u003c/span\u003e\u003cspan style=\"color:#24292E\"\u003e bh) \u003c/span\u003e\u003cspan style=\"color:#D73A49\"\u003e*\u003c/span\u003e\u003cspan style=\"color:#24292E\"\u003e H), \u003c/span\u003e\u003cspan style=\"color:#005CC5\"\u003eint\u003c/span\u003e\u003cspan style=\"color:#24292E\"\u003e(bx \u003c/span\u003e\u003cspan style=\"color:#D73A49\"\u003e*\u003c/span\u003e\u003cspan style=\"color:#24292E\"\u003e W), \u003c/span\u003e\u003cspan style=\"color:#005CC5\"\u003eint\u003c/span\u003e\u003cspan style=\"color:#24292E\"\u003e((bx \u003c/span\u003e\u003cspan style=\"color:#D73A49\"\u003e+\u003c/span\u003e\u003cspan style=\"color:#24292E\"\u003e bw) \u003c/span\u003e\u003cspan style=\"color:#D73A49\"\u003e*\u003c/span\u003e\u003cspan style=\"color:#24292E\"\u003e W))\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan style=\"color:#24292E\"\u003e    \u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan style=\"color:#6A737D\"\u003e    # Detect person and garment in parallel, take top crop of each\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan style=\"color:#24292E\"\u003e    p_det, g_det \u003c/span\u003e\u003cspan style=\"color:#D73A49\"\u003e=\u003c/span\u003e\u003cspan style=\"color:#D73A49\"\u003e await\u003c/span\u003e\u003cspan style=\"color:#24292E\"\u003e asyncio.gather(\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan style=\"color:#24292E\"\u003e        vlmrun.image.detect(person_image, \u003c/span\u003e\u003cspan style=\"color:#032F62\"\u003e\"person\"\u003c/span\u003e\u003cspan style=\"color:#24292E\"\u003e),\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan style=\"color:#24292E\"\u003e        vlmrun.image.detect(dress_img, \u003c/span\u003e\u003cspan style=\"color:#032F62\"\u003e\"garment\"\u003c/span\u003e\u003cspan style=\"color:#24292E\"\u003e),\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan style=\"color:#24292E\"\u003e    )\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan style=\"color:#24292E\"\u003e    person_crop \u003c/span\u003e\u003cspan style=\"color:#D73A49\"\u003e=\u003c/span\u003e\u003cspan style=\"color:#24292E\"\u003e crop(person_image, p_det[\u003c/span\u003e\u003cspan style=\"color:#032F62\"\u003e\"detections\"\u003c/span\u003e\u003cspan style=\"color:#24292E\"\u003e][\u003c/span\u003e\u003cspan style=\"color:#005CC5\"\u003e0\u003c/span\u003e\u003cspan style=\"color:#24292E\"\u003e])\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan style=\"color:#24292E\"\u003e    garment_crop \u003c/span\u003e\u003cspan style=\"color:#D73A49\"\u003e=\u003c/span\u003e\u003cspan style=\"color:#24292E\"\u003e crop(dress_img, g_det[\u003c/span\u003e\u003cspan style=\"color:#032F62\"\u003e\"detections\"\u003c/span\u003e\u003cspan style=\"color:#24292E\"\u003e][\u003c/span\u003e\u003cspan style=\"color:#005CC5\"\u003e0\u003c/span\u003e\u003cspan style=\"color:#24292E\"\u003e])\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan style=\"color:#6A737D\"\u003e    # Composite the try-on and return the composite image\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan style=\"color:#24292E\"\u003e    (composite,) \u003c/span\u003e\u003cspan style=\"color:#D73A49\"\u003e=\u003c/span\u003e\u003cspan style=\"color:#D73A49\"\u003e await\u003c/span\u003e\u003cspan style=\"color:#24292E\"\u003e vlmrun.image.generate(\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan style=\"color:#032F62\"\u003e        \"virtual try-on\"\u003c/span\u003e\u003cspan style=\"color:#24292E\"\u003e, \u003c/span\u003e\u003cspan style=\"color:#E36209\"\u003eimages\u003c/span\u003e\u003cspan style=\"color:#D73A49\"\u003e=\u003c/span\u003e\u003cspan style=\"color:#24292E\"\u003e[person_crop, garment_crop]\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan style=\"color:#24292E\"\u003e    )\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan style=\"color:#D73A49\"\u003e    return\u003c/span\u003e\u003cspan style=\"color:#24292E\"\u003e {\u003c/span\u003e\u003cspan style=\"color:#032F62\"\u003e\"composite\"\u003c/span\u003e\u003cspan style=\"color:#24292E\"\u003e: composite}\u003c/span\u003e\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e"])</script><script>self.__next_f.push([1,"52:[\"$\",\"figure\",\"code-67\",{\"className\":\"my-6 overflow-hidden rounded-xl border border-border bg-white\",\"children\":[\"$\",\"div\",null,{\"className\":\"blog-code-shiki overflow-x-auto\",\"dangerouslySetInnerHTML\":{\"__html\":\"$71\"}}]}]\n53:[\"$\",\"p\",\"d491acaae45a\",{\"className\":\"my-5 text-blog-body text-blog-article\",\"children\":[\"When orchestration is code, verifiable correctness and determinism is a property of the program, even if a statistical model generated it. \"]}]\n54:[\"$\",\"p\",\"eff3a934a02b\",{\"className\":\"my-5 text-blog-body text-blog-article\",\"children\":[\"\"]}]\n55:[\"$\",\"h2\",\"507690a5679d\",{\"id\":\"under-the-hood-model-agnostic-purpose-built-runtime\",\"className\":\"mt-10 mb-1 scroll-mt-28 font-sans text-blog-h2 font-semibold text-primary-mid\",\"children\":[\"Under the Hood: Model-Agnostic, Purpose-Built Runtime\"]}]\n56:[\"$\",\"p\",\"3fb39557069f\",{\"className\":\"my-5 text-blog-body text-blog-article\",\"children\":[\"Orion 2 is a visual agent harness, not a model. Any multimodal model with strong code generation can drive the planner → execution → self-correction loop: open-weight VLMs like \",[\"$\",\"a\",\"4923da32b6dc\",{\"href\":\"https://huggingface.co/google/gemma-4-26B-A4B\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"className\":\"text-navy underline decoration-primary/30 underline-offset-[3px] transition-colors hover:text-primary\",\"children\":[\"Gemma4-26B-A4B\"]}],\" and \",[\"$\",\"a\",\"d998e5e9e070\",{\"href\":\"https://huggingface.co/Qwen/Qwen3.6-35B-A3B\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"className\":\"text-navy underline decoration-primary/30 underline-offset-[3px] transition-colors hover:text-primary\",\"children\":[\"Qwen3.6-35B-A3B\"]}],\", or frontier models like \",[\"$\",\"a\",\"b705ac27fb66\",{\"href\":\"https://blog.google/innovation-and-ai/models-and-research/gemini-models/gemini-3-5/\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"className\":\"text-navy underline decoration-primary/30 underline-offset-[3px] transition-colors hover:text-primary\",\"children\":[\"Gemini 3.5 Flash\"]}],\". Same harness, same runtime, different engine.\"]}]\n57:[\"$\",\"p\",\"0eaa7bcc9fef\",{\"className\":\"my-5 text-blog-body text-blog-article\",\"children\":[\"The benchmark below runs all three backbones through the identical harness. Each brings different strengths – Gemma4 leads on localization, Gemini 3.5 Flash on segmentation and video – and Orion 2 inherits every improvement in vision-grounded code generation, open or closed, for free.\"]}]\n58:[\"$\",\"p\",\"3b9393655cea\",{\"className\":\"my-5 text-blog-body text-blog-article\",\"children\":[\"The default, \",[\"$\",\"code\",\"4d1e3eaa940e\",{\"className\":\"rounded-md bg-primary/10 px-1.5 py-0.5 font-mono text-code text-primary\",\"children\":[\"vlmrun-orion-2:auto\"]}],\", routes each request to the best backbone for the job, so you get the frontier of all three without choosing. Open-weight backbones run on our purpose-built inference runtime: favorable GPU economics at volume, deployable in isolated cloud environments. Pin a fixed backbone through the gateway when compliance or reproducibility demands it.\"]}]\n59:[\"$\",\"p\",\"351d31b7f02c\",{\"className\":\"my-5 text-blog-body text-blog-article\",\"children\":[\"\"]}]\n5a:[\"$\",\"h2\",\"h2-103\",{\"id\":\"examples\",\"className\":\"mt-10 mb-1 scroll-mt-28 font-sans text-blog-h2 font-semibold text-primary-mid\",\"children\":[\"Examples\"]}]\n5b:[\"$\",\"p\",\"normal-105\",{\"className\":\"my-5 text-blog-body text-blog-article\",\"children\":[\"See Orion 2 in action in the following chat thread examples and inspect the artifacts.\"]}]\n5c:[\"$\",\"h3\",\"h3-107\",{\"id\":\"virtual-try-on\",\"className\":\"mb-1 mt-8 scroll-mt-28 font-sans text-blog-h3 font-normal text-primary-mid\",\"children\":[\"Virtual try-on\"]}]\n5d:[\"$\",\"p\",\"3d633dd78a26\",{\"className\":\"my-5 text-blog-body text-blog-article\",\"children\":[\"Given an image of a dress and an image of a model, Orion 2 creates a realistic virtual try-on in a single turn. It detects the person and the garment in parallel, crops each subject in-process, generates the composite with one image-generation call, and asks a vision-LLM whether the fit looks natural – composing four distinct visual operations as a single program,"])</script><script>self.__next_f.push([1," with the intermediate crops, composite, and verdict all available as inspectable artifacts. See \",[\"$\",\"a\",\"6d17fc652045\",{\"href\":\"https://chat.vlm.run/c/588e485e-7e47-4742-b77c-68bbe1623474\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"className\":\"text-navy underline decoration-primary/30 underline-offset-[3px] transition-colors hover:text-primary\",\"children\":[\"chat\"]}],\". \",[\"$\",\"br\",\"node-3\",{}],\"\"]}]\n5e:[\"$\",\"$L72\",\"chat-110\",{\"chatUrl\":\"https://chat.vlm.run/c/588e485e-7e47-4742-b77c-68bbe1623474\",\"title\":\"Virtual try-on in Orion 2\",\"description\":\"One pipeline, multiple visual operations, parallelized — the cleanest illustration of code-mode speed.\",\"display\":\"inline\",\"buttonLabel\":\"$undefined\"}]\n5f:[\"$\",\"h3\",\"h3-117\",{\"id\":\"robotics-physical-ai\",\"className\":\"mb-1 mt-8 scroll-mt-28 font-sans text-blog-h3 font-normal text-primary-mid\",\"children\":[\"Robotics \u0026 Physical AI\"]}]\n60:[\"$\",\"p\",\"6bf99b5f2d67\",{\"className\":\"my-5 text-blog-body text-blog-article\",\"children\":[\"Orion 2 extracts a representative frame from a robotics video, segments every object in the scene in parallel, and hands off the per-object masks to generate an interactive 3D reconstruction. The frame sampling, fan-out segmentation, and 3D-reconstruction handoff all live in a single program, so the intermediate frame, masks, and reconstruction are produced together in one turn and available as inspectable artifacts. See \",[\"$\",\"a\",\"a862b9c20554\",{\"href\":\"https://chat.vlm.run/c/e2ea96a4-4175-43c3-a0cf-d2d6e40ebac9\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"className\":\"text-navy underline decoration-primary/30 underline-offset-[3px] transition-colors hover:text-primary\",\"children\":[\"chat\"]}],\".\",[\"$\",\"br\",\"node-3\",{}],\"\"]}]\n61:[\"$\",\"$L72\",\"chat-120\",{\"chatUrl\":\"https://chat.vlm.run/c/e2ea96a4-4175-43c3-a0cf-d2d6e40ebac9\",\"title\":\"Robotics scene tracking in Orion 2\",\"description\":\"Video transcription, key-point tracking, and motion analytics in one end-to-end program.\",\"display\":\"inline\",\"buttonLabel\":\"$undefined\"}]\n62:[\"$\",\"h3\",\"h3-122\",{\"id\":\"multi-document-workflow\",\"className\":\"mb-1 mt-8 scroll-mt-28 font-sans text-blog-h3 font-normal text-primary-mid\",\"children\":[\"Multi-document workflow\"]}]\n63:[\"$\",\"p\",\"f35bd1e04751\",{\"className\":\"my-5 text-blog-body text-blog-article\",\"children\":[\"Given a multi-page healthcare PDF, Orion 2 splits a batch of healthcare documents into per-page images and classifies each one – claim form, instructions, insurance ID card, medical history, physician referral form etc. It then focuses on the referral form, helping the user localize the patient and physician names, and returns the full structured extraction grounded to the source page – every page split and bounding box available as inspectable artifacts. See \",[\"$\",\"a\",\"917b89a133f3\",{\"href\":\"https://chat.vlm.run/c/0194eadb-817b-47b6-9464-0361930b7325\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"className\":\"text-navy underline decoration-primary/30 underline-offset-[3px] transition-colors hover:text-primary\",\"children\":[\"chat\"]}],\".\",[\"$\",\"br\",\"node-3\",{}],\"\"]}]\n64:[\"$\",\"$L72\",\"chat-125\",{\"chatUrl\":\"https://chat.vlm.run/c/0194eadb-817b-47b6-9464-0361930b7325\",\"title\":\"Multi-document parsing in Orion 2\",\"description\":\"Parse, align, and summarize across multiple documents in one reusable pipeline.\",\"display\":\"inline\",\"buttonLabel\":\"$undefined\"}]\n65:[\"$\",\"h3\",\"h3-112\",{\"id\":\"manipulating-images\",\"className\":\"mb-1 mt-8 scroll-mt-28 font-sans text-blog-h3 font-normal text-primary-mid\",\"children\":[\"Manipulating Images\"]}]\n66:[\"$\",\"p\",\"63c68f119905\",{\"className\":\"my-5 text-blog-body text-blog-article\",\"children\":[\"Orion 2 manipulates images on-the-fly with native OpenCV – Gaussian blur, Canny edge detection, color pop, and other cv2 compositions are written directly into the script and run in parallel where independent operations can be composed, instead of being constrained to a fixed, pre-defined tool surface. See \",[\"$\",\"a\",\"2bee89118114\",{\"href\":\"https://chat.vlm.run/c/733e38c7-f2e7-4a2b-a9e3-ffc201412cc1\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"classN"])</script><script>self.__next_f.push([1,"ame\":\"text-navy underline decoration-primary/30 underline-offset-[3px] transition-colors hover:text-primary\",\"children\":[\"chat\"]}],\".\",[\"$\",\"br\",\"node-3\",{}],\"\"]}]\n67:[\"$\",\"$L72\",\"chat-115\",{\"chatUrl\":\"https://chat.vlm.run/c/733e38c7-f2e7-4a2b-a9e3-ffc201412cc1\",\"title\":\"Counting produce with a cv2 mosaic in Orion 2\",\"description\":\"Detect → tile → count → annotate, with the counting done deterministically in code.\",\"display\":\"inline\",\"buttonLabel\":\"$undefined\"}]\n68:[\"$\",\"h2\",\"h2-127\",{\"id\":\"benchmarks\",\"className\":\"mt-10 mb-1 scroll-mt-28 font-sans text-blog-h2 font-semibold text-primary-mid\",\"children\":[\"Benchmarks\"]}]\n69:[\"$\",\"p\",\"02621d6b8caa\",{\"className\":\"my-5 text-blog-body text-blog-article\",\"children\":[\"When we launched Orion 1, we showcased a \",[\"$\",\"a\",\"e927d047d4c6\",{\"href\":\"https://storage.googleapis.com/vlm-data-public-prod/web/assets/vlmrun-orion-whitepaper-latest.pdf\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"className\":\"text-navy underline decoration-primary/30 underline-offset-[3px] transition-colors hover:text-primary\",\"children\":[\"benchmark dataset\"]}],\" of 30+ multi-modal, multi-turn tasks involving complex reasoning and agentic actions on images, documents, and videos.\"]}]\n6a:[\"$\",\"p\",\"0049d4591424\",{\"className\":\"my-5 text-blog-body text-blog-article\",\"children\":[\"With Orion 2's code-execution capabilities, we expand the benchmark to 250+ multi-turn cases across image, document, audio, video, and multi-file inputs, covering perception, counting, OCR, grounding, and cross-turn reasoning. The hard tier introduces generative tool-use actions – cropping, masking, blurring, redaction, segmentation, keyframe extraction – that exercise Orion 2's code-mode through the VLM Run Chat Completions API. \",[\"$\",\"br\",\"node-1\",{}],\"\",[\"$\",\"br\",\"node-3\",{}],\"Although state-of-the-art multimodal models perform well on many vision tasks, they do not cover the full spectrum of visual capabilities and are largely constrained to text-based outputs. Orion extends beyond traditional MLLMs by providing both pixel-level understanding and spatial reasoning capabilities, enabling richer interactions with visual content and more precise grounding in the visual world.\"]}]\n6b:[\"$\",\"p\",\"f8ad5f909685\",{\"className\":\"my-5 text-blog-body text-blog-article\",\"children\":[\"\"]}]\n6c:[\"$\",\"p\",\"normal-134\",{\"className\":\"my-5 text-blog-body text-blog-article\",\"children\":[\"\"]}]\n74:T600d,"])</script><script>self.__next_f.push([1,"\u003c!DOCTYPE html\u003e\n\u003chtml lang=\"en\"\u003e\n\u003chead\u003e\n\u003cmeta charset=\"UTF-8\"\u003e\n\u003cmeta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\"\u003e\n\u003ctitle\u003eOrion 2 capability and accuracy breakdown\u003c/title\u003e\n\u003clink rel=\"preconnect\" href=\"https://fonts.googleapis.com\"\u003e\n\u003clink rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin\u003e\n\u003clink href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700\u0026display=swap\" rel=\"stylesheet\"\u003e\n\u003cstyle\u003e\n  :root {\n    --ink: #1F2937;\n    --ink-muted: #64748B;\n    --ink-faint: #94A3B8;\n    --border: #D1E9FF;\n    --grid: #EEF2F7;\n    --brand-blue-dark: #1D4ED8;\n    --tier-high: #93C5FD;\n    --tier-med: #BFDBFE;\n    --tier-low: #DBEAFE;\n    --tier-text: #1E3A8A;\n    --gap-bg: #F9F8EC;\n    --gap-text: #9CA3AF;\n    --gemma: #93C5FD;\n    --qwen: #B3A2FA;\n    --g35: #4E8DF7;\n  }\n  * { box-sizing: border-box; margin: 0; padding: 0; }\n  html, body { background: transparent; overflow: hidden; }\n  body {\n    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;\n    color: var(--ink);\n    padding: 0;\n    -webkit-font-smoothing: antialiased;\n  }\n  .page {\n    width: 100%;\n    max-width: 1020px;\n    margin: 0 auto;\n  }\n  .card {\n    background: #FFFFFF;\n    border: 1px solid var(--border);\n    border-radius: 20px;\n    padding: 20px 24px 18px;\n    margin-bottom: 18px;\n    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);\n    overflow: hidden;\n  }\n  .card:last-child { margin-bottom: 0; }\n  .card h2 {\n    font-size: 15.5px;\n    font-weight: 600;\n    letter-spacing: -0.01em;\n    margin-bottom: 14px;\n  }\n  .legend {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 14px;\n    font-size: 12.5px;\n    font-weight: 500;\n    color: var(--ink-muted);\n    margin-bottom: 12px;\n  }\n  .legend-filter {\n    appearance: none;\n    -webkit-appearance: none;\n    display: inline-flex;\n    align-items: center;\n    gap: 7px;\n    border: 0;\n    border-radius: 0;\n    background: transparent;\n    box-shadow: none;\n    color: inherit;\n    cursor: pointer;\n    font: inherit;\n    line-height: inherit;\n    outline: none;\n    padding: 0;\n    margin: 0;\n    text-align: left;\n    transition: color 160ms ease, opacity 160ms ease;\n  }\n  .legend-filter:hover,\n  .legend-filter:focus-visible,\n  .legend-filter.is-active {\n    color: var(--ink);\n  }\n  .legend-filter:focus-visible .swatch,\n  .legend-filter.is-active .swatch {\n    box-shadow: 0 0 0 2px rgba(15, 23, 42, 0.12);\n  }\n  .swatch {\n    width: 12px;\n    height: 12px;\n    border-radius: 4px;\n    display: inline-block;\n  }\n  .table-scroll,\n  .chart-scroll {\n    overflow: visible;\n  }\n  table {\n    width: 100%;\n    min-width: 0;\n    table-layout: fixed;\n    border-collapse: separate;\n    border-spacing: 5px;\n    font-size: 13px;\n  }\n  th {\n    font-size: 13px;\n    font-weight: 600;\n    padding-bottom: 6px;\n  }\n  th.label-col { width: 190px; }\n  th.orion { color: var(--brand-blue-dark); }\n  th.frontier { color: var(--ink-faint); font-weight: 500; }\n  .row-label {\n    font-size: 13px;\n    color: var(--ink);\n    padding-right: 8px;\n    text-align: right;\n    font-weight: 500;\n  }\n  td.cell {\n    text-align: center;\n    padding: 11px 4px;\n    border-radius: 8px;\n    font-weight: 600;\n    font-size: 12.5px;\n  }\n  td.high { background: var(--tier-high); color: var(--tier-text); }\n  td.med { background: var(--tier-med); color: var(--tier-text); }\n  td.low { background: var(--tier-low); color: var(--tier-text); }\n  td.gap { background: var(--gap-bg); color: var(--gap-text); font-weight: 500; }\n  svg {\n    display: block;\n    width: 100%;\n    height: auto;\n    min-width: 0;\n    overflow: visible;\n  }\n  svg text { font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif; }\n  .bar-segment,\n  .capability-cell {\n    cursor: pointer;\n    outline: none;\n    transition: opacity 160ms ease, filter 160ms ease;\n  }\n  .bar-segment:hover,\n  .bar-segment:focus-visible,\n  .bar-segment.is-active {\n    filter: drop-shadow(0 8px 14px rgba(15, 23, 42, 0.14));\n  }\n  .capability-cell:hover,\n  .capability-cell:focus-visible,\n  .capability-cell.is-active {\n    box-shadow: 0 8px 18px rgba(15, 23, 42, 0.12);\n    position: relative;\n    z-index: 1;\n  }\n  svg.has-active .bar-segment {\n    opacity: 0.22;\n  }\n  svg.has-active .bar-segment.is-active {\n    opacity: 1;\n  }\n  .capability-table.has-active .capability-cell {\n    opacity: 0.22;\n  }\n  .capability-table.has-active .capability-cell.is-active {\n    opacity: 1;\n  }\n  .stacked-tooltip {\n    position: fixed;\n    z-index: 20;\n    left: 0;\n    top: 0;\n    min-width: 176px;\n    pointer-events: none;\n    opacity: 0;\n    transform: translate3d(-999px, -999px, 0) scale(0.98);\n    transition: opacity 120ms ease, transform 120ms ease;\n    border: 1px solid rgba(203, 213, 225, 0.9);\n    border-radius: 14px;\n    background: rgba(255, 255, 255, 0.96);\n    box-shadow: 0 14px 34px rgba(15, 23, 42, 0.16);\n    padding: 12px 14px;\n    color: var(--ink);\n    backdrop-filter: blur(10px);\n  }\n  .stacked-tooltip.visible {\n    opacity: 1;\n    transform: translate3d(var(--tooltip-x), var(--tooltip-y), 0) scale(1);\n  }\n  .tooltip-category {\n    font-size: 13px;\n    font-weight: 700;\n    letter-spacing: -0.01em;\n    margin-bottom: 8px;\n  }\n  .tooltip-row {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 18px;\n    font-size: 12.5px;\n    color: var(--ink-muted);\n  }\n  .tooltip-model {\n    display: flex;\n    align-items: center;\n    gap: 7px;\n  }\n  .tooltip-swatch {\n    width: 10px;\n    height: 10px;\n    border-radius: 3px;\n    flex: 0 0 auto;\n  }\n  .tooltip-value {\n    color: var(--ink);\n    font-weight: 700;\n    font-variant-numeric: tabular-nums;\n  }\n  @media (max-width: 720px) {\n    .card { padding: 16px 12px 16px; }\n    .card h2 { font-size: 14px; }\n    .legend { gap: 10px; font-size: 10.5px; }\n    th { font-size: 10.5px; }\n    th.label-col { width: 150px; }\n    .row-label { font-size: 11px; }\n    td.cell { font-size: 11.5px; padding: 10px 2px; }\n    .stacked-tooltip { display: none; }\n  }\n\u003c/style\u003e\n\u003c/head\u003e\n\u003cbody\u003e\n\u003cmain class=\"page\"\u003e\n  \u003csection class=\"card\" aria-labelledby=\"stacked-capability-title\"\u003e\n    \u003ch2 id=\"stacked-capability-title\"\u003eCapability coverage vs. frontier models\u003c/h2\u003e\n    \u003cdiv class=\"legend\"\u003e\n      \u003cbutton class=\"legend-filter\" type=\"button\" aria-pressed=\"false\" data-scope=\"capability\" data-filter-type=\"tier\" data-filter-value=\"high\" data-category=\"Capability tier\" data-model=\"All models\" data-value=\"high\" data-color=\"#93C5FD\"\u003e\u003ci class=\"swatch\" style=\"background: var(--tier-high)\"\u003e\u003c/i\u003ehigh\u003c/button\u003e\n      \u003cbutton class=\"legend-filter\" type=\"button\" aria-pressed=\"false\" data-scope=\"capability\" data-filter-type=\"tier\" data-filter-value=\"med\" data-category=\"Capability tier\" data-model=\"All models\" data-value=\"med\" data-color=\"#BFDBFE\"\u003e\u003ci class=\"swatch\" style=\"background: var(--tier-med)\"\u003e\u003c/i\u003emed\u003c/button\u003e\n      \u003cbutton class=\"legend-filter\" type=\"button\" aria-pressed=\"false\" data-scope=\"capability\" data-filter-type=\"tier\" data-filter-value=\"low\" data-category=\"Capability tier\" data-model=\"All models\" data-value=\"low\" data-color=\"#DBEAFE\"\u003e\u003ci class=\"swatch\" style=\"background: var(--tier-low)\"\u003e\u003c/i\u003elow\u003c/button\u003e\n      \u003cbutton class=\"legend-filter\" type=\"button\" aria-pressed=\"false\" data-scope=\"capability\" data-filter-type=\"tier\" data-filter-value=\"not supported\" data-category=\"Capability tier\" data-model=\"All models\" data-value=\"not supported\" data-color=\"#F9F8EC\"\u003e\u003ci class=\"swatch\" style=\"background: var(--gap-bg); border: 1px solid #E5E4D8\"\u003e\u003c/i\u003e- not supported\u003c/button\u003e\n    \u003c/div\u003e\n    \u003cdiv class=\"table-scroll\"\u003e\n      \u003ctable id=\"stacked-capability-table\" class=\"capability-table\"\u003e\n        \u003cthead\u003e\n          \u003ctr\u003e\n            \u003cth class=\"label-col\" scope=\"col\" aria-label=\"Capability\"\u003e\u003c/th\u003e\n            \u003cth class=\"orion\" scope=\"col\"\u003eOrion-2 Pro\u003c/th\u003e\n            \u003cth class=\"frontier\" scope=\"col\"\u003eGemini 3.5 Flash\u003c/th\u003e\n            \u003cth class=\"frontier\" scope=\"col\"\u003eGPT-5.5\u003c/th\u003e\n            \u003cth class=\"frontier\" scope=\"col\"\u003eClaude Opus 4.8\u003c/th\u003e\n          \u003c/tr\u003e\n        \u003c/thead\u003e\n        \u003ctbody\u003e\n          \u003ctr\u003e\u003cth class=\"row-label\" scope=\"row\"\u003eImage understanding\u003c/th\u003e\u003ctd class=\"cell high\"\u003ehigh\u003c/td\u003e\u003ctd class=\"cell high\"\u003ehigh\u003c/td\u003e\u003ctd class=\"cell high\"\u003ehigh\u003c/td\u003e\u003ctd class=\"cell high\"\u003ehigh\u003c/td\u003e\u003c/tr\u003e\n          \u003ctr\u003e\u003cth class=\"row-label\" scope=\"row\"\u003eOCR \u0026amp; documents\u003c/th\u003e\u003ctd class=\"cell high\"\u003ehigh\u003c/td\u003e\u003ctd class=\"cell high\"\u003ehigh\u003c/td\u003e\u003ctd class=\"cell high\"\u003ehigh\u003c/td\u003e\u003ctd class=\"cell high\"\u003ehigh\u003c/td\u003e\u003c/tr\u003e\n          \u003ctr\u003e\u003cth class=\"row-label\" scope=\"row\"\u003eGrounding \u0026amp; evidence\u003c/th\u003e\u003ctd class=\"cell high\"\u003ehigh\u003c/td\u003e\u003ctd class=\"cell high\"\u003ehigh\u003c/td\u003e\u003ctd class=\"cell high\"\u003ehigh\u003c/td\u003e\u003ctd class=\"cell high\"\u003ehigh\u003c/td\u003e\u003c/tr\u003e\n          \u003ctr\u003e\u003cth class=\"row-label\" scope=\"row\"\u003eLocalization \u0026amp; counting\u003c/th\u003e\u003ctd class=\"cell med\"\u003emed\u003c/td\u003e\u003ctd class=\"cell med\"\u003emed\u003c/td\u003e\u003ctd class=\"cell med\"\u003emed\u003c/td\u003e\u003ctd class=\"cell med\"\u003emed\u003c/td\u003e\u003c/tr\u003e\n          \u003ctr\u003e\u003cth class=\"row-label\" scope=\"row\"\u003eSegmentation \u0026amp; masking\u003c/th\u003e\u003ctd class=\"cell high\"\u003ehigh\u003c/td\u003e\u003ctd class=\"cell gap\" aria-label=\"not supported\"\u003e\u003cspan aria-hidden=\"true\"\u003e-\u003c/span\u003e\u003c/td\u003e\u003ctd class=\"cell gap\" aria-label=\"not supported\"\u003e\u003cspan aria-hidden=\"true\"\u003e-\u003c/span\u003e\u003c/td\u003e\u003ctd class=\"cell gap\" aria-label=\"not supported\"\u003e\u003cspan aria-hidden=\"true\"\u003e-\u003c/span\u003e\u003c/td\u003e\u003c/tr\u003e\n          \u003ctr\u003e\u003cth class=\"row-label\" scope=\"row\"\u003eAudio/Video understanding\u003c/th\u003e\u003ctd class=\"cell high\"\u003ehigh\u003c/td\u003e\u003ctd class=\"cell med\"\u003emed\u003c/td\u003e\u003ctd class=\"cell gap\" aria-label=\"not supported\"\u003e\u003cspan aria-hidden=\"true\"\u003e-\u003c/span\u003e\u003c/td\u003e\u003ctd class=\"cell gap\" aria-label=\"not supported\"\u003e\u003cspan aria-hidden=\"true\"\u003e-\u003c/span\u003e\u003c/td\u003e\u003c/tr\u003e\n          \u003ctr\u003e\u003cth class=\"row-label\" scope=\"row\"\u003eAudio/Video operations\u003c/th\u003e\u003ctd class=\"cell low\"\u003elow\u003c/td\u003e\u003ctd class=\"cell gap\" aria-label=\"not supported\"\u003e\u003cspan aria-hidden=\"true\"\u003e-\u003c/span\u003e\u003c/td\u003e\u003ctd class=\"cell gap\" aria-label=\"not supported\"\u003e\u003cspan aria-hidden=\"true\"\u003e-\u003c/span\u003e\u003c/td\u003e\u003ctd class=\"cell gap\" aria-label=\"not supported\"\u003e\u003cspan aria-hidden=\"true\"\u003e-\u003c/span\u003e\u003c/td\u003e\u003c/tr\u003e\n        \u003c/tbody\u003e\n      \u003c/table\u003e\n    \u003c/div\u003e\n  \u003c/section\u003e\n\n  \u003csection class=\"card\"\u003e\n    \u003ch2\u003eAccuracy vs. difficulty across Orion backbones\u003c/h2\u003e\n    \u003cdiv class=\"legend\"\u003e\n      \u003cbutton class=\"legend-filter\" type=\"button\" aria-pressed=\"false\" data-scope=\"stacked-chart-difficulty\" data-filter-type=\"model\" data-filter-value=\"gemma\" data-category=\"Model filter\" data-model=\"orion-2:gemma4-26b-a4b\" data-value=\"all difficulty bars\" data-color=\"#93C5FD\"\u003e\u003ci class=\"swatch\" style=\"background: var(--gemma)\"\u003e\u003c/i\u003eorion-2:gemma4-26b-a4b\u003c/button\u003e\n      \u003cbutton class=\"legend-filter\" type=\"button\" aria-pressed=\"false\" data-scope=\"stacked-chart-difficulty\" data-filter-type=\"model\" data-filter-value=\"auto\" data-category=\"Model filter\" data-model=\"orion-2:qwen3.6-35b-a3b\" data-value=\"all difficulty bars\" data-color=\"#B3A2FA\"\u003e\u003ci class=\"swatch\" style=\"background: var(--qwen)\"\u003e\u003c/i\u003eorion-2:qwen3.6-35b-a3b\u003c/button\u003e\n      \u003cbutton class=\"legend-filter\" type=\"button\" aria-pressed=\"false\" data-scope=\"stacked-chart-difficulty\" data-filter-type=\"model\" data-filter-value=\"pro\" data-category=\"Model filter\" data-model=\"orion-2:gemini-3.5-flash\" data-value=\"all difficulty bars\" data-color=\"#4E8DF7\"\u003e\u003ci class=\"swatch\" style=\"background: var(--g35)\"\u003e\u003c/i\u003eorion-2:gemini-3.5-flash\u003c/button\u003e\n    \u003c/div\u003e\n    \u003cdiv class=\"chart-scroll\"\u003e\u003cdiv id=\"stacked-chart-difficulty\"\u003e\u003c/div\u003e\u003c/div\u003e\n  \u003c/section\u003e\n\n  \u003csection class=\"card\"\u003e\n    \u003ch2\u003eAccuracy vs. task across Orion backbones\u003c/h2\u003e\n    \u003cdiv class=\"legend\"\u003e\n      \u003cbutton class=\"legend-filter\" type=\"button\" aria-pressed=\"false\" data-scope=\"stacked-chart-task\" data-filter-type=\"model\" data-filter-value=\"gemma\" data-category=\"Model filter\" data-model=\"orion-2:gemma4-26b-a4b\" data-value=\"all task bars\" data-color=\"#93C5FD\"\u003e\u003ci class=\"swatch\" style=\"background: var(--gemma)\"\u003e\u003c/i\u003eorion-2:gemma4-26b-a4b\u003c/button\u003e\n      \u003cbutton class=\"legend-filter\" type=\"button\" aria-pressed=\"false\" data-scope=\"stacked-chart-task\" data-filter-type=\"model\" data-filter-value=\"auto\" data-category=\"Model filter\" data-model=\"orion-2:qwen3.6-35b-a3b\" data-value=\"all task bars\" data-color=\"#B3A2FA\"\u003e\u003ci class=\"swatch\" style=\"background: var(--qwen)\"\u003e\u003c/i\u003eorion-2:qwen3.6-35b-a3b\u003c/button\u003e\n      \u003cbutton class=\"legend-filter\" type=\"button\" aria-pressed=\"false\" data-scope=\"stacked-chart-task\" data-filter-type=\"model\" data-filter-value=\"pro\" data-category=\"Model filter\" data-model=\"orion-2:gemini-3.5-flash\" data-value=\"all task bars\" data-color=\"#4E8DF7\"\u003e\u003ci class=\"swatch\" style=\"background: var(--g35)\"\u003e\u003c/i\u003eorion-2:gemini-3.5-flash\u003c/button\u003e\n    \u003c/div\u003e\n    \u003cdiv class=\"chart-scroll\"\u003e\u003cdiv id=\"stacked-chart-task\"\u003e\u003c/div\u003e\u003c/div\u003e\n  \u003c/section\u003e\n\u003c/main\u003e\n\u003cdiv id=\"stacked-tooltip\" class=\"stacked-tooltip\" role=\"tooltip\" aria-hidden=\"true\"\u003e\u003c/div\u003e\n\n\u003cscript\u003e\nconst STACKED_MODELS = [\n  { key: \"gemma\", fill: \"#93C5FD\", stroke: \"none\" },\n  { key: \"auto\", fill: \"#B3A2FA\", stroke: \"none\" },\n  { key: \"pro\", fill: \"#4E8DF7\", stroke: \"none\" },\n];\n\nconst STACKED_DIFFICULTY = [\n  { label: [\"Easy\"], gemma: 84.0, auto: 86.0, pro: 100.0 },\n  { label: [\"Medium\"], gemma: 92.0, auto: 89.0, pro: 82.0 },\n  { label: [\"Hard\"], gemma: 66.7, auto: 60.0, pro: 70.0 },\n  { label: [\"Overall\"], gemma: 82.1, auto: 79.7, pro: 85.5 },\n];\n\nconst STACKED_TASKS = [\n  { label: [\"Image\", \"Understanding\"], gemma: 95.0, auto: 85.0, pro: 100.0 },\n  { label: [\"OCR \u0026amp;\", \"Documents\"], gemma: 91.7, auto: 93.3, pro: 78.3 },\n  { label: [\"Grounding\", \"\u0026amp; Evidence\"], gemma: 100.0, auto: 100.0, pro: 100.0 },\n  { label: [\"Localization\", \"\u0026amp; Counting\"], gemma: 90.0, auto: 76.0, pro: 70.0 },\n  { label: [\"Segmentation\", \"\u0026amp; Masking\"], gemma: 91.7, auto: 62.5, pro: 100.0 },\n  { label: [\"Audio/Video\", \"Understanding\"], gemma: 33.3, auto: 66.7, pro: 100.0 },\n  { label: [\"Audio/Video\", \"Operations\"], gemma: 50.0, auto: 50.0, pro: 50.0 },\n];\n\nfunction stackedEscapeSvgText(value) {\n  return String(value).replace(/\u0026/g, \"\u0026amp;\").replace(/\u003c/g, \"\u0026lt;\").replace(/\u003e/g, \"\u0026gt;\");\n}\n\nfunction stackedEscapeAttr(value) {\n  return stackedEscapeSvgText(value).replace(/\"/g, \"\u0026quot;\");\n}\n\nfunction stackedReadableLabel(label) {\n  return label.join(\" \").replace(/\u0026amp;/g, \"\u0026\");\n}\n\nfunction stackedModelName(key) {\n  if (key === \"gemma\") return \"orion-2:gemma4-26b-a4b\";\n  if (key === \"auto\") return \"orion-2:qwen3.6-35b-a3b\";\n  return \"orion-2:gemini-3.5-flash\";\n}\n\nfunction stackedModelColor(key) {\n  if (key === \"gemma\") return \"#93C5FD\";\n  if (key === \"auto\") return \"#B3A2FA\";\n  return \"#4E8DF7\";\n}\n\nfunction stackedTierColor(tier) {\n  if (tier === \"high\") return \"#93C5FD\";\n  if (tier === \"med\") return \"#BFDBFE\";\n  if (tier === \"low\") return \"#DBEAFE\";\n  return \"#F9F8EC\";\n}\n\nfunction installCapabilityCellMetadata() {\n  const table = document.getElementById(\"stacked-capability-table\");\n  if (!table) return;\n\n  const models = Array.from(table.querySelectorAll(\"thead th\"))\n    .slice(1)\n    .map((header) =\u003e header.textContent.trim());\n\n  table.querySelectorAll(\"tbody tr\").forEach((row) =\u003e {\n    const capability = row.querySelector(\".row-label\")?.textContent.trim() || \"Capability\";\n\n    row.querySelectorAll(\"td.cell\").forEach((cell, index) =\u003e {\n      const rawTier = cell.textContent.trim();\n      const tier = rawTier === \"-\" ? \"not supported\" : rawTier;\n      const model = models[index] || \"Model\";\n\n      cell.classList.add(\"capability-cell\");\n      cell.tabIndex = 0;\n      cell.setAttribute(\"role\", \"button\");\n      cell.setAttribute(\"aria-pressed\", \"false\");\n      cell.setAttribute(\"aria-label\", capability + \", \" + model + \", \" + tier);\n      cell.dataset.category = capability;\n      cell.dataset.model = model;\n      cell.dataset.value = tier;\n      cell.dataset.color = stackedTierColor(tier);\n    });\n  });\n}\n\nfunction stackedChartDescription(groups) {\n  return groups.map((group) =\u003e {\n    const values = STACKED_MODELS.map((model) =\u003e stackedModelName(model.key) + \" \" + Math.round(group[model.key]) + \"%\").join(\", \");\n    return stackedReadableLabel(group.label) + \": \" + values;\n  }).join(\"; \");\n}\n\nfunction renderStackedChart(elId, groups, opts) {\n  const width = 1020;\n  const plotH = opts.plotH;\n  const barW = opts.barW;\n  const barGap = opts.barGap;\n  const padL = 46;\n  const padR = 8;\n  const padT = 24;\n  const padB = 40;\n  const plotW = width - padL - padR;\n  const height = padT + plotH + padB;\n  const groupW = plotW / groups.length;\n  const groupBarsW = STACKED_MODELS.length * barW + (STACKED_MODELS.length - 1) * barGap;\n  const titleId = elId + \"-title\";\n  const descId = elId + \"-desc\";\n\n  let svg = '\u003csvg viewBox=\"0 0 ' + width + ' ' + height + '\" width=\"100%\" role=\"img\" aria-labelledby=\"' + titleId + ' ' + descId + '\"\u003e' +\n    '\u003ctitle id=\"' + titleId + '\"\u003e' + stackedEscapeSvgText(opts.label) + '\u003c/title\u003e' +\n    '\u003cdesc id=\"' + descId + '\"\u003e' + stackedEscapeSvgText(stackedChartDescription(groups)) + '\u003c/desc\u003e';\n\n  for (let value = 0; value \u003c= 100; value += 25) {\n    const y = padT + plotH - (value / 100) * plotH;\n    svg += '\u003cline x1=\"' + padL + '\" y1=\"' + y + '\" x2=\"' + (width - padR) + '\" y2=\"' + y + '\" stroke=\"#EEF2F7\" stroke-width=\"' + (value === 0 ? 1.5 : 1) + '\"/\u003e';\n    svg += '\u003ctext x=\"' + (padL - 10) + '\" y=\"' + (y + 4) + '\" font-size=\"11.5\" fill=\"#94A3B8\" text-anchor=\"end\"\u003e' + value + '%\u003c/text\u003e';\n  }\n\n  groups.forEach((group, groupIndex) =\u003e {\n    const centerX = padL + groupIndex * groupW + groupW / 2;\n    let barX = centerX - groupBarsW / 2;\n\n    STACKED_MODELS.forEach((model) =\u003e {\n      const value = group[model.key];\n      const categoryLabel = stackedReadableLabel(group.label);\n      const modelLabel = stackedModelName(model.key);\n      const valueLabel = Math.round(value) + \"%\";\n      const barH = Math.max((value / 100) * plotH, 2);\n      const barY = padT + plotH - barH;\n      const radius = Math.min(5, barH / 2);\n      const outline = 'M' + barX + ',' + (padT + plotH) +\n        ' v' + (-(barH - radius)) +\n        ' q0,' + (-radius) + ' ' + radius + ',' + (-radius) +\n        ' h' + (barW - 2 * radius) +\n        ' q' + radius + ',0 ' + radius + ',' + radius +\n        ' v' + (barH - radius);\n\n      svg += '\u003cg class=\"bar-segment\" tabindex=\"0\" role=\"button\" aria-pressed=\"false\" aria-label=\"' + stackedEscapeAttr(categoryLabel + \", \" + modelLabel + \", \" + valueLabel) + '\" data-category=\"' + stackedEscapeAttr(categoryLabel) + '\" data-model=\"' + stackedEscapeAttr(modelLabel) + '\" data-value=\"' + stackedEscapeAttr(valueLabel) + '\" data-model-key=\"' + stackedEscapeAttr(model.key) + '\" data-color=\"' + stackedEscapeAttr(stackedModelColor(model.key)) + '\"\u003e';\n      svg += '\u003cpath d=\"' + outline + ' z\" fill=\"' + model.fill + '\"/\u003e';\n      if (model.stroke !== \"none\") {\n        svg += '\u003cpath d=\"' + outline + '\" fill=\"none\" stroke=\"' + model.stroke + '\" stroke-width=\"1\"/\u003e';\n      }\n      svg += '\u003ctext x=\"' + (barX + barW / 2) + '\" y=\"' + (barY - 7) + '\" font-size=\"11\" font-weight=\"600\" fill=\"#64748B\" text-anchor=\"middle\"\u003e' + Math.round(value) + '\u003c/text\u003e';\n      svg += '\u003c/g\u003e';\n      barX += barW + barGap;\n    });\n\n    group.label.forEach((line, lineIndex) =\u003e {\n      svg += '\u003ctext x=\"' + centerX + '\" y=\"' + (padT + plotH + 18 + lineIndex * 14) + '\" font-size=\"12\" font-weight=\"500\" fill=\"#0F172A\" text-anchor=\"middle\"\u003e' + line + '\u003c/text\u003e';\n    });\n  });\n\n  svg += '\u003c/svg\u003e';\n  document.getElementById(elId).innerHTML = svg;\n}\n\nrenderStackedChart(\"stacked-chart-difficulty\", STACKED_DIFFICULTY, { plotH: 240, barW: 42, barGap: 8, label: \"Accuracy versus difficulty across Orion backbones\" });\nrenderStackedChart(\"stacked-chart-task\", STACKED_TASKS, { plotH: 260, barW: 20, barGap: 6, label: \"Accuracy versus task across Orion backbones\" });\n\nfunction installStackedChartInteractions() {\n  const tooltip = document.getElementById(\"stacked-tooltip\");\n  if (!tooltip) return;\n\n  installCapabilityCellMetadata();\n\n  let activeTarget = null;\n\n  function positionTooltip(event, anchor) {\n    const margin = 12;\n    const rect = tooltip.getBoundingClientRect();\n    const anchorRect = anchor?.getBoundingClientRect();\n    const pointerX = Number.isFinite(event.clientX) ? event.clientX : (anchorRect?.left ?? margin);\n    const pointerY = Number.isFinite(event.clientY) ? event.clientY : (anchorRect?.top ?? margin);\n    const x = Math.min(pointerX + 14, window.innerWidth - rect.width - margin);\n    const y = Math.min(pointerY + 14, window.innerHeight - rect.height - margin);\n    tooltip.style.setProperty(\"--tooltip-x\", Math.max(margin, x) + \"px\");\n    tooltip.style.setProperty(\"--tooltip-y\", Math.max(margin, y) + \"px\");\n  }\n\n  function showTooltip(bar, event) {\n    const category = document.createElement(\"div\");\n    category.className = \"tooltip-category\";\n    category.textContent = bar.dataset.category || \"\";\n\n    const row = document.createElement(\"div\");\n    row.className = \"tooltip-row\";\n\n    const model = document.createElement(\"span\");\n    model.className = \"tooltip-model\";\n\n    const swatch = document.createElement(\"span\");\n    swatch.className = \"tooltip-swatch\";\n    swatch.style.background = bar.dataset.color || \"#94A3B8\";\n\n    const modelText = document.createTextNode(bar.dataset.model || \"\");\n    model.append(swatch, modelText);\n\n    const value = document.createElement(\"span\");\n    value.className = \"tooltip-value\";\n    value.textContent = bar.dataset.value || \"\";\n\n    row.append(model, value);\n    tooltip.replaceChildren(category, row);\n    tooltip.classList.add(\"visible\");\n    tooltip.setAttribute(\"aria-hidden\", \"false\");\n    positionTooltip(event, bar);\n  }\n\n  function hideTooltip() {\n    tooltip.classList.remove(\"visible\");\n    tooltip.setAttribute(\"aria-hidden\", \"true\");\n  }\n\n  function clearActive() {\n    document.querySelectorAll(\"svg.has-active, .capability-table.has-active\").forEach((container) =\u003e container.classList.remove(\"has-active\"));\n    document.querySelectorAll(\".bar-segment.is-active, .capability-cell.is-active, .legend-filter.is-active\").forEach((target) =\u003e {\n      target.classList.remove(\"is-active\");\n      target.setAttribute(\"aria-pressed\", \"false\");\n    });\n    activeTarget = null;\n    hideTooltip();\n  }\n\n  function setActive(target, event) {\n    clearActive();\n    activeTarget = target;\n    target.classList.add(\"is-active\");\n    target.setAttribute(\"aria-pressed\", \"true\");\n    target.closest(\"svg, .capability-table\")?.classList.add(\"has-active\");\n    showTooltip(target, event);\n  }\n\n  function setLegendActive(filter, event) {\n    clearActive();\n    activeTarget = filter;\n    filter.classList.add(\"is-active\");\n    filter.setAttribute(\"aria-pressed\", \"true\");\n\n    let matches = [];\n    if (filter.dataset.scope === \"capability\") {\n      const table = document.getElementById(\"stacked-capability-table\");\n      table?.classList.add(\"has-active\");\n      matches = Array.from(table?.querySelectorAll(\".capability-cell\") || [])\n        .filter((cell) =\u003e cell.dataset.value === filter.dataset.filterValue);\n    } else {\n      const chart = document.getElementById(filter.dataset.scope || \"\");\n      const svg = chart?.querySelector(\"svg\");\n      svg?.classList.add(\"has-active\");\n      matches = Array.from(svg?.querySelectorAll(\".bar-segment\") || [])\n        .filter((bar) =\u003e bar.dataset.modelKey === filter.dataset.filterValue);\n    }\n\n    matches.forEach((target) =\u003e {\n      target.classList.add(\"is-active\");\n      target.setAttribute(\"aria-pressed\", \"true\");\n    });\n    showTooltip(filter, event);\n  }\n\n  document.querySelectorAll(\".bar-segment, .capability-cell, .legend-filter\").forEach((target) =\u003e {\n    target.addEventListener(\"pointerenter\", (event) =\u003e {\n      if (!activeTarget) showTooltip(target, event);\n    });\n    target.addEventListener(\"pointermove\", (event) =\u003e {\n      if (!activeTarget || activeTarget === target) positionTooltip(event, target);\n    });\n    target.addEventListener(\"pointerleave\", () =\u003e {\n      if (!activeTarget) hideTooltip();\n    });\n    target.addEventListener(\"click\", (event) =\u003e {\n      event.stopPropagation();\n      if (activeTarget === target) clearActive();\n      else if (target.classList.contains(\"legend-filter\")) setLegendActive(target, event);\n      else setActive(target, event);\n    });\n    target.addEventListener(\"keydown\", (event) =\u003e {\n      if (event.key === \"Enter\" || event.key === \" \") {\n        event.preventDefault();\n        if (activeTarget === target) clearActive();\n        else if (target.classList.contains(\"legend-filter\")) setLegendActive(target, event);\n        else setActive(target, event);\n      }\n      if (event.key === \"Escape\") clearActive();\n    });\n  });\n\n  document.addEventListener(\"click\", clearActive);\n  document.addEventListener(\"keydown\", (event) =\u003e {\n    if (event.key === \"Escape\") clearActive();\n  });\n  window.addEventListener(\"blur\", clearActive);\n}\n\ninstallStackedChartInteractions();\n\u003c/script\u003e\n\u003c/body\u003e\n\u003c/html\u003e"])</script><script>self.__next_f.push([1,"6d:[\"$\",\"$L73\",\"7b0a640eb90a\",{\"html\":\"$74\",\"title\":\"Orion-2 stacked capability and accuracy\",\"height\":1180,\"caption\":\"$undefined\",\"framed\":false}]\n6e:[\"$\",\"h2\",\"h2-141\",{\"id\":\"get-started\",\"className\":\"mt-10 mb-1 scroll-mt-28 font-sans text-blog-h2 font-semibold text-primary-mid\",\"children\":[\"Get started\"]}]\n6f:[\"$\",\"p\",\"0649716a32b7\",{\"className\":\"my-5 text-blog-body text-blog-article\",\"children\":[\"Try Orion 2 now at \",[\"$\",\"a\",\"055fb33d2ae9\",{\"href\":\"https://chat.vlm.run/\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"className\":\"text-navy underline decoration-primary/30 underline-offset-[3px] transition-colors hover:text-primary\",\"children\":[\"chat.vlm.run\"]}],\". Bring your own favorite images, documents, or videos and inspect the programs it writes. When you're ready to build, the same agent is available through the VLM Run Chat Completions API, and our team can help you evaluate it on your production workloads.\"]}]\n"])</script></body></html>