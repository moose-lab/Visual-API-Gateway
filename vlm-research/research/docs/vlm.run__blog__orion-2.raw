x-1">Book a Demo</a><a href="https://app.vlm.run/sign-in" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-1.5 cursor-pointer transition-[transform,box-shadow,background-color,opacity] duration-300 ease-out hover:opacity-90 hover:-translate-y-px no-underline font-medium bg-primary-dark text-white rounded-[20px] border border-primary-border shadow-btn text-label px-3 py-2 flex-1">Dashboard<svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M5.5 3.5L9 7l-3.5 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg></a></div></div></header><div class="h-[68px]" aria-hidden="true"></div><main class="relative"><script type="application/ld+json">{"@context":"https://schema.org","@type":"Article","headline":"Orion 2: Frontier Visual Agents with Code Execution","description":"Orion 2, our most capable visual agent, writes and executes vision programs on the fly – faster, cheaper, more reliable.","url":"https://vlm.run/blog/orion-2","datePublished":"2026-06-11T00:00:00.000Z","author":[{"@type":"Person","name":"Dinesh Reddy"},{"@type":"Person","name":"Jeremy Park"},{"@type":"Person","name":"Sudeep Pillai"}],"publisher":{"@id":"https://vlm.run/#organization"},"mainEntityOfPage":"https://vlm.run/blog/orion-2"}</script><header class="border-b border-border bg-surface"><div class="w-full px-0 pt-12 lg:pt-14 pb-0"><div class="flex w-full flex-col items-center"><h1 class="max-w-[23rem] px-6 text-balance text-center font-serif text-[30px] leading-[1.08] tracking-[-0.025em] text-navy antialiased sm:max-w-2xl sm:text-heading-lg lg:max-w-none lg:px-0 lg:leading-[110%] lg:tracking-[-0.02em]">Orion 2: Frontier Visual Agents with Code Execution</h1><time dateTime="2026-06-11T00:00:00.000Z" class="mt-5 block hyphens-manual text-center font-sans text-body-lg font-medium leading-[140%] antialiased" style="color:var(--blog-meta)">Jun 11, 2026</time><div class="mt-10 flex min-h-16 w-full flex-wrap items-center justify-center gap-x-[10px] gap-y-[10px] border-t border-border px-6 py-[10px] sm:px-0" aria-label="Authors"><div class="flex items-center gap-2.5 shrink-0"><div class="flex-shrink-0 overflow-hidden bg-primary-tint rounded-md" style="width:32px;height:32px"><img alt="Dinesh Reddy" loading="lazy" width="32" height="32" decoding="async" data-nimg="1" class="w-full h-full object-cover" style="color:transparent" srcSet="/_next/image?url=https%3A%2F%2Fframerusercontent.com%2Fimages%2FOJiLOdPP754buiT6MpeoHyBQ.jpeg%3Fwidth%3D200%26height%3D200&amp;w=32&amp;q=75 1x, /_next/image?url=https%3A%2F%2Fframerusercontent.com%2Fimages%2FOJiLOdPP754buiT6MpeoHyBQ.jpeg%3Fwidth%3D200%26height%3D200&amp;w=64&amp;q=75 2x" src="/_next/image?url=https%3A%2F%2Fframerusercontent.com%2Fimages%2FOJiLOdPP754buiT6MpeoHyBQ.jpeg%3Fwidth%3D200%26height%3D200&amp;w=64&amp;q=75"/></div><div class="flex flex-col"><span class="text-body-md font-medium leading-[140%] opacity-80 [color:var(--blog-meta)]">Dinesh Reddy</span></div></div><div class="flex items-center gap-2.5 shrink-0"><div class="flex-shrink-0 overflow-hidden bg-primary-tint rounded-md" style="width:32px;height:32px"><img alt="Jeremy Park" loading="lazy" width="32" height="32" decoding="async" data-nimg="1" class="w-full h-full object-cover" style="color:transparent" srcSet="/_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2F12pgkx8l%2Fproduction%2Fe30f3b16c7f30157bc5dc99a061d86763750bfdd-192x192.jpg&amp;w=32&amp;q=75 1x, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2F12pgkx8l%2Fproduction%2Fe30f3b16c7f30157bc5dc99a061d86763750bfdd-192x192.jpg&amp;w=64&amp;q=75 2x" src="/_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2F12pgkx8l%2Fproduction%2Fe30f3b16c7f30157bc5dc99a061d86763750bfdd-192x192.jpg&amp;w=64&amp;q=75"/></div><div class="flex flex-col"><span class="text-body-md font-medium leading-[140%] opacity-80 [color:var(--blog-meta)]">Jeremy Park</span></div></div><div class="flex items-center gap-2.5 shrink-0"><div class="flex-shrink-0 overflow-hidden bg-primary-tint rounded-md" style="width:32px;height:32px"><img alt="Sudeep Pillai" loading="lazy" width="32" height="32" decoding="async" data-nimg="1" class="w-full h-full object-cover" style="color:transparent" srcSet="/_next/image?url=https%3A%2F%2Fframerusercontent.com%2Fimages%2Fl2iTMxJuCMUp4vTlGYn8s3esQ.png%3Fwidth%3D512%26height%3D512&amp;w=32&amp;q=75 1x, /_next/image?url=https%3A%2F%2Fframerusercontent.com%2Fimages%2Fl2iTMxJuCMUp4vTlGYn8s3esQ.png%3Fwidth%3D512%26height%3D512&amp;w=64&amp;q=75 2x" src="/_next/image?url=https%3A%2F%2Fframerusercontent.com%2Fimages%2Fl2iTMxJuCMUp4vTlGYn8s3esQ.png%3Fwidth%3D512%26height%3D512&amp;w=64&amp;q=75"/></div><div class="flex flex-col"><span class="text-body-md font-medium leading-[140%] opacity-80 [color:var(--blog-meta)]">Sudeep Pillai</span></div></div></div></div></div></header><div class="overflow-x-clip bg-body py-14 lg:py-16"><div class="mx-auto max-w-[1168px] px-6 lg:px-8"><div class="flex flex-col gap-10 lg:grid lg:grid-cols-[200px_minmax(0,1fr)] lg:items-start lg:gap-10"><aside class="hidden w-full self-start text-left lg:sticky lg:top-28 lg:block lg:overflow-hidden lg:border-r lg:pr-4"><nav id="table-of-contents" aria-label="Table of contents" class="hidden w-full scroll-mt-28 flex-col items-stretch gap-2.5 text-left lg:flex"><p class="w-full text-left text-body-sm font-semibold uppercase leading-4 tracking-[0.03em] text-primary-mid">Table of contents</p><ul class="flex w-full list-none flex-col gap-2.5 p-0 text-left"><li class="w-full text-left"><a href="#visual-intelligence-now-with-code-mode" class="block w-full max-w-full overflow-hidden break-words text-left text-label leading-[1.5] transition-colors font-normal text-black/50 hover:text-black/70">Visual Intelligence, now with Code-Mode</a></li><li class="w-full text-left"><a href="#architecture-code-as-the-agent-harness" class="block w-full max-w-full overflow-hidden break-words text-left text-label leading-[1.5] transition-colors font-normal text-black/50 hover:text-black/70">Architecture: Code as the Agent Harness</a></li><li class="w-full text-left"><a href="#orion-1-vs-orion-2" class="block w-full max-w-full overflow-hidden break-words text-left text-label leading-[1.5] transition-colors font-normal text-black/50 hover:text-black/70">Orion 1 vs. Orion 2</a></li><li class="w-full text-left pl-6"><a href="#orion-1-sequential-tool-call-illustration" class="block w-full max-w-full overflow-hidden break-words text-left text-label leading-[1.5] transition-colors font-normal text-black/50 hover:text-black/70">Orion 1: Sequential Tool-Call Illustration</a></li><li class="w-full text-left pl-6"><a href="#orion-2-efficient-code-mode-execution" class="block w-full max-w-full overflow-hidden break-words text-left text-label leading-[1.5] transition-colors font-normal text-black/50 hover:text-black/70">Orion 2: Efficient Code-Mode Execution</a></li><li class="w-full text-left"><a href="#under-the-hood-model-agnostic-purpose-built-runtime" class="block w-full max-w-full overflow-hidden break-words text-left text-label leading-[1.5] transition-colors font-normal text-black/50 hover:text-black/70">Under the Hood: Model-Agnostic, Purpose-Built Runtime</a></li><li class="w-full text-left"><a href="#examples" class="block w-full max-w-full overflow-hidden break-words text-left text-label leading-[1.5] transition-colors font-normal text-black/50 hover:text-black/70">Examples</a></li><li class="w-full text-left pl-3"><a href="#virtual-try-on" class="block w-full max-w-full overflow-hidden break-words text-left text-label leading-[1.5] transition-colors font-normal text-black/50 hover:text-black/70">Virtual try-on</a></li><li class="w-full text-left pl-3"><a href="#robotics-physical-ai" class="block w-full max-w-full overflow-hidden break-words text-left text-label leading-[1.5] transition-colors font-normal text-black/50 hover:text-black/70">Robotics &amp; Physical AI</a></li><li class="w-full text-left pl-3"><a href="#multi-document-workflow" class="block w-full max-w-full overflow-hidden break-words text-left text-label leading-[1.5] transition-colors font-normal text-black/50 hover:text-black/70">Multi-document workflow</a></li><li class="w-full text-left pl-3"><a href="#manipulating-images" class="block w-full max-w-full overflow-hidden break-words text-left text-label leading-[1.5] transition-colors font-normal text-black/50 hover:text-black/70">Manipulating Images</a></li><li class="w-full text-left"><a href="#benchmarks" class="block w-full max-w-full overflow-hidden break-words text-left text-label leading-[1.5] transition-colors font-normal text-black/50 hover:text-black/70">Benchmarks</a></li><li class="w-full text-left"><a href="#get-started" class="block w-full max-w-full overflow-hidden break-words text-left text-label leading-[1.5] transition-colors font-normal text-black/50 hover:text-black/70">Get started</a></li></ul></nav></aside><div class="min-w-0 lg:max-w-3xl lg:justify-self-center"><div class="mb-10 lg:mb-12"><div class="w-full bg-white p-3"><div class="aspect-[16/9] w-full overflow-hidden"><img alt="Introducing Orion 2, our most capable visual agent. It writes and executes vision programs on the fly: faster, cheaper, more reliable." width="1200" height="675" decoding="async" data-nimg="1" class="h-full w-full object-cover" style="color:transparent" srcSet="/_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2F12pgkx8l%2Fproduction%2Fa032668facaddc17f9d0bba0f31b6f721c737dff-2400x1350.png&amp;w=1200&amp;q=75 1x, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2F12pgkx8l%2Fproduction%2Fa032668facaddc17f9d0bba0f31b6f721c737dff-2400x1350.png&amp;w=3840&amp;q=75 2x" src="/_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2F12pgkx8l%2Fproduction%2Fa032668facaddc17f9d0bba0f31b6f721c737dff-2400x1350.png&amp;w=3840&amp;q=75"/></div></div></div><div class="blog-article prose-none max-w-none [&amp;&gt;*:first-child]:mt-0"><p class="my-5 text-blog-body text-blog-article">We are excited to announce <strong class="font-bold text-inherit">Orion 2</strong>: our most capable visual agent, now with code execution. Since our Orion 1 launch in November last year, our customers have run hundreds of thousands of requests spanning millions of tool-calls in production every month. Serving at this scale taught us that the bottleneck in production visual agents isn&#x27;t just accurate perception – it&#x27;s reliable orchestration.</p><p class="my-5 text-blog-body text-blog-article">Orion 2 generates and executes computer-vision code on the fly, expanding capabilities well beyond Orion 1 while being <strong class="font-bold text-inherit">significantly faster</strong>, <strong class="font-bold text-inherit">cheaper</strong>, and <strong class="font-bold text-inherit">more reliable</strong>. Try it now at <a href="https://chat.vlm.run/" target="_blank" rel="noopener noreferrer" class="text-navy underline decoration-primary/30 underline-offset-[3px] transition-colors hover:text-primary">chat.vlm.run</a>, every example in this post is a live chat thread you can inspect and re-run.</p><h2 id="visual-intelligence-now-with-code-mode" class="mt-10 mb-1 scroll-mt-28 font-sans text-blog-h2 font-semibold text-primary-mid">Visual Intelligence, now with Code-Mode</h2><p class="my-5 text-blog-body text-blog-article">Complex computer vision tasks are inherently compositional: detect, crop, draw, measure, reason. Most vision agents are restricted to a predefined tool surface and a sequential tool-calling loop. With Orion 2, we combine deterministic tool-calling with dynamic code generation – the best of both worlds.</p><p class="my-5 text-blog-body text-blog-article">Code as the orchestration substrate (aka <a href="https://blog.cloudflare.com/code-mode/" target="_blank" rel="noopener noreferrer" class="text-navy underline decoration-primary/30 underline-offset-[3px] transition-colors hover:text-primary">code-mode</a>) has several properties that matter in production:</p><ul class="my-5 list-outside list-disc space-y-1.5 pl-5 text-blog-body text-blog-article marker:text-primary-mid/80"><li class="pl-0.5"><strong class="font-bold text-inherit">Reusable</strong>: generated programs are artifacts; scripts can be saved, versioned, and re-run on new inputs without re-invoking the LLM agent.</li><li class="pl-0.5"><strong class="font-bold text-inherit">Inspectable</strong>: the executed code is something you can read, debug, diff, and verify; critical for our customers in regulated industries.</li><li class="pl-0.5"><strong class="font-bold text-inherit">Composable</strong>: loops, conditionals, fan-out, and parallel tool calls live in a single program instead of N model round-trips.</li><li class="pl-0.5"><strong class="font-bold text-inherit">Deterministic</strong>: computation (counting, measuring, normalizing, geometry) runs in code, not in the model&#x27;s head; eliminating an entire class of numeric hallucinations.</li></ul><p class="my-5 text-blog-body text-blog-article"></p><h2 id="architecture-code-as-the-agent-harness" class="mt-10 mb-1 scroll-mt-28 font-sans text-blog-h2 font-semibold text-primary-mid">Architecture: Code as the Agent Harness</h2><p class="my-5 text-blog-body text-blog-article">Orion 2 is a <strong class="font-bold text-inherit">visual agent harness</strong>: a planner and a code runtime wrapped around a vision-language model. At its core is a custom <strong class="font-bold text-inherit">visual DSL and runtime</strong> we built to expose every tool we introduced with Orion 1 – detection, OCR, segmentation, cropping, image generation, and more – as native primitives the model can compose in code. Most notably, the entire Orion 1 tool surface is now fully programmable and deterministic. </p><figure class="my-8"><div class="rounded-xl overflow-hidden border border-border"><img alt="Architecture diagram of Orion 2. Four input types on the left (text, image, video, and document) flow into the Orion 2 agent. Inside, the model issues tool calls to three subsystems: Visual Tools &amp; Runtime, Code Gen &amp; Execution, and Visual Skills. Outputs on the right span five capability classes: Describe, Tag, Detect, Generate, and Act." loading="lazy" width="900" height="506" decoding="async" data-nimg="1" class="w-full h-auto" style="color:transparent" srcSet="/_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2F12pgkx8l%2Fproduction%2F2dd998a99a19b959238dcbed742c0d5cca6fd3a5-2336x912.png&amp;w=1080&amp;q=75 1x, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2F12pgkx8l%2Fproduction%2F2dd998a99a19b959238dcbed742c0d5cca6fd3a5-2336x912.png&amp;w=1920&amp;q=75 2x" src="/_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2F12pgkx8l%2Fproduction%2F2dd998a99a19b959238dcbed742c0d5cca6fd3a5-2336x912.png&amp;w=1920&amp;q=75"/></div><figcaption class="mt-2 text-center text-body-sm text-muted">Orion 2 accepts text, images, video, and documents, compiles each request into an executable program, and dispatches visual tools, code execution, and learned skills from a single harness.</figcaption></figure><p class="my-5 text-blog-body text-blog-article"></p><p class="my-5 text-blog-body text-blog-article">Here is how a new request is handled in Orion 2: </p><ol class="my-5 list-decimal list-outside space-y-1.5 pl-5 text-blog-body text-blog-article"><li class="pl-0.5"><strong class="font-bold text-inherit">Prompt → Spec:</strong> An ambiguous request is compiled into an exact, executable program – written in our visual DSL, which reads like idiomatic Python.</li><li class="pl-0.5"><strong class="font-bold text-inherit">Execution:</strong> The program runs in a sandboxed runtime with async-native parallelism: independent operations dispatch concurrently via asyncio, with no per-step model round-trips. The runtime ships with OpenCV for classical computer vision and the <code class="rounded-md bg-primary/10 px-1.5 py-0.5 font-mono text-code text-primary">vlmrun</code> package, which exposes the full Orion tool surface – detection, OCR, segmentation, image generation – as importable primitives.</li><li class="pl-0.5"><strong class="font-bold text-inherit">Self-correction: </strong>Execution results return to the harness, which repairs and re-executes until the program runs to completion. Each turn also yields a (program, trace, outcome) record – fully verifiable supervision for our continual-learning flywheel.</li></ol><p class="my-5 text-blog-body text-blog-article">That record is also the groundwork for what comes next: close the loop with a visual judge, a harness that can score its own outputs, prefer better programs over worse ones, and improve recursively with every workload it serves. More on that soon.</p><h2 id="orion-1-vs-orion-2" class="mt-10 mb-1 scroll-mt-28 font-sans text-blog-h2 font-semibold text-primary-mid">Orion 1 vs. Orion 2</h2><p class="my-5 text-blog-body text-blog-article">The difference is easiest to see on a concrete task: the virtual try-on from the examples below, which composes detection, cropping, and image generation across two input images.</p><p class="my-5 text-blog-body text-blog-article">Orion 1&#x27;s orchestration is lazy and interactive: one tool call, one LLM round-trip, repeat. Five visual operations means five round-trips, and every intermediate result (bounding boxes included) passes through the model&#x27;s context before the next step:</p><h4 id="orion-1-sequential-tool-call-illustration" class="mb-1 mt-6 scroll-mt-28 font-sans text-blog-h4 font-normal text-primary-mid">Orion 1: Sequential Tool-Call Illustration</h4><figure class="my-6 overflow-hidden rounded-xl border border-border bg-white"><div class="blog-code-shiki overflow-x-auto"><pre class="shiki github-light" style="background-color:#fff;color:#24292e" tabindex="0"><code><span class="line"><span style="color:#6A737D"># Tools are called sequentially, with LLM reasoning at each step</span></span>
<span class="line"><span style="color:#24292E">boxes      </span><span style="color:#D73A49">=</span><span style="color:#24292E"> tool_call(</span><span style="color:#032F62">"detect"</span><span style="color:#24292E">, image, </span><span style="color:#E36209">target</span><span style="color:#D73A49">=</span><span style="color:#032F62">"person"</span><span style="color:#24292E">)                  </span><span style="color:#6A737D"># call 1</span></span>
<span class="line"><span style="color:#24292E">person     </span><span style="color:#D73A49">=</span><span style="color:#24292E"> tool_call(</span><span style="color:#032F62">"crop"</span><span style="color:#24292E">, image, </span><span style="color:#E36209">xywh</span><span style="color:#D73A49">=</span><span style="color:#24292E">[</span><span style="color:#005CC5">0.22</span><span style="color:#24292E">, </span><span style="color:#005CC5">0.35</span><span style="color:#24292E">, </span><span style="color:#005CC5">0.04</span><span style="color:#24292E">, </span><span style="color:#005CC5">0.15</span><span style="color:#24292E">])      </span><span style="color:#6A737D"># call 2</span></span>
<span class="line"><span style="color:#24292E">garment    </span><span style="color:#D73A49">=</span><span style="color:#24292E"> tool_call(</span><span style="color:#032F62">"detect"</span><span style="color:#24292E">, dress_img, </span><span style="color:#E36209">target</span><span style="color:#D73A49">=</span><span style="color:#032F62">"garment"</span><span style="color:#24292E">)             </span><span style="color:#6A737D"># call 3</span></span>
<span class="line"><span style="color:#24292E">garment    </span><span style="color:#D73A49">=</span><span style="color:#24292E"> tool_call(</span><span style="color:#032F62">"crop"</span><span style="color:#24292E">, dress_img, </span><span style="color:#E36209">xywh</span><span style="color:#D73A49">=</span><span style="color:#24292E">[</span><span style="color:#005CC5">0.33</span><span style="color:#24292E">, </span><span style="color:#005CC5">0.41</span><span style="color:#24292E">, </span><span style="color:#005CC5">0.05</span><span style="color:#24292E">, </span><span style="color:#005CC5">0.13</span><span style="color:#24292E">])  </span><span style="color:#6A737D"># call 4</span></span>
<span class="line"><span style="color:#24292E">result     </span><span style="color:#D73A49">=</span><span style="color:#24292E"> tool_call(</span><span style="color:#032F62">"generate"</span><span style="color:#24292E">, person, garment)                       </span><span style="color:#6A737D"># call 5</span></span>
<span class="line"><span style="color:#6A737D"># ...the model parses every intermediate output before deciding the next tool.</span></span></code></pre></div></figure><p class="my-5 text-blog-body text-blog-article">Notice the coordinates in calls 2 and 4: the LLM reads them out of the detection results and calls them into the next tool call. Every hop like that costs a round-trip of latency and is a chance to transcribe something wrong.</p><h4 id="orion-2-efficient-code-mode-execution" class="mb-1 mt-6 scroll-mt-28 font-sans text-blog-h4 font-normal text-primary-mid">Orion 2: Efficient Code-Mode Execution</h4><p class="my-5 text-blog-body text-blog-article">Orion 2&#x27;s orchestration is code. The model writes one program up front; intermediate results flow through variables instead of the model&#x27;s context, independent operations run in parallel, and the whole workflow executes end-to-end before returning:</p><figure class="my-6 overflow-hidden rounded-xl border border-border bg-white"><div class="blog-code-shiki overflow-x-auto"><pre class="shiki github-light" style="background-color:#fff;color:#24292e" tabindex="0"><code><span class="line"><span style="color:#6A737D"># Tools can be called efficiently via native async python ops</span></span>
<span class="line"><span style="color:#D73A49">import</span><span style="color:#24292E"> asyncio</span></span>
<span class="line"></span>
<span class="line"><span style="color:#D73A49">async</span><span style="color:#D73A49"> def</span><span style="color:#6F42C1"> process</span><span style="color:#24292E">(ctx, person_image, dress_img):</span></span>
<span class="line"><span style="color:#24292E">    vlmrun </span><span style="color:#D73A49">=</span><span style="color:#24292E"> ctx.import_lib(</span><span style="color:#032F62">"vlmrun"</span><span style="color:#24292E">)</span></span>
<span class="line"><span style="color:#24292E">    </span></span>
<span class="line"><span style="color:#D73A49">    def</span><span style="color:#6F42C1"> crop</span><span style="color:#24292E">(img, d):</span></span>
<span class="line"><span style="color:#24292E">        bx, by, bw, bh </span><span style="color:#D73A49">=</span><span style="color:#24292E"> d[</span><span style="color:#032F62">"xywh"</span><span style="color:#24292E">]; W, H </span><span style="color:#D73A49">=</span><span style="color:#24292E"> img.width, img.height</span></span>
<span class="line"><span style="color:#D73A49">        return</span><span style="color:#24292E"> img.crop(</span><span style="color:#005CC5">int</span><span style="color:#24292E">(by </span><span style="color:#D73A49">*</span><span style="color:#24292E"> H), </span><span style="color:#005CC5">int</span><span style="color:#24292E">((by </span><span style="color:#D73A49">+</span><span style="color:#24292E"> bh) </span><span style="color:#D73A49">*</span><span style="color:#24292E"> H), </span><span style="color:#005CC5">int</span><span style="color:#24292E">(bx </span><span style="color:#D73A49">*</span><span style="color:#24292E"> W), </span><span style="color:#005CC5">int</span><span style="color:#24292E">((bx </span><span style="color:#D73A49">+</span><span style="color:#24292E"> bw) </span><span style="color:#D73A49">*</span><span style="color:#24292E"> W))</span></span>
<span class="line"><span style="color:#24292E">    </span></span>
<span class="line"><span style="color:#6A737D">    # Detect person and garment in parallel, take top crop of each</span></span>
<span class="line"><span style="color:#24292E">    p_det, g_det </span><span style="color:#D73A49">=</span><span style="color:#D73A49"> await</span><span style="color:#24292E"> asyncio.gather(</span></span>
<span class="line"><span style="color:#24292E">        vlmrun.image.detect(person_image, </span><span style="color:#032F62">"person"</span><span style="color:#24292E">),</span></span>
<span class="line"><span style="color:#24292E">        vlmrun.image.detect(dress_img, </span><span style="color:#032F62">"garment"</span><span style="color:#24292E">),</span></span>
<span class="line"><span style="color:#24292E">    )</span></span>
<span class="line"><span style="color:#24292E">    person_crop </span><span style="color:#D73A49">=</span><span style="color:#24292E"> crop(person_image, p_det[</span><span style="color:#032F62">"detections"</span><span style="color:#24292E">][</span><span style="color:#005CC5">0</span><span style="color:#24292E">])</span></span>
<span class="line"><span style="color:#24292E">    garment_crop </span><span style="color:#D73A49">=</span><span style="color:#24292E"> crop(dress_img, g_det[</span><span style="color:#032F62">"detections"</span><span style="color:#24292E">][</span><span style="color:#005CC5">0</span><span style="color:#24292E">])</span></span>
<span class="line"></span>
<span class="line"><span style="color:#6A737D">    # Composite the try-on and return the composite image</span></span>
<span class="line"><span style="color:#24292E">    (composite,) </span><span style="color:#D73A49">=</span><span style="color:#D73A49"> await</span><span style="color:#24292E"> vlmrun.image.generate(</span></span>
<span class="line"><span style="color:#032F62">        "virtual try-on"</span><span style="color:#24292E">, </span><span style="color:#E36209">images</span><span style="color:#D73A49">=</span><span style="color:#24292E">[person_crop, garment_crop]</span></span>
<span class="line"><span style="color:#24292E">    )</span></span>
<span class="line"><span style="color:#D73A49">    return</span><span style="color:#24292E"> {</span><span style="color:#032F62">"composite"</span><span style="color:#24292E">: composite}</span></span></code></pre></div></figure><p class="my-5 text-blog-body text-blog-article">When orchestration is code, verifiable correctness and determinism is a property of the program, even if a statistical model generated it. </p><p class="my-5 text-blog-body text-blog-article"></p><h2 id="under-the-hood-model-agnostic-purpose-built-runtime" class="mt-10 mb-1 scroll-mt-28 font-sans text-blog-h2 font-semibold text-primary-mid">Under the Hood: Model-Agnostic, Purpose-Built Runtime</h2><p class="my-5 text-blog-body text-blog-article">Orion 2 is a visual agent harness, not a model. Any multimodal model with strong code generation can drive the planner → execution → self-correction loop: open-weight VLMs like <a href="https://huggingface.co/google/gemma-4-26B-A4B" target="_blank" rel="noopener noreferrer" class="text-navy underline decoration-primary/30 underline-offset-[3px] transition-colors hover:text-primary">Gemma4-26B-A4B</a> and <a href="https://huggingface.co/Qwen/Qwen3.6-35B-A3B" target="_blank" rel="noopener noreferrer" class="text-navy underline decoration-primary/30 underline-offset-[3px] transition-colors hover:text-primary">Qwen3.6-35B-A3B</a>, or frontier models like <a href="https://blog.google/innovation-and-ai/models-and-research/gemini-models/gemini-3-5/" target="_blank" rel="noopener noreferrer" class="text-navy underline decoration-primary/30 underline-offset-[3px] transition-colors hover:text-primary">Gemini 3.5 Flash</a>. Same harness, same runtime, different engine.</p><p class="my-5 text-blog-body text-blog-article">The benchmark below runs all three backbones through the identical harness. Each brings different strengths – Gemma4 leads on localization, Gemini 3.5 Flash on segmentation and video – and Orion 2 inherits every improvement in vision-grounded code generation, open or closed, for free.</p><p class="my-5 text-blog-body text-blog-article">The default, <code class="rounded-md bg-primary/10 px-1.5 py-0.5 font-mono text-code text-primary">vlmrun-orion-2:auto</code>, routes each request to the best backbone for the job, so you get the frontier of all three without choosing. Open-weight backbones run on our purpose-built inference runtime: favorable GPU economics at volume, deployable in isolated cloud environments. Pin a fixed backbone through the gateway when compliance or reproducibility demands it.</p><p class="my-5 text-blog-body text-blog-article"></p><h2 id="examples" class="mt-10 mb-1 scroll-mt-28 font-sans text-blog-h2 font-semibold text-primary-mid">Examples</h2><p class="my-5 text-blog-body text-blog-article">See Orion 2 in action in the following chat thread examples and inspect the artifacts.</p><h3 id="virtual-try-on" class="mb-1 mt-8 scroll-mt-28 font-sans text-blog-h3 font-normal text-primary-mid">Virtual try-on</h3><p class="my-5 text-blog-body text-blog-article">Given an image of a dress and an image of a model, Orion 2 creates a realistic virtual try-on in a single turn. It detects the person and the garment in parallel, crops each subject in-process, generates the composite with one image-generation call, and asks a vision-LLM whether the fit looks natural – composing four distinct visual operations as a single program, with the intermediate crops, composite, and verdict all available as inspectable artifacts. See <a href="https://chat.vlm.run/c/588e485e-7e47-4742-b77c-68bbe1623474" target="_blank" rel="noopener noreferrer" class="text-navy underline decoration-primary/30 underline-offset-[3px] transition-colors hover:text-primary">chat</a>. <br/></p><figure class="my-8"><div class="group relative"><div class="pointer-events-none absolute inset-0 z-10 flex items-center justify-center bg-navy-dark/40 opacity-0 backdrop-blur-[1px] transition-opacity duration-200 rounded-[24px] [@media(hover:hover)]:group-hover:pointer-events-auto [@media(hover:hover)]:group-hover:opacity-100 [@media(hover:hover)]:group-focus-within:pointer-events-auto [@media(hover:hover)]:group-focus-within:opacity-100"><button type="button" class="inline-flex items-center justify-center rounded-full bg-primary-mid font-medium text-white shadow-btn transition-[background-color,transform] focus:outline-none focus:ring-2 focus:ring-primary/30 px-4 py-2.5 text-body-md hover:-translate-y-px hover:bg-primary-hover" aria-haspopup="dialog" aria-controls="_R_13kmlubsnq5iulb_" aria-expanded="false">Expand chat preview</button></div><div class="pointer-events-none absolute inset-x-0 bottom-0 z-10 hidden justify-center px-4 pb-3 [@media(hover:none)]:flex"><button type="button" class="inline-flex items-center justify-center rounded-full bg-primary-mid font-medium text-white shadow-btn transition-[background-color,transform] focus:outline-none focus:ring-2 focus:ring-primary/30 pointer-events-auto px-3 py-1.5 text-body-sm" aria-haspopup="dialog" aria-controls="_R_13kmlubsnq5iulb_" aria-expanded="false">Expand chat</button></div><div class="h-[390px] sm:h-[465px]"><div class="absolute inset-0 overflow-hidden border border-border bg-white outline-none rounded-[24px]" aria-hidden="false"><div class="flex h-full w-full items-center justify-center bg-white"><span class="animate-pulse text-body-sm text-muted">Loading chat preview…</span></div></div></div></div><figcaption class="mx-auto mt-3 max-w-2xl text-center text-body-sm text-muted">One pipeline, multiple visual operations, parallelized — the cleanest illustration of code-mode speed.</figcaption></figure><h3 id="robotics-physical-ai" class="mb-1 mt-8 scroll-mt-28 font-sans text-blog-h3 font-normal text-primary-mid">Robotics &amp; Physical AI</h3><p class="my-5 text-blog-body text-blog-article">Orion 2 extracts a representative frame from a robotics video, segments every object in the scene in parallel, and hands off the per-object masks to generate an interactive 3D reconstruction. The frame sampling, fan-out segmentation, and 3D-reconstruction handoff all live in a single program, so the intermediate frame, masks, and reconstruction are produced together in one turn and available as inspectable artifacts. See <a href="https://chat.vlm.run/c/e2ea96a4-4175-43c3-a0cf-d2d6e40ebac9" target="_blank" rel="noopener noreferrer" class="text-navy underline decoration-primary/30 underline-offset-[3px] transition-colors hover:text-primary">chat</a>.<br/></p><figure class="my-8"><div class="group relative"><div class="pointer-events-none absolute inset-0 z-10 flex items-center justify-center bg-navy-dark/40 opacity-0 backdrop-blur-[1px] transition-opacity duration-200 rounded-[24px] [@media(hover:hover)]:group-hover:pointer-events-auto [@media(hover:hover)]:group-hover:opacity-100 [@media(hover:hover)]:group-focus-within:pointer-events-auto [@media(hover:hover)]:group-focus-within:opacity-100"><button type="button" class="inline-flex items-center justify-center rounded-full bg-primary-mid font-medium text-white shadow-btn transition-[background-color,transform] focus:outline-none focus:ring-2 focus:ring-primary/30 px-4 py-2.5 text-body-md hover:-translate-y-px hover:bg-primary-hover" aria-haspopup="dialog" aria-controls="_R_16kmlubsnq5iulb_" aria-expanded="false">Expand chat preview</button></div><div class="pointer-events-none absolute inset-x-0 bottom-0 z-10 hidden justify-center px-4 pb-3 [@media(hover:none)]:flex"><button type="button" class="inline-flex items-center justify-center rounded-full bg-primary-mid font-medium text-white shadow-btn transition-[background-color,transform] focus:outline-none focus:ring-2 focus:ring-primary/30 pointer-events-auto px-3 py-1.5 text-body-sm" aria-haspopup="dialog" aria-controls="_R_16kmlubsnq5iulb_" aria-expanded="false">Expand chat</button></div><div class="h-[390px] sm:h-[465px]"><div class="absolute inset-0 overflow-hidden border border-border bg-white outline-none rounded-[24px]" aria-hidden="false"><div class="flex h-full w-full items-center justify-center bg-white"><span class="animate-pulse text-body-sm text-muted">Loading chat preview…</span></div></div></div></div><figcaption class="mx-auto mt-3 max-w-2xl text-center text-body-sm text-muted">Video transcription, key-point tracking, and motion analytics in one end-to-end program.</figcaption></figure><h3 id="multi-document-workflow" class="mb-1 mt-8 scroll-mt-28 font-sans text-blog-h3 font-normal text-primary-mid">Multi-document workflow</h3><p class="my-5 text-blog-body text-blog-article">Given a multi-page healthcare PDF, Orion 2 splits a batch of healthcare documents into per-page images and classifies each one – claim form, instructions, insurance ID card, medical history, physician referral form etc. It then focuses on the referral form, helping the user localize the patient and physician names, and returns the full structured extraction grounded to the source page – every page split and bounding box available as inspectable artifacts. See <a href="https://chat.vlm.run/c/0194eadb-817b-47b6-9464-0361930b7325" target="_blank" rel="noopener noreferrer" class="text-navy underline decoration-primary/30 underline-offset-[3px] transition-colors hover:text-primary">chat</a>.<br/></p><figure class="my-8"><div class="group relative"><div class="pointer-events-none absolute inset-0 z-10 flex items-center justify-center bg-navy-dark/40 opacity-0 backdrop-blur-[1px] transition-opacity duration-200 rounded-[24px] [@media(hover:hover)]:group-hover:pointer-events-auto [@media(hover:hover)]:group-hover:opacity-100 [@media(hover:hover)]:group-focus-within:pointer-events-auto [@media(hover:hover)]:group-focus-within:opacity-100"><button type="button" class="inline-flex items-center justify-center rounded-full bg-primary-mid font-medium text-white shadow-btn transition-[background-color,transform] focus:outline-none focus:ring-2 focus:ring-primary/30 px-4 py-2.5 text-body-md hover:-translate-y-px hover:bg-primary-hover" aria-haspopup="dialog" aria-controls="_R_19kmlubsnq5iulb_" aria-expanded="false">Expand chat preview</button></div><div class="pointer-events-none absolute inset-x-0 bottom-0 z-10 hidden justify-center px-4 pb-3 [@media(hover:none)]:flex"><button type="button" class="inline-flex items-center justify-center rounded-full bg-primary-mid font-medium text-white shadow-btn transition-[background-color,transform] focus:outline-none focus:ring-2 focus:ring-primary/30 pointer-events-auto px-3 py-1.5 text-body-sm" aria-haspopup="dialog" aria-controls="_R_19kmlubsnq5iulb_" aria-expanded="false">Expand chat</button></div><div class="h-[390px] sm:h-[465px]"><div class="absolute inset-0 overflow-hidden border border-border bg-white outline-none rounded-[24px]" aria-hidden="false"><div class="flex h-full w-full items-center justify-center bg-white"><span class="animate-pulse text-body-sm text-muted">Loading chat preview…</span></div></div></div></div><figcaption class="mx-auto mt-3 max-w-2xl text-center text-body-sm text-muted">Parse, align, and summarize across multiple documents in one reusable pipeline.</figcaption></figure><h3 id="manipulating-images" class="mb-1 mt-8 scroll-mt-28 font-sans text-blog-h3 font-normal text-primary-mid">Manipulating Images</h3><p class="my-5 text-blog-body text-blog-article">Orion 2 manipulates images on-the-fly with native OpenCV – Gaussian blur, Canny edge detection, color pop, and other cv2 compositions are written directly into the script and run in parallel where independent operations can be composed, instead of being constrained to a fixed, pre-defined tool surface. See <a href="https://chat.vlm.run/c/733e38c7-f2e7-4a2b-a9e3-ffc201412cc1" target="_blank" rel="noopener noreferrer" class="text-navy underline decoration-primary/30 underline-offset-[3px] transition-colors hover:text-primary">chat</a>.<br/></p><figure class="my-8"><div class="group relative"><div class="pointer-events-none absolute inset-0 z-10 flex items-center justify-center bg-navy-dark/40 opacity-0 backdrop-blur-[1px] transition-opacity duration-200 rounded-[24px] [@media(hover:hover)]:group-hover:pointer-events-auto [@media(hover:hover)]:group-hover:opacity-100 [@media(hover:hover)]:group-focus-within:pointer-events-auto [@media(hover:hover)]:group-focus-within:opacity-100"><button type="button" class="inline-flex items-center justify-center rounded-full bg-primary-mid font-medium text-white shadow-btn transition-[background-color,transform] focus:outline-none focus:ring-2 focus:ring-primary/30 px-4 py-2.5 text-body-md hover:-translate-y-px hover:bg-primary-hover" aria-haspopup="dialog" aria-controls="_R_1ckmlubsnq5iulb_" aria-expanded="false">Expand chat preview</button></div><div class="pointer-events-none absolute inset-x-0 bottom-0 z-10 hidden justify-center px-4 pb-3 [@media(hover:none)]:flex"><button type="button" class="inline-flex items-center justify-center rounded-full bg-primary-mid font-medium text-white shadow-btn transition-[background-color,transform] focus:outline-none focus:ring-2 focus:ring-primary/30 pointer-events-auto px-3 py-1.5 text-body-sm" aria-haspopup="dialog" aria-controls="_R_1ckmlubsnq5iulb_" aria-expanded="false">Expand chat</button></div><div class="h-[390px] sm:h-[465px]"><div class="absolute inset-0 overflow-hidden border border-border bg-white outline-none rounded-[24px]" aria-hidden="false"><div class="flex h-full w-full items-center justify-center bg-white"><span class="animate-pulse text-body-sm text-muted">Loading chat preview…</span></div></div></div></div><figcaption class="mx-auto mt-3 max-w-2xl text-center text-body-sm text-muted">Detect → tile → count → annotate, with the counting done deterministically in code.</figcaption></figure><h2 id="benchmarks" class="mt-10 mb-1 scroll-mt-28 font-sans text-blog-h2 font-semibold text-primary-mid">Benchmarks</h2><p class="my-5 text-blog-body text-blog-article">When we launched Orion 1, we showcased a <a href="https://storage.googleapis.com/vlm-data-public-prod/web/assets/vlmrun-orion-whitepaper-latest.pdf" target="_blank" rel="noopener noreferrer" class="text-navy underline decoration-primary/30 underline-offset-[3px] transition-colors hover:text-primary">benchmark dataset</a> of 30+ multi-modal, multi-turn tasks involving complex reasoning and agentic actions on images, documents, and videos.</p><p class="my-5 text-blog-body text-blog-article">With Orion 2&#x27;s code-execution capabilities, we expand the benchmark to 250+ multi-turn cases across image, document, audio, video, and multi-file inputs, covering perception, counting, OCR, grounding, and cross-turn reasoning. The hard tier introduces generative tool-use actions – cropping, masking, blurring, redaction, segmentation, keyframe extraction – that exercise Orion 2&#x27;s code-mode through the VLM Run Chat Completions API. <br/><br/>Although state-of-the-art multimodal models perform well on many vision tasks, they do not cover the full spectrum of visual capabilities and are largely constrained to text-based outputs. Orion extends beyond traditional MLLMs by providing both pixel-level understanding and spatial reasoning capabilities, enabling richer interactions with visual content and more precise grounding in the visual world.</p><p class="my-5 text-blog-body text-blog-article"></p><p class="my-5 text-blog-body text-blog-article"></p><figure class="my-8"><iframe title="Orion-2 stacked capability and accuracy" srcDoc="&lt;!DOCTYPE html&gt;
&lt;html lang=&quot;en&quot;&gt;
&lt;head&gt;
&lt;meta charset=&quot;UTF-8&quot;&gt;
&lt;meta name=&quot;viewport&quot; content=&quot;width=device-width, initial-scale=1.0&quot;&gt;
&lt;title&gt;Orion 2 capability and accuracy breakdown&lt;/title&gt;
&lt;link rel=&quot;preconnect&quot; href=&quot;https://fonts.googleapis.com&quot;&gt;
&lt;link rel=&quot;preconnect&quot; href=&quot;https://fonts.gstatic.com&quot; crossorigin&gt;
&lt;link href=&quot;https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&amp;display=swap&quot; rel=&quot;stylesheet&quot;&gt;
&lt;style&gt;
  :root {
    --ink: #1F2937;
    --ink-muted: #64748B;
    --ink-faint: #94A3B8;
    --border: #D1E9FF;
    --grid: #EEF2F7;
    --brand-blue-dark: #1D4ED8;
    --tier-high: #93C5FD;
    --tier-med: #BFDBFE;
    --tier-low: #DBEAFE;
    --tier-text: #1E3A8A;
    --gap-bg: #F9F8EC;
    --gap-text: #9CA3AF;
    --gemma: #93C5FD;
    --qwen: #B3A2FA;
    --g35: #4E8DF7;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  html, body { background: transparent; overflow: hidden; }
  body {
    font-family: &#x27;Inter&#x27;, -apple-system, BlinkMacSystemFont, sans-serif;
    color: var(--ink);
    padding: 0;
    -webkit-font-smoothing: antialiased;
  }
  .page {
    width: 100%;
    max-width: 1020px;
    margin: 0 auto;
  }
  .card {
    background: #FFFFFF;
    border: 1px solid var(--border);
    border-radius: 20px;
    padding: 20px 24px 18px;
    margin-bottom: 18px;
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
    overflow: hidden;
  }
  .card:last-child { margin-bottom: 0; }
  .card h2 {
    font-size: 15.5px;
    font-weight: 600;
    letter-spacing: -0.01em;
    margin-bottom: 14px;
  }
  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    font-size: 12.5px;
    font-weight: 500;
    color: var(--ink-muted);
    margin-bottom: 12px;
  }
  .legend-filter {
    appearance: none;
    -webkit-appearance: none;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    border: 0;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
    color: inherit;
    cursor: pointer;
    font: inherit;
    line-height: inherit;
    outline: none;
    padding: 0;
    margin: 0;
    text-align: left;
    transition: color 160ms ease, opacity 160ms ease;
  }
  .legend-filter:hover,
  .legend-filter:focus-visible,
  .legend-filter.is-active {
    color: var(--ink);
  }
  .legend-filter:focus-visible .swatch,
  .legend-filter.is-active .swatch {
    box-shadow: 0 0 0 2px rgba(15, 23, 42, 0.12);
  }
  .swatch {
    width: 12px;
    height: 12px;
    border-radius: 4px;
    display: inline-block;
  }
  .table-scroll,
  .chart-scroll {
    overflow: visible;
  }
  table {
    width: 100%;
    min-width: 0;
    table-layout: fixed;
    border-collapse: separate;
    border-spacing: 5px;
    font-size: 13px;
  }
  th {
    font-size: 13px;
    font-weight: 600;
    padding-bottom: 6px;
  }
  th.label-col { width: 190px; }
  th.orion { color: var(--brand-blue-dark); }
  th.frontier { color: var(--ink-faint); font-weight: 500; }
  .row-label {
    font-size: 13px;
    color: var(--ink);
    padding-right: 8px;
    text-align: right;
    font-weight: 500;
  }
  td.cell {
    text-align: center;
    padding: 11px 4px;
    border-radius: 8px;
    font-weight: 600;
    font-size: 12.5px;
  }
  td.high { background: var(--tier-high); color: var(--tier-text); }
  td.med { background: var(--tier-med); color: var(--tier-text); }
  td.low { background: var(--tier-low); color: var(--tier-text); }
  td.gap { background: var(--gap-bg); color: var(--gap-text); font-weight: 500; }
  svg {
    display: block;
    width: 100%;
    height: auto;
    min-width: 0;
    overflow: visible;
  }
  svg text { font-family: &#x27;Inter&#x27;, -apple-system, BlinkMacSystemFont, sans-serif; }
  .bar-segment,
  .capability-cell {
    cursor: pointer;
    outline: none;
    transition: opacity 160ms ease, filter 160ms ease;
  }
  .bar-segment:hover,
  .bar-segment:focus-visible,
  .bar-segment.is-active {
    filter: drop-shadow(0 8px 14px rgba(15, 23, 42, 0.14));
  }
  .capability-cell:hover,
  .capability-cell:focus-visible,
  .capability-cell.is-active {
    box-shadow: 0 8px 18px rgba(15, 23, 42, 0.12);
    position: relative;
    z-index: 1;
  }
  svg.has-active .bar-segment {
    opacity: 0.22;
  }
  svg.has-active .bar-segment.is-active {
    opacity: 1;
  }
  .capability-table.has-active .capability-cell {
    opacity: 0.22;
  }
  .capability-table.has-active .capability-cell.is-active {
    opacity: 1;
  }
  .stacked-tooltip {
    position: fixed;
    z-index: 20;
    left: 0;
    top: 0;
    min-width: 176px;
    pointer-events: none;
    opacity: 0;
    transform: translate3d(-999px, -999px, 0) scale(0.98);
    transition: opacity 120ms ease, transform 120ms ease;
    border: 1px solid rgba(203, 213, 225, 0.9);
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.96);
    box-shadow: 0 14px 34px rgba(15, 23, 42, 0.16);
    padding: 12px 14px;
    color: var(--ink);
    backdrop-filter: blur(10px);
  }
  .stacked-tooltip.visible {
    opacity: 1;
    transform: translate3d(var(--tooltip-x), var(--tooltip-y), 0) scale(1);
  }
  .tooltip-category {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: -0.01em;
    margin-bottom: 8px;
  }
  .tooltip-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    font-size: 12.5px;
    color: var(--ink-muted);
  }
  .tooltip-model {
    display: flex;
    align-items: center;
    gap: 7px;
  }
  .tooltip-swatch {
    width: 10px;
    height: 10px;
    border-radius: 3px;
    flex: 0 0 auto;
  }
  .tooltip-value {
    color: var(--ink);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }
  @media (max-width: 720px) {
    .card { padding: 16px 12px 16px; }
    .card h2 { font-size: 14px; }
    .legend { gap: 10px; font-size: 10.5px; }
    th { font-size: 10.5px; }
    th.label-col { width: 150px; }
    .row-label { font-size: 11px; }
    td.cell { font-size: 11.5px; padding: 10px 2px; }
    .stacked-tooltip { display: none; }
  }
&lt;/style&gt;
&lt;/head&gt;
&lt;body&gt;
&lt;main class=&quot;page&quot;&gt;
  &lt;section class=&quot;card&quot; aria-labelledby=&quot;stacked-capability-title&quot;&gt;
    &lt;h2 id=&quot;stacked-capability-title&quot;&gt;Capability coverage vs. frontier models&lt;/h2&gt;
    &lt;div class=&quot;legend&quot;&gt;
      &lt;button class=&quot;legend-filter&quot; type=&quot;button&quot; aria-pressed=&quot;false&quot; data-scope=&quot;capability&quot; data-filter-type=&quot;tier&quot; data-filter-value=&quot;high&quot; data-category=&quot;Capability tier&quot; data-model=&quot;All models&quot; data-value=&quot;high&quot; data-color=&quot;#93C5FD&quot;&gt;&lt;i class=&quot;swatch&quot; style=&quot;background: var(--tier-high)&quot;&gt;&lt;/i&gt;high&lt;/button&gt;
      &lt;button class=&quot;legend-filter&quot; type=&quot;button&quot; aria-pressed=&quot;false&quot; data-scope=&quot;capability&quot; data-filter-type=&quot;tier&quot; data-filter-value=&quot;med&quot; data-category=&quot;Capability tier&quot; data-model=&quot;All models&quot; data-value=&quot;med&quot; data-color=&quot;#BFDBFE&quot;&gt;&lt;i class=&quot;swatch&quot; style=&quot;background: var(--tier-med)&quot;&gt;&lt;/i&gt;med&lt;/button&gt;
      &lt;button class=&quot;legend-filter&quot; type=&quot;button&quot; aria-pressed=&quot;false&quot; data-scope=&quot;capability&quot; data-filter-type=&quot;tier&quot; data-filter-value=&quot;low&quot; data-category=&quot;Capability tier&quot; data-model=&quot;All models&quot; data-value=&quot;low&quot; data-color=&quot;#DBEAFE&quot;&gt;&lt;i class=&quot;swatch&quot; style=&quot;background: var(--tier-low)&quot;&gt;&lt;/i&gt;low&lt;/button&gt;
      &lt;button class=&quot;legend-filter&quot; type=&quot;button&quot; aria-pressed=&quot;false&quot; data-scope=&quot;capability&quot; data-filter-type=&quot;tier&quot; data-filter-value=&quot;not supported&quot; data-category=&quot;Capability tier&quot; data-model=&quot;All models&quot; data-value=&quot;not supported&quot; data-color=&quot;#F9F8EC&quot;&gt;&lt;i class=&quot;swatch&quot; style=&quot;background: var(--gap-bg); border: 1px solid #E5E4D8&quot;&gt;&lt;/i&gt;- not supported&lt;/button&gt;
    &lt;/div&gt;
    &lt;div class=&quot;table-scroll&quot;&gt;
      &lt;table id=&quot;stacked-capability-table&quot; class=&quot;capability-table&quot;&gt;
        &lt;thead&gt;
          &lt;tr&gt;
            &lt;th class=&quot;label-col&quot; scope=&quot;col&quot; aria-label=&quot;Capability&quot;&gt;&lt;/th&gt;
            &lt;th class=&quot;orion&quot; scope=&quot;col&quot;&gt;Orion-2 Pro&lt;/th&gt;
            &lt;th class=&quot;frontier&quot; scope=&quot;col&quot;&gt;Gemini 3.5 Flash&lt;/th&gt;
            &lt;th class=&quot;frontier&quot; scope=&quot;col&quot;&gt;GPT-5.5&lt;/th&gt;
            &lt;th class=&quot;frontier&quot; scope=&quot;col&quot;&gt;Claude Opus 4.8&lt;/th&gt;
          &lt;/tr&gt;
        &lt;/thead&gt;
        &lt;tbody&gt;
          &lt;tr&gt;&lt;th class=&quot;row-label&quot; scope=&quot;row&quot;&gt;Image understanding&lt;/th&gt;&lt;td class=&quot;cell high&quot;&gt;high&lt;/td&gt;&lt;td class=&quot;cell high&quot;&gt;high&lt;/td&gt;&lt;td class=&quot;cell high&quot;&gt;high&lt;/td&gt;&lt;td class=&quot;cell high&quot;&gt;high&lt;/td&gt;&lt;/tr&gt;
          &lt;tr&gt;&lt;th class=&quot;row-label&quot; scope=&quot;row&quot;&gt;OCR &amp;amp; documents&lt;/th&gt;&lt;td class=&quot;cell high&quot;&gt;high&lt;/td&gt;&lt;td class=&quot;cell high&quot;&gt;high&lt;/td&gt;&lt;td class=&quot;cell high&quot;&gt;high&lt;/td&gt;&lt;td class=&quot;cell high&quot;&gt;high&lt;/td&gt;&lt;/tr&gt;
          &lt;tr&gt;&lt;th class=&quot;row-label&quot; scope=&quot;row&quot;&gt;Grounding &amp;amp; evidence&lt;/th&gt;&lt;td class=&quot;cell high&quot;&gt;high&lt;/td&gt;&lt;td class=&quot;cell high&quot;&gt;high&lt;/td&gt;&lt;td class=&quot;cell high&quot;&gt;high&lt;/td&gt;&lt;td class=&quot;cell high&quot;&gt;high&lt;/td&gt;&lt;/tr&gt;
          &lt;tr&gt;&lt;th class=&quot;row-label&quot; scope=&quot;row&quot;&gt;Localization &amp;amp; counting&lt;/th&gt;&lt;td class=&quot;cell med&quot;&gt;med&lt;/td&gt;&lt;td class=&quot;cell med&quot;&gt;med&lt;/td&gt;&lt;td class=&quot;cell med&quot;&gt;med&lt;/td&gt;&lt;td class=&quot;cell med&quot;&gt;med&lt;/td&gt;&lt;/tr&gt;
          &lt;tr&gt;&lt;th class=&quot;row-label&quot; scope=&quot;row&quot;&gt;Segmentation &amp;amp; masking&lt;/th&gt;&lt;td class=&quot;cell high&quot;&gt;high&lt;/td&gt;&lt;td class=&quot;cell gap&quot; aria-label=&quot;not supported&quot;&gt;&lt;span aria-hidden=&quot;true&quot;&gt;-&lt;/span&gt;&lt;/td&gt;&lt;td class=&quot;cell gap&quot; aria-label=&quot;not supported&quot;&gt;&lt;span aria-hidden=&quot;true&quot;&gt;-&lt;/span&gt;&lt;/td&gt;&lt;td class=&quot;cell gap&quot; aria-label=&quot;not supported&quot;&gt;&lt;span aria-hidden=&quot;true&quot;&gt;-&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;
          &lt;tr&gt;&lt;th class=&quot;row-label&quot; scope=&quot;row&quot;&gt;Audio/Video understanding&lt;/th&gt;&lt;td class=&quot;cell high&quot;&gt;high&lt;/td&gt;&lt;td class=&quot;cell med&quot;&gt;med&lt;/td&gt;&lt;td class=&quot;cell gap&quot; aria-label=&quot;not supported&quot;&gt;&lt;span aria-hidden=&quot;true&quot;&gt;-&lt;/span&gt;&lt;/td&gt;&lt;td class=&quot;cell gap&quot; aria-label=&quot;not supported&quot;&gt;&lt;span aria-hidden=&quot;true&quot;&gt;-&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;
          &lt;tr&gt;&lt;th class=&quot;row-label&quot; scope=&quot;row&quot;&gt;Audio/Video operations&lt;/th&gt;&lt;td class=&quot;cell low&quot;&gt;low&lt;/td&gt;&lt;td class=&quot;cell gap&quot; aria-label=&quot;not supported&quot;&gt;&lt;span aria-hidden=&quot;true&quot;&gt;-&lt;/span&gt;&lt;/td&gt;&lt;td class=&quot;cell gap&quot; aria-label=&quot;not supported&quot;&gt;&lt;span aria-hidden=&quot;true&quot;&gt;-&lt;/span&gt;&lt;/td&gt;&lt;td class=&quot;cell gap&quot; aria-label=&quot;not supported&quot;&gt;&lt;span aria-hidden=&quot;true&quot;&gt;-&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;
        &lt;/tbody&gt;
      &lt;/table&gt;
    &lt;/div&gt;
  &lt;/section&gt;

  &lt;section class=&quot;card&quot;&gt;
    &lt;h2&gt;Accuracy vs. difficulty across Orion backbones&lt;/h2&gt;
    &lt;div class=&quot;legend&quot;&gt;
      &lt;button class=&quot;legend-filter&quot; type=&quot;button&quot; aria-pressed=&quot;false&quot; data-scope=&quot;stacked-chart-difficulty&quot; data-filter-type=&quot;model&quot; data-filter-value=&quot;gemma&quot; data-category=&quot;Model filter&quot; data-model=&quot;orion-2:gemma4-26b-a4b&quot; data-value=&quot;all difficulty bars&quot; data-color=&quot;#93C5FD&quot;&gt;&lt;i class=&quot;swatch&quot; style=&quot;background: var(--gemma)&quot;&gt;&lt;/i&gt;orion-2:gemma4-26b-a4b&lt;/button&gt;
      &lt;button class=&quot;legend-filter&quot; type=&quot;button&quot; aria-pressed=&quot;false&quot; data-scope=&quot;stacked-chart-difficulty&quot; data-filter-type=&quot;model&quot; data-filter-value=&quot;auto&quot; data-category=&quot;Model filter&quot; data-model=&quot;orion-2:qwen3.6-35b-a3b&quot; data-value=&quot;all difficulty bars&quot; data-color=&quot;#B3A2FA&quot;&gt;&lt;i class=&quot;swatch&quot; style=&quot;background: var(--qwen)&quot;&gt;&lt;/i&gt;orion-2:qwen3.6-35b-a3b&lt;/button&gt;
      &lt;button class=&quot;legend-filter&quot; type=&quot;button&quot; aria-pressed=&quot;false&quot; data-scope=&quot;stacked-chart-difficulty&quot; data-filter-type=&quot;model&quot; data-filter-value=&quot;pro&quot; data-category=&quot;Model filter&quot; data-model=&quot;orion-2:gemini-3.5-flash&quot; data-value=&quot;all difficulty bars&quot; data-color=&quot;#4E8DF7&quot;&gt;&lt;i class=&quot;swatch&quot; style=&quot;background: var(--g35)&quot;&gt;&lt;/i&gt;orion-2:gemini-3.5-flash&lt;/button&gt;
    &lt;/div&gt;
    &lt;div class=&quot;chart-scroll&quot;&gt;&lt;div id=&quot;stacked-chart-difficulty&quot;&gt;&lt;/div&gt;&lt;/div&gt;
  &lt;/section&gt;

  &lt;section class=&quot;card&quot;&gt;
    &lt;h2&gt;Accuracy vs. task across Orion backbones&lt;/h2&gt;
    &lt;div class=&quot;legend&quot;&gt;
      &lt;button class=&quot;legend-filter&quot; type=&quot;button&quot; aria-pressed=&quot;false&quot; data-scope=&quot;stacked-chart-task&quot; data-filter-type=&quot;model&quot; data-filter-value=&quot;gemma&quot; data-category=&quot;Model filter&quot; data-model=&quot;orion-2:gemma4-26b-a4b&quot; data-value=&quot;all task bars&quot; data-color=&quot;#93C5FD&quot;&gt;&lt;i class=&quot;swatch&quot; style=&quot;background: var(--gemma)&quot;&gt;&lt;/i&gt;orion-2:gemma4-26b-a4b&lt;/button&gt;
      &lt;button class=&quot;legend-filter&quot; type=&quot;button&quot; aria-pressed=&quot;false&quot; data-scope=&quot;stacked-chart-task&quot; data-filter-type=&quot;model&quot; data-filter-value=&quot;auto&quot; data-category=&quot;Model filter&quot; data-model=&quot;orion-2:qwen3.6-35b-a3b&quot; data-value=&quot;all task bars&quot; data-color=&quot;#B3A2FA&quot;&gt;&lt;i class=&quot;swatch&quot; style=&quot;background: var(--qwen)&quot;&gt;&lt;/i&gt;orion-2:qwen3.6-35b-a3b&lt;/button&gt;
      &lt;button class=&quot;legend-filter&quot; type=&quot;button&quot; aria-pressed=&quot;false&quot; data-scope=&quot;stacked-chart-task&quot; data-filter-type=&quot;model&quot; data-filter-value=&quot;pro&quot; data-category=&quot;Model filter&quot; data-model=&quot;orion-2:gemini-3.5-flash&quot; data-value=&quot;all task bars&quot; data-color=&quot;#4E8DF7&quot;&gt;&lt;i class=&quot;swatch&quot; style=&quot;background: var(--g35)&quot;&gt;&lt;/i&gt;orion-2:gemini-3.5-flash&lt;/button&gt;
    &lt;/div&gt;
    &lt;div class=&quot;chart-scroll&quot;&gt;&lt;div id=&quot;stacked-chart-task&quot;&gt;&lt;/div&gt;&lt;/div&gt;
  &lt;/section&gt;
&lt;/main&gt;
&lt;div id=&quot;stacked-tooltip&quot; class=&quot;stacked-tooltip&quot; role=&quot;tooltip&quot; aria-hidden=&quot;true&quot;&gt;&lt;/div&gt;

&lt;script&gt;
const STACKED_MODELS = [
  { key: &quot;gemma&quot;, fill: &quot;#93C5FD&quot;, stroke: &quot;none&quot; },
  { key: &quot;auto&quot;, fill: &quot;#B3A2FA&quot;, stroke: &quot;none&quot; },
  { key: &quot;pro&quot;, fill: &quot;#4E8DF7&quot;, stroke: &quot;none&quot; },
];

const STACKED_DIFFICULTY = [
  { label: [&quot;Easy&quot;], gemma: 84.0, auto: 86.0, pro: 100.0 },
  { label: [&quot;Medium&quot;], gemma: 92.0, auto: 89.0, pro: 82.0 },
  { label: [&quot;Hard&quot;], gemma: 66.7, auto: 60.0, pro: 70.0 },
  { label: [&quot;Overall&quot;], gemma: 82.1, auto: 79.7, pro: 85.5 },
];

const STACKED_TASKS = [
  { label: [&quot;Image&quot;, &quot;Understanding&quot;], gemma: 95.0, auto: 85.0, pro: 100.0 },
  { label: [&quot;OCR &amp;amp;&quot;, &quot;Documents&quot;], gemma: 91.7, auto: 93.3, pro: 78.3 },
  { label: [&quot;Grounding&quot;, &quot;&amp;amp; Evidence&quot;], gemma: 100.0, auto: 100.0, pro: 100.0 },
  { label: [&quot;Localization&quot;, &quot;&amp;amp; Counting&quot;], gemma: 90.0, auto: 76.0, pro: 70.0 },
  { label: [&quot;Segmentation&quot;, &quot;&amp;amp; Masking&quot;], gemma: 91.7, auto: 62.5, pro: 100.0 },
  { label: [&quot;Audio/Video&quot;, &quot;Understanding&quot;], gemma: 33.3, auto: 66.7, pro: 100.0 },
  { label: [&quot;Audio/Video&quot;, &quot;Operations&quot;], gemma: 50.0, auto: 50.0, pro: 50.0 },
];

function stackedEscapeSvgText(value) {
  return String(value).replace(/&amp;/g, &quot;&amp;amp;&quot;).replace(/&lt;/g, &quot;&amp;lt;&quot;).replace(/&gt;/g, &quot;&amp;gt;&quot;);
}

function stackedEscapeAttr(value) {
  return stackedEscapeSvgText(value).replace(/&quot;/g, &quot;&amp;quot;&quot;);
}

function stackedReadableLabel(label) {
  return label.join(&quot; &quot;).replace(/&amp;amp;/g, &quot;&amp;&quot;);
}

function stackedModelName(key) {
  if (key === &quot;gemma&quot;) return &quot;orion-2:gemma4-26b-a4b&quot;;
  if (key === &quot;auto&quot;) return &quot;orion-2:qwen3.6-35b-a3b&quot;;
  return &quot;orion-2:gemini-3.5-flash&quot;;
}

function stackedModelColor(key) {
  if (key === &quot;gemma&quot;) return &quot;#93C5FD&quot;;
  if (key === &quot;auto&quot;) return &quot;#B3A2FA&quot;;
  return &quot;#4E8DF7&quot;;
}

function stackedTierColor(tier) {
  if (tier === &quot;high&quot;) return &quot;#93C5FD&quot;;
  if (tier === &quot;med&quot;) return &quot;#BFDBFE&quot;;
  if (tier === &quot;low&quot;) return &quot;#DBEAFE&quot;;
  return &quot;#F9F8EC&quot;;
}

function installCapabilityCellMetadata() {
  const table = document.getElementById(&quot;stacked-capability-table&quot;);
  if (!table) return;

  const models = Array.from(table.querySelectorAll(&quot;thead th&quot;))
    .slice(1)
    .map((header) =&gt; header.textContent.trim());

  table.querySelectorAll(&quot;tbody tr&quot;).forEach((row) =&gt; {
    const capability = row.querySelector(&quot;.row-label&quot;)?.textContent.trim() || &quot;Capability&quot;;

    row.querySelectorAll(&quot;td.cell&quot;).forEach((cell, index) =&gt; {
      const rawTier = cell.textContent.trim();
      const tier = rawTier === &quot;-&quot; ? &quot;not supported&quot; : rawTier;
      const model = models[index] || &quot;Model&quot;;

      cell.classList.add(&quot;capability-cell&quot;);
      cell.tabIndex = 0;
      cell.setAttribute(&quot;role&quot;, &quot;button&quot;);
      cell.setAttribute(&quot;aria-pressed&quot;, &quot;false&quot;);
      cell.setAttribute(&quot;aria-label&quot;, capability + &quot;, &quot; + model + &quot;, &quot; + tier);
      cell.dataset.category = capability;
      cell.dataset.model = model;
      cell.dataset.value = tier;
      cell.dataset.color = stackedTierColor(tier);
    });
  });
}

function stackedChartDescription(groups) {
  return groups.map((group) =&gt; {
    const values = STACKED_MODELS.map((model) =&gt; stackedModelName(model.key) + &quot; &quot; + Math.round(group[model.key]) + &quot;%&quot;).join(&quot;, &quot;);
    return stackedReadableLabel(group.label) + &quot;: &quot; + values;
  }).join(&quot;; &quot;);
}

function renderStackedChart(elId, groups, opts) {
  const width = 1020;
  const plotH = opts.plotH;
  const barW = opts.barW;
  const barGap = opts.barGap;
  const padL = 46;
  const padR = 8;
  const padT = 24;
  const padB = 40;
  const plotW = width - padL - padR;
  const height = padT + plotH + padB;
  const groupW = plotW / groups.length;
  const groupBarsW = STACKED_MODELS.length * barW + (STACKED_MODELS.length - 1) * barGap;
  const titleId = elId + &quot;-title&quot;;
  const descId = elId + &quot;-desc&quot;;

  let svg = &#x27;&lt;svg viewBox=&quot;0 0 &#x27; + width + &#x27; &#x27; + height + &#x27;&quot; width=&quot;100%&quot; role=&quot;img&quot; aria-labelledby=&quot;&#x27; + titleId + &#x27; &#x27; + descId + &#x27;&quot;&gt;&#x27; +
    &#x27;&lt;title id=&quot;&#x27; + titleId + &#x27;&quot;&gt;&#x27; + stackedEscapeSvgText(opts.label) + &#x27;&lt;/title&gt;&#x27; +
    &#x27;&lt;desc id=&quot;&#x27; + descId + &#x27;&quot;&gt;&#x27; + stackedEscapeSvgText(stackedChartDescription(groups)) + &#x27;&lt;/desc&gt;&#x27;;

  for (let value = 0; value &lt;= 100; value += 25) {
    const y = padT + plotH - (value / 100) * plotH;
    svg += &#x27;&lt;line x1=&quot;&#x27; + padL + &#x27;&quot; y1=&quot;&#x27; + y + &#x27;&quot; x2=&quot;&#x27; + (width - padR) + &#x27;&quot; y2=&quot;&#x27; + y + &#x27;&quot; stroke=&quot;#EEF2F7&quot; stroke-width=&quot;&#x27; + (value === 0 ? 1.5 : 1) + &#x27;&quot;/&gt;&#x27;;
    svg += &#x27;&lt;text x=&quot;&#x27; + (padL - 10) + &#x27;&quot; y=&quot;&#x27; + (y + 4) + &#x27;&quot; font-size=&quot;11.5&quot; fill=&quot;#94A3B8&quot; text-anchor=&quot;end&quot;&gt;&#x27; + value + &#x27;%&lt;/text&gt;&#x27;;
  }

  groups.forEach((group, groupIndex) =&gt; {
    const centerX = padL + groupIndex * groupW + groupW / 2;
    let barX = centerX - groupBarsW / 2;

    STACKED_MODELS.forEach((model) =&gt; {
      const value = group[model.key];
      const categoryLabel = stackedReadableLabel(group.label);
      const modelLabel = stackedModelName(model.key);
      const valueLabel = Math.round(value) + &quot;%&quot;;
      const barH = Math.max((value / 100) * plotH, 2);
      const barY = padT + plotH - barH;
      const radius = Math.min(5, barH / 2);
      const outline = &#x27;M&#x27; + barX + &#x27;,&#x27; + (padT + plotH) +
        &#x27; v&#x27; + (-(barH - radius)) +
        &#x27; q0,&#x27; + (-radius) + &#x27; &#x27; + radius + &#x27;,&#x27; + (-radius) +
        &#x27; h&#x27; + (barW - 2 * radius) +
        &#x27; q&#x27; + radius + &#x27;,0 &#x27; + radius + &#x27;,&#x27; + radius +
        &#x27; v&#x27; + (barH - radius);

      svg += &#x27;&lt;g class=&quot;bar-segment&quot; tabindex=&quot;0&quot; role=&quot;button&quot; aria-pressed=&quot;false&quot; aria-label=&quot;&#x27; + stackedEscapeAttr(categoryLabel + &quot;, &quot; + modelLabel + &quot;, &quot; + valueLabel) + &#x27;&quot; data-category=&quot;&#x27; + stackedEscapeAttr(categoryLabel) + &#x27;&quot; data-model=&quot;&#x27; + stackedEscapeAttr(modelLabel) + &#x27;&quot; data-value=&quot;&#x27; + stackedEscapeAttr(valueLabel) + &#x27;&quot; data-model-key=&quot;&#x27; + stackedEscapeAttr(model.key) + &#x27;&quot; data-color=&quot;&#x27; + stackedEscapeAttr(stackedModelColor(model.key)) + &#x27;&quot;&gt;&#x27;;
      svg += &#x27;&lt;path d=&quot;&#x27; + outline + &#x27; z&quot; fill=&quot;&#x27; + model.fill + &#x27;&quot;/&gt;&#x27;;
      if (model.stroke !== &quot;none&quot;) {
        svg += &#x27;&lt;path d=&quot;&#x27; + outline + &#x27;&quot; fill=&quot;none&quot; stroke=&quot;&#x27; + model.stroke + &#x27;&quot; stroke-width=&quot;1&quot;/&gt;&#x27;;
      }
      svg += &#x27;&lt;text x=&quot;&#x27; + (barX + barW / 2) + &#x27;&quot; y=&quot;&#x27; + (barY - 7) + &#x27;&quot; font-size=&quot;11&quot; font-weight=&quot;600&quot; fill=&quot;#64748B&quot; text-anchor=&quot;middle&quot;&gt;&#x27; + Math.round(value) + &#x27;&lt;/text&gt;&#x27;;
      svg += &#x27;&lt;/g&gt;&#x27;;
      barX += barW + barGap;
    });

    group.label.forEach((line, lineIndex) =&gt; {
      svg += &#x27;&lt;text x=&quot;&#x27; + centerX + &#x27;&quot; y=&quot;&#x27; + (padT + plotH + 18 + lineIndex * 14) + &#x27;&quot; font-size=&quot;12&quot; font-weight=&quot;500&quot; fill=&quot;#0F172A&quot; text-anchor=&quot;middle&quot;&gt;&#x27; + line + &#x27;&lt;/text&gt;&#x27;;
    });
  });

  svg += &#x27;&lt;/svg&gt;&#x27;;
  document.getElementById(elId).innerHTML = svg;
}

renderStackedChart(&quot;stacked-chart-difficulty&quot;, STACKED_DIFFICULTY, { plotH: 240, barW: 42, barGap: 8, label: &quot;Accuracy versus difficulty across Orion backbones&quot; });
renderStackedChart(&quot;stacked-chart-task&quot;, STACKED_TASKS, { plotH: 260, barW: 20, barGap: 6, label: &quot;Accuracy versus task across Orion backbones&quot; });

function installStackedChartInteractions() {
  const tooltip = document.getElementById(&quot;stacked-tooltip&quot;);
  if (!tooltip) return;

  installCapabilityCellMetadata();

  let activeTarget = null;

  function positionTooltip(event, anchor) {
    const margin = 12;
    const rect = tooltip.getBoundingClientRect();
    const anchorRect = anchor?.getBoundingClientRect();
    const pointerX = Number.isFinite(event.clientX) ? event.clientX : (anchorRect?.left ?? margin);
    const pointerY = Number.isFinite(event.clientY) ? event.clientY : (anchorRect?.top ?? margin);
    const x = Math.min(pointerX + 14, window.innerWidth - rect.width - margin);
    const y = Math.min(pointerY + 14, window.innerHeight - rect.height - margin);
    tooltip.style.setProperty(&quot;--tooltip-x&quot;, Math.max(margin, x) + &quot;px&quot;);
    tooltip.style.setProperty(&quot;--tooltip-y&quot;, Math.max(margin, y) + &quot;px&quot;);
  }

  function showTooltip(bar, event) {
    const category = document.createElement(&quot;div&quot;);
    category.className = &quot;tooltip-category&quot;;
    category.textContent = bar.dataset.category || &quot;&quot;;

    const row = document.createElement(&quot;div&quot;);
    row.className = &quot;tooltip-row&quot;;

    const model = document.createElement(&quot;span&quot;);
    model.className = &quot;tooltip-model&quot;;

    const swatch = document.createElement(&quot;span&quot;);
    swatch.className = &quot;tooltip-swatch&quot;;
    swatch.style.background = bar.dataset.color || &quot;#94A3B8&quot;;

    const modelText = document.createTextNode(bar.dataset.model || &quot;&quot;);
    model.append(swatch, modelText);

    const value = document.createElement(&quot;span&quot;);
    value.className = &quot;tooltip-value&quot;;
    value.textContent = bar.dataset.value || &quot;&quot;;

    row.append(model, value);
    tooltip.replaceChildren(category, row);
    tooltip.classList.add(&quot;visible&quot;);
    tooltip.setAttribute(&quot;aria-hidden&quot;, &quot;false&quot;);
    positionTooltip(event, bar);
  }

  function hideTooltip() {
    tooltip.classList.remove(&quot;visible&quot;);
    tooltip.setAttribute(&quot;aria-hidden&quot;, &quot;true&quot;);
  }

  function clearActive() {
    document.querySelectorAll(&quot;svg.has-active, .capability-table.has-active&quot;).forEach((container) =&gt; container.classList.remove(&quot;has-active&quot;));
    document.querySelectorAll(&quot;.bar-segment.is-active, .capability-cell.is-active, .legend-filter.is-active&quot;).forEach((target) =&gt; {
      target.classList.remove(&quot;is-active&quot;);
      target.setAttribute(&quot;aria-pressed&quot;, &quot;false&quot;);
    });
    activeTarget = null;
    hideTooltip();
  }

  function setActive(target, event) {
    clearActive();
    activeTarget = target;
    target.classList.add(&quot;is-active&quot;);
    target.setAttribute(&quot;aria-pressed&quot;, &quot;true&quot;);
    target.closest(&quot;svg, .capability-table&quot;)?.classList.add(&quot;has-active&quot;);
    showTooltip(target, event);
  }

  function setLegendActive(filter, event) {
    clearActive();
    activeTarget = filter;
    filter.classList.add(&quot;is-active&quot;);
    filter.setAttribute(&quot;aria-pressed&quot;, &quot;true&quot;);

    let matches = [];
    if (filter.dataset.scope === &quot;capability&quot;) {
      const table = document.getElementById(&quot;stacked-capability-table&quot;);
      table?.classList.add(&quot;has-active&quot;);
      matches = Array.from(table?.querySelectorAll(&quot;.capability-cell&quot;) || [])
        .filter((cell) =&gt; cell.dataset.value === filter.dataset.filterValue);
    } else {
      const chart = document.getElementById(filter.dataset.scope || &quot;&quot;);
      const svg = chart?.querySelector(&quot;svg&quot;);
      svg?.classList.add(&quot;has-active&quot;);
      matches = Array.from(svg?.querySelectorAll(&quot;.bar-segment&quot;) || [])
        .filter((bar) =&gt; bar.dataset.modelKey === filter.dataset.filterValue);
    }

    matches.forEach((target) =&gt; {
      target.classList.add(&quot;is-active&quot;);
      target.setAttribute(&quot;aria-pressed&quot;, &quot;true&quot;);
    });
    showTooltip(filter, event);
  }

  document.querySelectorAll(&quot;.bar-segment, .capability-cell, .legend-filter&quot;).forEach((target) =&gt; {
    target.addEventListener(&quot;pointerenter&quot;, (event) =&gt; {
      if (!activeTarget) showTooltip(target, event);
    });
    target.addEventListener(&quot;pointermove&quot;, (event) =&gt; {
      if (!activeTarget || activeTarget === target) positionTooltip(event, target);
    });
    target.addEventListener(&quot;pointerleave&quot;, () =&gt; {
      if (!activeTarget) hideTooltip();
    });
    target.addEventListener(&quot;click&quot;, (event) =&gt; {
      event.stopPropagation();
      if (activeTarget === target) clearActive();
      else if (target.classList.contains(&quot;legend-filter&quot;)) setLegendActive(target, event);
      else setActive(target, event);
    });
    target.addEventListener(&quot;keydown&quot;, (event) =&gt; {
      if (event.key === &quot;Enter&quot; || event.key === &quot; &quot;) {
        event.preventDefault();
        if (activeTarget === target) clearActive();
        else if (target.classList.contains(&quot;legend-filter&quot;)) setLegendActive(target, event);
        else setActive(target, event);
      }
      if (event.key === &quot;Escape&quot;) clearActive();
    });
  });

  document.addEventListener(&quot;click&quot;, clearActive);
  document.addEventListener(&quot;keydown&quot;, (event) =&gt; {
    if (event.key === &quot;Escape&quot;) clearActive();
  });
  window.addEventListener(&quot;blur&quot;, clearActive);
}

installStackedChartInteractions();
&lt;/script&gt;

&lt;script&gt;
(() =&gt; {
  const embedId = &quot;_R_1ikmlubsnq5iulb_&quot;;
  const sendHeight = () =&gt; {
    // Prefer body metrics. documentElement.scrollHeight often mirrors the
    // iframe viewport, which prevents shrinking below the fallback height.
    const height = Math.max(
      document.body?.scrollHeight || 0,
      document.body?.offsetHeight || 0
    );
    if (height &gt; 0) {
      parent.postMessage({ type: &quot;vlm-inline-html-resize&quot;, embedId, height }, &quot;*&quot;);
    }
  };

  window.addEventListener(&quot;load&quot;, sendHeight);
  requestAnimationFrame(sendHeight);
  setTimeout(sendHeight, 250);

  if (typeof ResizeObserver !== &quot;undefined&quot;) {
    const observer = new ResizeObserver(sendHeight);
    if (document.body) observer.observe(document.body);
    if (document.documentElement) observer.observe(document.documentElement);
  }
})();
&lt;/script&gt;&lt;/body&gt;
&lt;/html&gt;" loading="lazy" sandbox="allow-scripts" class="block w-full overflow-hidden border-0 bg-transparent" scrolling="no" style="height:1180px;overflow:hidden"></iframe></figure><h2 id="get-started" class="mt-10 mb-1 scroll-mt-28 font-sans text-blog-h2 font-semibold text-primary-mid">Get started</h2><p class="my-5 text-blog-body text-blog-article">Try Orion 2 now at <a href="https://chat.vlm.run/" target="_blank" rel="noopener noreferrer" class="text-navy underline decoration-primary/30 underline-offset-[3px] transition-colors hover:text-primary">chat.vlm.run</a>. Bring your own favorite images, documents, or videos and inspect the programs it writes. When you&#x27;re ready to build, the same agent is available through the VLM Run Chat Completions API, and our team can help you evaluate it on your production workloads.</p></div></div></div></div><section class="mt-14" aria-labelledby="related-posts-heading"><div class="relative left-1/2 w-screen max-w-[100vw] -translate-x-1/2 border-y border-border py-6 lg:py-8"><div class="mx-auto max-w-[1168px] px-5 sm:px-8 lg:px-16"><div class="mx-auto flex max-w-5xl flex-col gap-6 sm:flex-row sm:items-end sm:justify-between"><h2 id="related-posts-heading" class="font-serif text-display-sm text-navy">Related posts</h2><a href="/blog" class="inline-flex items-center justify-center gap-1.5 cursor-pointer transition-[transform,box-shadow,background-color,opacity] duration-300 ease-out hover:opacity-90 hover:-translate-y-px no-underline font-medium bg-primary-dark text-white rounded-[20px] border border-primary-border shadow-btn text-label px-3 py-2 shrink-0">View all<svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M5.5 3.5L9 7l-3.5 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg></a></div></div></div><div class="mx-auto max-w-[1168px] px-5 sm:px-8 lg:px-16 mt-10"><div class="mx-auto grid max-w-5xl grid-cols-1 gap-4 sm:grid-cols-2