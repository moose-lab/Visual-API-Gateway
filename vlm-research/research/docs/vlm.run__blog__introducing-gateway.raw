"div\",null,{\"aria-hidden\":\"true\",\"className\":\"relative z-10 bg-navy-dark"])</script><script>self.__next_f.push([1,"\",\"style\":{\"height\":30},\"children\":[\"$\",\"div\",null,{\"aria-hidden\":\"true\",\"className\":\"pointer-events-none absolute top-0 bottom-0 border-x border-dark-border\",\"style\":{\"left\":\"max(20px, calc((var(--page-rail-width, 100vw) - 1168px) / 2))\",\"right\":\"max(20px, calc((var(--page-rail-width, 100vw) - 1168px) / 2))\"}}]}]\n"])</script><script>self.__next_f.push([1,"42:I[252827,[\"/_next/static/chunks/b076810d0fd38179.js?dpl=dpl_ECYyVTvmC2RAfYSm8YdEVejNFnj3\",\"/_next/static/chunks/2b247885c6725624.js?dpl=dpl_ECYyVTvmC2RAfYSm8YdEVejNFnj3\",\"/_next/static/chunks/f214a4e47049aa46.js?dpl=dpl_ECYyVTvmC2RAfYSm8YdEVejNFnj3\",\"/_next/static/chunks/df2d0e54478bc56b.js?dpl=dpl_ECYyVTvmC2RAfYSm8YdEVejNFnj3\",\"/_next/static/chunks/9b6dc91b04fc3a63.js?dpl=dpl_ECYyVTvmC2RAfYSm8YdEVejNFnj3\",\"/_next/static/chunks/6f4d85975e93d001.js?dpl=dpl_ECYyVTvmC2RAfYSm8YdEVejNFnj3\"],\"InlineVideoFromValue\"]\n"])</script><script>self.__next_f.push([1,"38:[\"$\",\"div\",null,{\"className\":\"blog-article prose-none max-w-none [\u0026\u003e*:first-child]:mt-0\",\"children\":[[\"$\",\"p\",\"fea615c52537\",{\"className\":\"my-5 text-blog-body text-blog-article\",\"children\":[\"Since the Orion agent launch in November, our customers have run hundreds of thousands of requests spanning millions of tool calls in production every month, across healthcare claims, construction submittals, legal contracts, and faxes. One question came back more than any other: \",[\"$\",\"em\",\"2a04d2bf2ab7\",{\"className\":\"italic text-inherit\",\"children\":[\"which models are you running underneath, and can we call them directly?\"]}]]}],[\"$\",\"p\",\"88ca4851331d\",{\"className\":\"my-5 text-blog-body text-blog-article\",\"children\":[\"We listened and gave them early access to the models through our gateway. Today, we're opening access to everyone.\"]}],[\"$\",\"p\",\"b09fe47161f7\",{\"className\":\"my-5 text-blog-body text-blog-article\",\"children\":[\"The \",[\"$\",\"strong\",\"fc6c60a87336\",{\"className\":\"font-bold text-inherit\",\"children\":[\"VLM Run Gateway\"]}],\" runs open-weight VLMs, OCR VLMs, embodied VLMs, and specialized ViTs behind one OpenAI-compatible API, at a fraction of commercial API pricing. Because they all share one interface, you can run and compare results on your own data and pick your own point on the cost/accuracy frontier by changing a single parameter. Point \",[\"$\",\"code\",\"7f76fcba6289\",{\"className\":\"rounded-md bg-primary/10 px-1.5 py-0.5 font-mono text-code text-primary\",\"children\":[\"base_url\"]}],\" at \",[\"$\",\"code\",\"c888748c8774\",{\"className\":\"rounded-md bg-primary/10 px-1.5 py-0.5 font-mono text-code text-primary\",\"children\":[\"https://gateway.vlm.run/v1/openai\"]}],\" and every model takes the request shape your OpenAI SDK already uses. It's \",[\"$\",\"a\",\"2e330bdaba52\",{\"href\":\"https://www.vlm.run/product/gateway\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"className\":\"text-navy underline decoration-primary/30 underline-offset-[3px] transition-colors hover:text-primary\",\"children\":[\"free during alpha\"]}],\", so try it on your own documents, images, and videos today.\"]}],[\"$\",\"$L42\",\"1d5d8e91bbbc\",{\"value\":{\"_key\":\"1d5d8e91bbbc\",\"_type\":\"inlineVideo\",\"autoPlay\":false,\"loop\":false,\"title\":\"Test inline video\",\"url\":\"/videos/gateway-launch.mp4\"}}],[\"$\",\"h2\",\"aad2e7a1edda\",{\"id\":\"you-dont-need-a-trillion-parameter-vlm\",\"className\":\"mt-10 mb-1 scroll-mt-28 font-sans text-blog-h2 font-semibold text-primary-mid\",\"children\":[\"You don't need a trillion parameter VLM\"]}],[\"$\",\"p\",\"c77ab7690715\",{\"className\":\"my-5 text-blog-body text-blog-article\",\"children\":[\"Parsing a documents, understanding images, summarizing videos: the best model for the job is rarely the biggest one. \",[\"$\",\"code\",\"a7e01b58112b\",{\"className\":\"rounded-md bg-primary/10 px-1.5 py-0.5 font-mono text-code text-primary\",\"children\":[\"zai-org/glm-ocr\"]}],\" is 0.9B parameters, \",[\"$\",\"code\",\"219db3224395\",{\"className\":\"rounded-md bg-primary/10 px-1.5 py-0.5 font-mono text-code text-primary\",\"children\":[\"rednote-hilab/dots.mocr\"]}],\" 3B. Both are trained on page images at document-native resolutions, and it shows: over 3,000 output tokens/sec on commodity hardware, a fraction of the vision tokens a general-purpose VLM burns on the same page, and small enough to run on older GPUs, which is what makes on-prem and VPC deployment tractable.\"]}],[\"$\",\"p\",\"3dd8c8036461\",{\"className\":\"my-5 text-blog-body text-blog-article\",\"children\":[\"Frontier VLMs are built for open-ended reasoning, \\\"figure out what this means\\\" rather than \\\"read this,\\\" and there they remain the right call. On documents they fail repeatably: dense multi-column tables, low-DPI fax scans, overlaid stamps and handwriting, non-Latin scripts. For extraction, OCR, and layout, they're an expensive default nobody chose deliberately.\"]}],\"$L43\",\"$L44\",\"$L45\",\"$L46\",\"$L47\",\"$L48\",\"$L49\",\"$L4a\",\"$L4b\",\"$L4c\",\"$L4d\",\"$L4e\",\"$L4f\",\"$L50\",\"$L51\",\"$L52\",\"$L53\",\"$L54\",\"$L55\",\"$L56\",\"$L57\",\"$L58\",\"$L59\",\"$L5a\",\"$L5b\",\"$L5c\",\"$L5d\"]}]\n"])</script><script>self.__next_f.push([1,"5e:I[735993,[\"/_next/static/chunks/b076810d0fd38179.js?dpl=dpl_ECYyVTvmC2RAfYSm8YdEVejNFnj3\",\"/_next/static/chunks/2b247885c6725624.js?dpl=dpl_ECYyVTvmC2RAfYSm8YdEVejNFnj3\",\"/_next/static/chunks/f214a4e47049aa46.js?dpl=dpl_ECYyVTvmC2RAfYSm8YdEVejNFnj3\",\"/_next/static/chunks/df2d0e54478bc56b.js?dpl=dpl_ECYyVTvmC2RAfYSm8YdEVejNFnj3\",\"/_next/static/chunks/9b6dc91b04fc3a63.js?dpl=dpl_ECYyVTvmC2RAfYSm8YdEVejNFnj3\",\"/_next/static/chunks/6f4d85975e93d001.js?dpl=dpl_ECYyVTvmC2RAfYSm8YdEVejNFnj3\"],\"default\"]\n61:I[703946,[\"/_next/static/chunks/b076810d0fd38179.js?dpl=dpl_ECYyVTvmC2RAfYSm8YdEVejNFnj3\",\"/_next/static/chunks/2b247885c6725624.js?dpl=dpl_ECYyVTvmC2RAfYSm8YdEVejNFnj3\",\"/_next/static/chunks/f214a4e47049aa46.js?dpl=dpl_ECYyVTvmC2RAfYSm8YdEVejNFnj3\",\"/_next/static/chunks/df2d0e54478bc56b.js?dpl=dpl_ECYyVTvmC2RAfYSm8YdEVejNFnj3\",\"/_next/static/chunks/9b6dc91b04fc3a63.js?dpl=dpl_ECYyVTvmC2RAfYSm8YdEVejNFnj3\",\"/_next/static/chunks/6f4d85975e93d001.js?dpl=dpl_ECYyVTvmC2RAfYSm8YdEVejNFnj3\"],\"default\"]\n43:[\"$\",\"p\",\"d36b31bdc980\",{\"className\":\"my-5 text-blog-body text-blog-article\",\"children\":[\"To test this, we evaluated six OCR models on the Gateway against eight commercial document parsers on \",[\"$\",\"a\",\"7b4d9855c4e6\",{\"href\":\"https://huggingface.co/datasets/llamaindex/ParseBench\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"className\":\"text-navy underline decoration-primary/30 underline-offset-[3px] transition-colors hover:text-primary\",\"children\":[\"ParseBench\"]}],\", and three open-weight VLMs on the Gateway against the frontier VLMs on \",[\"$\",\"a\",\"2eafc5f8a26b\",{\"href\":\"https://huggingface.co/datasets/OpenGVLab/MVBench\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"className\":\"text-navy underline decoration-primary/30 underline-offset-[3px] transition-colors hover:text-primary\",\"children\":[\"MVBench\"]}],\". Every model is plotted at its measured cost, per thousand pages for documents and per thousand clips for video:\"]}]\n5f:T65a1,"])</script><script>self.__next_f.push([1,"\u003c!DOCTYPE html\u003e\n\u003chtml lang=\"en\"\u003e\n\u003chead\u003e\n\u003cmeta charset=\"UTF-8\"\u003e\n\u003cmeta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\"\u003e\n\u003ctitle\u003eParseBench vs. cost per 1K pages\u003c/title\u003e\n\u003clink rel=\"preconnect\" href=\"https://fonts.googleapis.com\"\u003e\n\u003clink rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin\u003e\n\u003clink href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700\u0026display=swap\" rel=\"stylesheet\"\u003e\n\n\u003cstyle\u003e\n  :root {\n    --card: #FFFFFF;\n    --border: #E5E7EB;\n    --ink: #111827;\n    --ink-muted: #6B7280;\n    --ink-faint: #9CA3AF;\n    --gateway: #1265FF;\n    --market: #94A3B8;\n    --row-active: #F8FAFF;\n  }\n  * { box-sizing: border-box; margin: 0; padding: 0; }\n  html, body { background: transparent; overflow: hidden; }\n  body {\n    font-family: Inter, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;\n    color: var(--ink);\n    padding: 0;\n    -webkit-font-smoothing: antialiased;\n  }\n  .accuracy-card {\n    width: 100%;\n    max-width: 1020px;\n    margin: 0 auto;\n    background: var(--card);\n    border: 1px solid var(--border);\n    overflow: hidden;\n    padding: 22px 26px 20px;\n  }\n  .card-head {\n    display: flex;\n    flex-wrap: wrap;\n    flex-shrink: 0;\n    align-items: center;\n    justify-content: space-between;\n    gap: 12px;\n    margin-bottom: 14px;\n  }\n  .accuracy-card h2 {\n    font-size: 17px;\n    font-weight: 600;\n    letter-spacing: -0.02em;\n    color: var(--ink);\n    min-width: 0;\n  }\n  .switcher {\n    display: flex;\n    flex-shrink: 0;\n    border: 1px solid var(--border);\n  }\n  .switcher button {\n    appearance: none;\n    min-width: 92px;\n    padding: 6px 14px;\n    font: inherit;\n    font-size: 12px;\n    font-weight: 500;\n    letter-spacing: -0.01em;\n    color: var(--ink-muted);\n    background: #fff;\n    border: 0;\n    cursor: pointer;\n  }\n  .switcher button.is-active {\n    background: #1F5ACA;\n    color: #fff;\n  }\n  .plot-rule {\n    border-top: 1px solid var(--border);\n    padding-top: 16px;\n  }\n  .plot-rule.has-table { margin-bottom: 20px; }\n  .legend {\n    display: flex;\n    flex-wrap: wrap;\n    flex-shrink: 0;\n    gap: 16px;\n    font-size: 14px;\n    font-weight: 500;\n    color: var(--ink-muted);\n    margin-bottom: 12px;\n  }\n  .legend-filter {\n    appearance: none;\n    -webkit-appearance: none;\n    display: inline-flex;\n    align-items: center;\n    gap: 7px;\n    border: 0;\n    background: transparent;\n    color: inherit;\n    cursor: pointer;\n    font: inherit;\n    padding: 0;\n    margin: 0;\n    text-align: left;\n  }\n  .legend-filter:hover,\n  .legend-filter:focus-visible,\n  .legend-filter.is-active { color: var(--ink); }\n  .swatch {\n    width: 12px;\n    height: 12px;\n    border-radius: 4px;\n    display: inline-block;\n  }\n  .swatch-attractive {\n    background: rgba(18, 101, 255, 0.12);\n    box-shadow: inset 0 0 0 1px #3B82F6;\n  }\n  .legend-item {\n    display: inline-flex;\n    align-items: center;\n    gap: 7px;\n  }\n  .chart-scroll { overflow: hidden; }\n  .plot-wrap { position: relative; width: 100%; min-width: 0; }\n  svg { display: block; width: 100%; height: auto; overflow: hidden; }\n  svg text { font-family: Inter, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif; }\n  .dot { cursor: pointer; outline: none; }\n  svg.has-active .dot { opacity: 0.18; }\n  svg.has-active .dot.is-active { opacity: 1; }\n  svg.has-filter .dot { opacity: 0.22; }\n  svg.has-filter .dot.is-filtered { opacity: 1; }\n  svg.has-filter.has-active .dot.is-filtered { opacity: 0.22; }\n  svg.has-filter.has-active .dot.is-filtered.is-active { opacity: 1; }\n  .data-table {\n    width: 100%;\n    min-width: 480px;\n    border-collapse: collapse;\n  }\n  .table-scroll { overflow-x: auto; }\n  .data-table th {\n    padding: 0 16px 10px 0;\n    font-size: 10.5px;\n    font-weight: 500;\n    letter-spacing: 0.14em;\n    text-transform: uppercase;\n    color: var(--ink-faint);\n    text-align: right;\n  }\n  .data-table th:first-child { text-align: left; }\n  .data-table th:last-child { padding-right: 0; }\n  .data-table td {\n    padding: 10px 16px 10px 0;\n    font-size: 12.5px;\n    border-top: 1px solid #F3F4F6;\n    font-variant-numeric: tabular-nums;\n  }\n  .data-table td:last-child { padding-right: 0; }\n  .data-table tbody tr { cursor: pointer; }\n  .data-table tbody tr.is-active { background: var(--row-active); }\n  .data-table.has-active tbody tr { opacity: 0.32; }\n  .data-table.has-active tbody tr.is-active { opacity: 1; }\n  .model-cell {\n    font-weight: 500;\n    letter-spacing: -0.01em;\n  }\n  .num { text-align: right; }\n  .caption {\n    margin-top: 16px;\n    font-size: 12px;\n    line-height: 1.5;\n    color: var(--ink-muted);\n  }\n  .chart-tooltip {\n    position: fixed;\n    z-index: 20;\n    left: 0;\n    top: 0;\n    min-width: 176px;\n    pointer-events: none;\n    opacity: 0;\n    transform: translate3d(-999px, -999px, 0) scale(0.98);\n    transition: opacity 120ms ease, transform 120ms ease;\n    border: 1px solid rgba(203, 213, 225, 0.9);\n    background: rgba(255, 255, 255, 0.96);\n    padding: 12px 14px;\n    color: var(--ink);\n    backdrop-filter: blur(10px);\n  }\n  .chart-tooltip.visible {\n    opacity: 1;\n    transform: translate3d(var(--tooltip-x), var(--tooltip-y), 0) scale(1);\n  }\n  .tooltip-category {\n    font-size: 13px;\n    font-weight: 700;\n    letter-spacing: -0.01em;\n    margin-bottom: 8px;\n  }\n  .tooltip-row {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 18px;\n    font-size: 12.5px;\n    color: var(--ink-muted);\n  }\n  .tooltip-model { display: flex; align-items: center; gap: 7px; }\n  .tooltip-swatch { width: 10px; height: 10px; border-radius: 3px; flex: 0 0 auto; }\n  .tooltip-value { color: var(--ink); font-weight: 700; font-variant-numeric: tabular-nums; }\n  @media (max-width: 720px) {\n    .accuracy-card { padding: 18px 14px 16px; }\n    .legend { gap: 10px; font-size: 11.5px; }\n    .chart-tooltip { display: none; }\n    .point-label { display: none; }\n  }\n\u003c/style\u003e\n\u003c/head\u003e\n\u003cbody\u003e\n\u003cmain class=\"accuracy-card\"\u003e\n  \u003cdiv\u003e\n  \u003cdiv class=\"card-head\"\u003e\n    \u003ch2 id=\"chart-title\"\u003eParseBench vs. cost per 1K pages\u003c/h2\u003e\n    \u003cdiv class=\"switcher\" role=\"tablist\" aria-label=\"Benchmark modality\"\u003e\n    \u003cbutton type=\"button\" role=\"tab\" class=\"is-active\" aria-selected=\"true\" data-key=\"document\"\u003eDocument\u003c/button\u003e\n    \u003cbutton type=\"button\" role=\"tab\" aria-selected=\"false\" data-key=\"video\"\u003eVideo\u003c/button\u003e\n  \u003c/div\u003e\n  \u003c/div\u003e\n  \u003cdiv class=\"plot-rule\"\u003e\n    \u003cdiv class=\"legend\" id=\"legend\"\u003e\u003c/div\u003e\n    \u003cdiv class=\"plot-wrap\" id=\"chart\"\u003e\u003c/div\u003e\n  \u003c/div\u003e\n  \n  \u003c/div\u003e\n\u003c/main\u003e\n\u003cscript\u003e\n\nconst CHARTS = {\"document\":{\"title\":\"ParseBench vs. cost per 1K pages\",\"yLabel\":\"ParseBench score\",\"xLabel\":\"Cost per 1K pages (USD)\",\"attractiveLabel\":\"Attractive: score ≥ 70, price ≤ $2 / 1k pages\",\"attractiveMinScore\":70,\"attractiveMaxCost\":2,\"modelColumn\":\"Model\",\"costColumn\":\"Cost / 1K pages\",\"caption\":\"ParseBench 3-dimension average. Gateway sell from the 2026-08-30 catalog reprice (PR #280, output normalised to 500 tokens). Infinity Parser2 Pro: 3-dim average 79.4; overall 74.3 is the published ParseBench aggregate. Commercial prices from the ParseBench leaderboard.\",\"xMin\":0.1,\"xMax\":50,\"xTicks\":[0.1,0.5,1,5,10,50],\"yMin\":45,\"yMax\":92,\"yTicks\":[50,60,70,80,90],\"points\":[{\"id\":\"paddleocr-vl\",\"label\":\"PaddleOCR-VL\",\"group\":\"gateway\",\"score\":67.9,\"cost\":0.366,\"lx\":10,\"ly\":16,\"anchor\":\"start\",\"onFrontier\":true},{\"id\":\"glm-ocr\",\"label\":\"GLM-OCR\",\"group\":\"gateway\",\"score\":48.8,\"cost\":0.384,\"lx\":10,\"ly\":14,\"anchor\":\"start\"},{\"id\":\"unlimited-ocr\",\"label\":\"Unlimited-OCR\",\"group\":\"gateway\",\"score\":52.7,\"cost\":0.502,\"lx\":10,\"ly\":-10,\"anchor\":\"start\"},{\"id\":\"deepseek-ocr-2\",\"label\":\"DeepSeek-OCR-2\",\"group\":\"gateway\",\"score\":65.9,\"cost\":0.683,\"lx\":10,\"ly\":16,\"anchor\":\"start\"},{\"id\":\"dots-mocr\",\"label\":\"dots.mocr\",\"group\":\"gateway\",\"score\":74.1,\"cost\":0.765,\"lx\":12,\"ly\":18,\"anchor\":\"start\",\"onFrontier\":true},{\"id\":\"infinity-parser2-pro\",\"label\":\"Infinity Parser2 Pro\",\"group\":\"gateway\",\"score\":79.4,\"cost\":2,\"lx\":-10,\"ly\":-14,\"anchor\":\"end\",\"onFrontier\":true},{\"id\":\"llamaparse-ce\",\"label\":\"LlamaParse CE\",\"group\":\"market\",\"score\":80.4,\"cost\":3.75,\"lx\":8,\"ly\":-14,\"anchor\":\"start\",\"onFrontier\":true},{\"id\":\"mistral-ocr-4\",\"label\":\"Mistral OCR 4\",\"group\":\"market\",\"score\":76.6,\"cost\":4,\"lx\":0,\"ly\":18,\"anchor\":\"middle\"},{\"id\":\"extend-light\",\"label\":\"Extend Light\",\"group\":\"market\",\"score\":73.1,\"cost\":6.25,\"lx\":8,\"ly\":18,\"anchor\":\"start\"},{\"id\":\"gemini-3-flash\",\"label\":\"Gemini 3 Flash\",\"group\":\"market\",\"score\":78.1,\"cost\":6.5,\"lx\":8,\"ly\":-12,\"anchor\":\"start\"},{\"id\":\"azure-di\",\"label\":\"Azure DI\",\"group\":\"market\",\"score\":74.3,\"cost\":10,\"lx\":0,\"ly\":-12,\"anchor\":\"middle\"},{\"id\":\"aws-textract\",\"label\":\"AWS Textract\",\"group\":\"market\",\"score\":54.4,\"cost\":15,\"lx\":0,\"ly\":16,\"anchor\":\"middle\"},{\"id\":\"reducto\",\"label\":\"Reducto\",\"group\":\"market\",\"score\":71.1,\"cost\":23.8,\"lx\":0,\"ly\":16,\"anchor\":\"middle\"},{\"id\":\"extend-2\",\"label\":\"Extend (2.0)\",\"group\":\"market\",\"score\":76.6,\"cost\":25,\"lx\":-8,\"ly\":-10,\"anchor\":\"end\"}]},\"video\":{\"title\":\"MVBench vs. cost per 1K clips\",\"yLabel\":\"MVBench score\",\"xLabel\":\"Cost per 1K clips (USD)\",\"attractiveLabel\":\"Attractive: score ≥ 70, price ≤ $10 / 1k clips\",\"attractiveMinScore\":70,\"attractiveMaxCost\":10,\"modelColumn\":\"Model\",\"costColumn\":\"Cost / 1K clips\",\"caption\":\"MVBench accuracy (4,000 multiple-choice items, ~5–35 s clips). Gateway costs from catalog video $/hour converted to $/1k 20 s clips. Commercial dollars are published clip-cost family proxies.\",\"xMin\":0.1,\"xMax\":50,\"xTicks\":[0.1,0.5,1,5,10,50],\"yMin\":62,\"yMax\":86,\"yTicks\":[62,66,70,74,78,82,86],\"points\":[{\"id\":\"qwen3.5-0.8b\",\"label\":\"qwen3.5-0.8b\",\"group\":\"gateway\",\"score\":68.7,\"cost\":0.4,\"lx\":10,\"ly\":16,\"anchor\":\"start\",\"onFrontier\":true},{\"id\":\"muse-glimmer-30b\",\"label\":\"muse-glimmer-30b\",\"group\":\"gateway\",\"score\":74,\"cost\":1.62,\"lx\":0,\"ly\":-14,\"anchor\":\"middle\",\"onFrontier\":true},{\"id\":\"gemini-2.5-flash\",\"label\":\"Gemini 2.5 Flash\",\"group\":\"market\",\"score\":67,\"cost\":5,\"lx\":0,\"ly\":18,\"anchor\":\"middle\"},{\"id\":\"qwen3.8-27b\",\"label\":\"qwen3.8-27b\",\"group\":\"gateway\",\"score\":75.5,\"cost\":5.51,\"lx\":0,\"ly\":-14,\"anchor\":\"middle\",\"onFrontier\":true},{\"id\":\"gemini-3.7-flash\",\"label\":\"Gemini 3.7 Flash\",\"group\":\"market\",\"score\":82.2,\"cost\":9,\"lx\":0,\"ly\":-14,\"anchor\":\"middle\",\"onFrontier\":true},{\"id\":\"gemini-2.5-pro\",\"label\":\"Gemini 2.5 Pro\",\"group\":\"market\",\"score\":70.6,\"cost\":15,\"lx\":0,\"ly\":-14,\"anchor\":\"middle\"},{\"id\":\"gemini-3-pro\",\"label\":\"Gemini 3 Pro\",\"group\":\"market\",\"score\":70.4,\"cost\":20,\"lx\":8,\"ly\":16,\"anchor\":\"start\"},{\"id\":\"gpt-5\",\"label\":\"GPT-5\",\"group\":\"market\",\"score\":74.1,\"cost\":25,\"lx\":8,\"ly\":16,\"anchor\":\"start\"},{\"id\":\"gpt-5.6-terra\",\"label\":\"GPT-5.6 Terra\",\"group\":\"market\",\"score\":75,\"cost\":25,\"lx\":0,\"ly\":-14,\"anchor\":\"middle\"},{\"id\":\"claude-opus-4.8\",\"label\":\"Claude Opus 4.8\",\"group\":\"market\",\"score\":67.1,\"cost\":35,\"lx\":-8,\"ly\":16,\"anchor\":\"end\"}]}};\nlet activeKey = \"document\";\nconst SHOW_TABLE = false;\nconst WIDTH = 1020;\nconst HEIGHT = 662;\nconst PAD = { top: 20, right: 28, bottom: 68, left: 78 };\nconst AXIS_CHROME = \"\u003cg transform=\\\"rotate(-90 96 181)\\\"\u003e\u003ctext x=\\\"96\\\" y=\\\"181\\\" font-size=\\\"14\\\" font-weight=\\\"600\\\" fill=\\\"#3B82F6\\\"\u003eMORE ACCURATE\u003c/text\u003e\u003cg transform=\\\"translate(232 177)\\\" fill=\\\"none\\\" stroke=\\\"#3B82F6\\\" stroke-width=\\\"1.55\\\" stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\"\u003e\u003cpath d=\\\"M 0 0 H 9.6 M 6.3 -3.15 L 9.8 0 L 6.3 3.15\\\"/\u003e\u003c/g\u003e\u003c/g\u003e\u003cg transform=\\\"translate(88 578)\\\" fill=\\\"none\\\" stroke=\\\"#3B82F6\\\" stroke-width=\\\"1.55\\\" stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\"\u003e\u003cpath d=\\\"M 11 0 H 1.4 M 4.7 -3.15 L 1.2 0 L 4.7 3.15\\\"/\u003e\u003c/g\u003e\u003ctext x=\\\"103\\\" y=\\\"582\\\" font-size=\\\"14\\\" font-weight=\\\"600\\\" fill=\\\"#3B82F6\\\" text-anchor=\\\"start\\\"\u003eCHEAPER\u003c/text\u003e\u003ctext x=\\\"967\\\" y=\\\"582\\\" font-size=\\\"14\\\" font-weight=\\\"600\\\" fill=\\\"#3B82F6\\\" text-anchor=\\\"end\\\"\u003ePRICIER\u003c/text\u003e\u003cg transform=\\\"translate(971 578)\\\" fill=\\\"none\\\" stroke=\\\"#3B82F6\\\" stroke-width=\\\"1.55\\\" stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\"\u003e\u003cpath d=\\\"M 0 0 H 9.6 M 6.3 -3.15 L 9.8 0 L 6.3 3.15\\\"/\u003e\u003c/g\u003e\u003csvg x=\\\"940\\\" y=\\\"532.1538461538462\\\" width=\\\"44\\\" height=\\\"33.84615384615385\\\" viewBox=\\\"0 0 67.6 52\\\" aria-hidden=\\\"true\\\" style=\\\"pointer-events:none\\\"\u003e\u003cpath d=\\\"M 4.21 6.45 C 4.21 2.888 7.098 0 10.66 0 L 19.08 0 L 19.08 4.3 L 10.66 4.3 C 9.473 4.3 8.51 5.263 8.51 6.45 L 8.51 23.335 C 8.51 24.522 7.547 25.485 6.36 25.485 L 6.36 26.515 C 7.547 26.515 8.51 27.478 8.51 28.665 L 8.51 45.55 C 8.51 46.737 9.473 47.7 10.66 47.7 L 19.08 47.7 L 19.08 52 L 10.66 52 C 7.098 52 4.21 49.112 4.21 45.55 L 4.21 28.15 L 0 28.15 L 0 23.85 L 4.21 23.85 Z\\\" fill=\\\"#3B82F6\\\" fill-opacity=\\\"0.5\\\"/\u003e\u003cpath d=\\\"M 17.788 24.387 L 13.015 11.125 L 16.911 11.125 L 20.11 20.672 L 23.258 11.125 L 27.077 11.125 L 22.303 24.387 Z\\\" fill=\\\"#3B82F6\\\" fill-opacity=\\\"0.5\\\"/\u003e\u003cpath d=\\\"M 27.773 24.387 L 27.773 6.326 L 31.411 6.326 L 31.411 24.387 Z\\\" fill=\\\"#3B82F6\\\" fill-opacity=\\\"0.5\\\"/\u003e\u003cpath d=\\\"M 49.299 10.97 C 52.034 10.97 54.201 12.518 54.201 16.776 L 54.201 24.387 L 50.563 24.387 L 50.563 16.982 C 50.563 14.995 49.84 13.963 48.267 13.963 C 46.693 13.963 45.635 15.124 45.635 17.137 L 45.635 24.387 L 41.997 24.387 L 41.997 16.982 C 41.997 14.995 41.274 13.963 39.674 13.963 C 38.101 13.963 37.068 15.176 37.068 17.163 L 37.068 24.387 L 33.43 24.387 L 33.43 11.125 L 36.604 11.125 L 36.94 12.776 C 37.739 11.744 38.9 10.996 40.835 10.97 C 42.461 10.944 43.983 11.538 44.809 13.215 C 45.738 11.796 47.286 10.97 49.299 10.97 Z\\\" fill=\\\"#3B82F6\\\" fill-opacity=\\\"0.5\\\"/\u003e\u003cpath d=\\\"M 23.399 29.401 L 24.019 29.401 L 24.019 32.704 L 22.574 32.704 C 20.406 32.704 19.581 34.149 19.581 36.161 L 19.581 42.664 L 15.943 42.664 L 15.943 29.401 L 19.245 29.401 L 19.581 31.388 C 20.303 30.201 21.335 29.401 23.399 29.401 Z\\\" fill=\\\"#3B82F6\\\" fill-opacity=\\\"0.5\\\"/\u003e\u003cpath d=\\\"M 33.977 36.032 L 33.977 29.401 L 37.615 29.401 L 37.615 42.664 L 34.39 42.664 L 34.055 41.064 C 33.203 42.096 32.042 42.818 30.159 42.818 C 27.424 42.818 24.895 41.451 24.895 36.755 L 24.895 29.401 L 28.533 29.401 L 28.533 36.265 C 28.533 38.638 29.307 39.8 31.113 39.8 C 32.92 39.8 33.977 38.484 33.977 36.032 Z\\\" fill=\\\"#3B82F6\\\" fill-opacity=\\\"0.5\\\"/\u003e\u003cpath d=\\\"M 47.24 29.246 C 50.104 29.246 52.556 30.769 52.556 35.31 L 52.556 42.664 L 48.918 42.664 L 48.918 35.671 C 48.918 33.426 48.066 32.239 46.234 32.239 C 44.351 32.239 43.267 33.581 43.267 35.878 L 43.267 42.664 L 39.629 42.664 L 39.629 29.401 L 42.803 29.401 L 43.138 31.053 C 43.989 30.021 45.202 29.246 47.24 29.246 Z\\\" fill=\\\"#3B82F6\\\" fill-opacity=\\\"0.5\\\"/\u003e\u003cpath d=\\\"M 64.052 6.45 C 64.052 2.888 61.164 0 57.602 0 L 49.182 0 L 49.182 4.3 L 57.602 4.3 C 58.789 4.3 59.752 5.263 59.752 6.45 L 59.752 23.335 C 59.752 24.522 60.715 25.485 61.902 25.485 L 61.902 26.515 C 60.715 26.515 59.752 27.478 59.752 28.665 L 59.752 45.55 C 59.752 46.737 58.789 47.7 57.602 47.7 L 49.182 47.7 L 49.182 52 L 57.602 52 C 61.164 52 64.052 49.112 64.052 45.55 L 64.052 28.15 L 68.262 28.15 L 68.262 23.85 L 64.052 23.85 Z\\\" fill=\\\"#3B82F6\\\" fill-opacity=\\\"0.5\\\"/\u003e\u003c/svg\u003e\";\n\nfunction clamp(n, min, max) { return Math.min(max, Math.max(min, n)); }\nfunction escapeSvgText(value) {\n  return String(value).replace(/\u0026/g, \"\u0026amp;\").replace(/\u003c/g, \"\u0026lt;\").replace(/\u003e/g, \"\u0026gt;\");\n}\nfunction escapeAttr(value) { return escapeSvgText(value).replace(/\"/g, \"\u0026quot;\"); }\nfunction formatCost(value) {\n  const rounded = Math.round(value * 1000) / 1000;\n  if (Number.isInteger(rounded)) return \"$\" + rounded.toFixed(0);\n  const cents = Math.round(value * 100) / 100;\n  if (Math.abs(cents - rounded) \u003c 1e-9) return \"$\" + cents.toFixed(2);\n  return \"$\" + rounded.toFixed(3);\n}\nfunction formatScore(value) {\n  return Number.isInteger(value) ? value + \"%\" : value.toFixed(1) + \"%\";\n}\nfunction dominates(a, b) {\n  return a.score \u003e= b.score \u0026\u0026 a.cost \u003c= b.cost \u0026\u0026 (a.score \u003e b.score || a.cost \u003c b.cost);\n}\nfunction sortByParetoFrontier(points) {\n  var remaining = points.slice();\n  var ranked = [];\n  while (remaining.length) {\n    var front = remaining.filter(function (p) {\n      return !remaining.some(function (q) { return q.id !== p.id \u0026\u0026 dominates(q, p); });\n    }).sort(function (a, b) { return a.cost - b.cost || b.score - a.score; });\n    var frontIds = {};\n    front.forEach(function (p) { frontIds[p.id] = true; });\n    ranked = ranked.concat(front);\n    remaining = remaining.filter(function (p) { return !frontIds[p.id]; });\n  }\n  return ranked;\n}\nfunction xOf(chart, cost) {\n  const t = (Math.log(cost) - Math.log(chart.xMin)) / (Math.log(chart.xMax) - Math.log(chart.xMin));\n  return PAD.left + clamp(t, 0, 1) * (WIDTH - PAD.left - PAD.right);\n}\nfunction yOf(chart, score) {\n  const t = (score - chart.yMin) / (chart.yMax - chart.yMin);\n  return PAD.top + (1 - clamp(t, 0, 1)) * (HEIGHT - PAD.top - PAD.bottom);\n}\n\nfunction renderLegend(chart) {\n  const legend = document.getElementById(\"legend\");\n  if (!legend) return;\n  legend.innerHTML =\n    '\u003cbutton class=\"legend-filter\" type=\"button\" aria-pressed=\"false\" data-filter-value=\"gateway\"\u003e\u003ci class=\"swatch\" style=\"background:#1265FF\"\u003e\u003c/i\u003eGateway\u003c/button\u003e' +\n    '\u003cbutton class=\"legend-filter\" type=\"button\" aria-pressed=\"false\" data-filter-value=\"market\"\u003e\u003ci class=\"swatch\" style=\"background:#94A3B8\"\u003e\u003c/i\u003eMarket\u003c/button\u003e' +\n    '\u003cspan class=\"legend-item\"\u003e\u003ci class=\"swatch swatch-attractive\"\u003e\u003c/i\u003e' + escapeSvgText(chart.attractiveLabel) + '\u003c/span\u003e';\n}\n\nfunction renderScatter(chart) {\n  const plotW = WIDTH - PAD.left - PAD.right;\n  const plotH = HEIGHT - PAD.top - PAD.bottom;\n  const description = chart.points.map((p) =\u003e p.label + \" \" + formatScore(p.score) + \" at \" + formatCost(p.cost)).join(\"; \");\n  const titleEl = document.getElementById(\"chart-title\");\n  if (titleEl) titleEl.textContent = chart.title;\n  renderLegend(chart);\n\n  let svg = '\u003csvg viewBox=\"0 0 ' + WIDTH + ' ' + HEIGHT + '\" width=\"100%\" height=\"auto\" preserveAspectRatio=\"xMidYMid meet\" role=\"img\" aria-label=\"' + escapeAttr(chart.title) + '\" aria-describedby=\"chart-desc\"\u003e';\n  svg += '\u003cdesc id=\"chart-desc\"\u003e' + escapeSvgText(description) + '\u003c/desc\u003e';\n  chart.yTicks.forEach((tick) =\u003e {\n    const y = yOf(chart, tick);\n    svg += '\u003cline x1=\"' + PAD.left + '\" y1=\"' + y + '\" x2=\"' + (PAD.left + plotW) + '\" y2=\"' + y + '\" stroke=\"#EEF2F7\" stroke-width=\"1\"/\u003e';\n  });\n  chart.xTicks.forEach((tick) =\u003e {\n    const x = xOf(chart, tick);\n    svg += '\u003cline x1=\"' + x + '\" y1=\"' + PAD.top + '\" x2=\"' + x + '\" y2=\"' + (PAD.top + plotH) + '\" stroke=\"#EEF2F7\" stroke-width=\"1\"/\u003e';\n  });\n  const attractiveX = xOf(chart, Math.min(chart.attractiveMaxCost, chart.xMax));\n  const attractiveTop = yOf(chart, chart.yMax);\n  const attractiveBottom = yOf(chart, chart.attractiveMinScore);\n  svg += '\u003crect x=\"' + PAD.left + '\" y=\"' + attractiveTop + '\" width=\"' + Math.max(0, attractiveX - PAD.left) + '\" height=\"' + Math.max(0, attractiveBottom - attractiveTop) + '\" fill=\"#1265FF\" fill-opacity=\"0.07\" pointer-events=\"none\"/\u003e';\n  chart.yTicks.forEach((tick) =\u003e {\n    const y = yOf(chart, tick);\n    svg += '\u003ctext x=\"' + (PAD.left - 10) + '\" y=\"' + (y + 4) + '\" font-size=\"15\" fill=\"#9CA3AF\" text-anchor=\"end\"\u003e' + tick + '%\u003c/text\u003e';\n  });\n  chart.xTicks.forEach((tick) =\u003e {\n    const x = xOf(chart, tick);\n    svg += '\u003ctext x=\"' + x + '\" y=\"' + (PAD.top + plotH + 24) + '\" font-size=\"15\" fill=\"#9CA3AF\" text-anchor=\"middle\"\u003e$' + tick + '\u003c/text\u003e';\n  });\n  svg += '\u003cline x1=\"' + PAD.left + '\" y1=\"' + (PAD.top + plotH) + '\" x2=\"' + (PAD.left + plotW) + '\" y2=\"' + (PAD.top + plotH) + '\" stroke=\"#E5E7EB\" stroke-width=\"1\"/\u003e';\n  svg += '\u003cline x1=\"' + PAD.left + '\" y1=\"' + PAD.top + '\" x2=\"' + PAD.left + '\" y2=\"' + (PAD.top + plotH) + '\" stroke=\"#E5E7EB\" stroke-width=\"1\"/\u003e';\n  svg += '\u003ctext x=\"16\" y=\"' + (PAD.top + plotH / 2) + '\" font-size=\"13.5\" font-weight=\"500\" letter-spacing=\"0.12em\" fill=\"#9CA3AF\" text-anchor=\"middle\" transform=\"rotate(-90 16 ' + (PAD.top + plotH / 2) + ')\"\u003e' + escapeSvgText(chart.yLabel.toUpperCase()) + '\u003c/text\u003e';\n  svg += '\u003ctext x=\"' + (PAD.left + plotW / 2) + '\" y=\"' + (PAD.top + plotH + 52) + '\" font-size=\"13.5\" font-weight=\"500\" letter-spacing=\"0.12em\" fill=\"#9CA3AF\" text-anchor=\"middle\"\u003e' + escapeSvgText(chart.xLabel.toUpperCase()) + '\u003c/text\u003e';\n  svg += AXIS_CHROME;\n\n  chart.points.forEach((point) =\u003e {\n    const x = xOf(chart, point.cost);\n    const y = yOf(chart, point.score);\n    const isGateway = point.group === \"gateway\";\n    const fill = isGateway ? \"#1265FF\" : \"#94A3B8\";\n    const labelFill = isGateway ? \"#0F172A\" : \"#64748B\";\n    const r = isGateway ? 6.5 : 5.5;\n    svg += '\u003cg class=\"dot\" tabindex=\"0\" role=\"button\" aria-pressed=\"false\" data-id=\"' + escapeAttr(point.id) + '\" data-category=\"' + escapeAttr(point.label) + '\" data-model=\"' + escapeAttr(isGateway ? \"Gateway\" : \"Market\") + '\" data-value=\"' + escapeAttr(formatScore(point.score) + \" · \" + formatCost(point.cost)) + '\" data-color=\"' + fill + '\"\u003e';\n    svg += '\u003ccircle cx=\"' + x + '\" cy=\"' + y + '\" r=\"14\" fill=\"transparent\"/\u003e';\n    svg += '\u003ccircle cx=\"' + x + '\" cy=\"' + y + '\" r=\"' + r + '\" fill=\"' + fill + '\" stroke=\"#fff\" stroke-width=\"1.5\"/\u003e';\n    svg += '\u003ctext class=\"point-label\" x=\"' + (x + point.lx) + '\" y=\"' + (y + point.ly) + '\" font-size=\"16\" font-weight=\"' + (isGateway ? 600 : 500) + '\" fill=\"' + labelFill + '\" text-anchor=\"' + point.anchor + '\"\u003e' + escapeSvgText(point.label) + '\u003c/text\u003e';\n    svg += '\u003c/g\u003e';\n  });\n  svg += '\u003c/svg\u003e';\n  document.getElementById(\"chart\").innerHTML = svg;\n\n  const tableRoot = document.getElementById(\"table\");\n  if (SHOW_TABLE \u0026\u0026 tableRoot) {\n    const rows = sortByParetoFrontier(chart.points);\n    const modelCol = chart.modelColumn || \"Model\";\n    const costCol = chart.costColumn || \"Cost\";\n    let table = '\u003ctable class=\"data-table\" id=\"data-table\"\u003e\u003cthead\u003e\u003ctr\u003e';\n    table += '\u003cth scope=\"col\"\u003e' + escapeSvgText(modelCol) + '\u003c/th\u003e';\n    table += '\u003cth scope=\"col\"\u003eAccuracy\u003c/th\u003e';\n    table += '\u003cth scope=\"col\"\u003e' + escapeSvgText(costCol) + '\u003c/th\u003e';\n    table += '\u003c/tr\u003e\u003c/thead\u003e\u003ctbody\u003e';\n    rows.forEach((point) =\u003e {\n      const isGateway = point.group === \"gateway\";\n      const fill = isGateway ? \"#1265FF\" : \"#0F172A\";\n      table += '\u003ctr data-id=\"' + escapeAttr(point.id) + '\"\u003e';\n      table += '\u003ctd\u003e\u003cspan class=\"model-cell\" style=\"color:' + fill + '\"\u003e' + escapeSvgText(point.label) + '\u003c/span\u003e\u003c/td\u003e';\n      table += '\u003ctd class=\"num\"\u003e' + formatScore(point.score) + '\u003c/td\u003e';\n      table += '\u003ctd class=\"num\"\u003e' + formatCost(point.cost) + '\u003c/td\u003e';\n      table += '\u003c/tr\u003e';\n    });\n    table += '\u003c/tbody\u003e\u003c/table\u003e';\n    tableRoot.innerHTML = table;\n  }\n}\n\nfunction setActive(id) {\n  const svg = document.querySelector(\"#chart svg\");\n  const table = document.getElementById(\"data-table\");\n  if (!svg) return;\n  svg.classList.toggle(\"has-active\", Boolean(id));\n  if (table) table.classList.toggle(\"has-active\", Boolean(id));\n  svg.querySelectorAll(\".dot\").forEach((dot) =\u003e {\n    const on = Boolean(id) \u0026\u0026 dot.dataset.id === id;\n    dot.classList.toggle(\"is-active\", on);\n    dot.setAttribute(\"aria-pressed\", on ? \"true\" : \"false\");\n  });\n  if (table) {\n    table.querySelectorAll(\"tbody tr\").forEach((row) =\u003e {\n      row.classList.toggle(\"is-active\", Boolean(id) \u0026\u0026 row.dataset.id === id);\n    });\n  }\n}\n\nfunction installInteractions() {\n  let pinned = null;\n  let filter = null;\n  function applyFilter() {\n    const svg = document.querySelector(\"#chart svg\");\n    if (!svg) return;\n    svg.classList.toggle(\"has-filter\", Boolean(filter));\n    svg.querySelectorAll(\".dot\").forEach((dot) =\u003e {\n      const group = dot.dataset.model === \"Gateway\" ? \"gateway\" : \"market\";\n      dot.classList.toggle(\"is-filtered\", !filter || group === filter);\n    });\n    document.querySelectorAll(\"#legend .legend-filter\").forEach((btn) =\u003e {\n      const on = btn.dataset.filterValue === filter;\n      btn.classList.toggle(\"is-active\", on);\n      btn.setAttribute(\"aria-pressed\", on ? \"true\" : \"false\");\n    });\n  }\n  function bind() {\n    const svg = document.querySelector(\"#chart svg\");\n    const table = document.getElementById(\"data-table\");\n    if (!svg) return;\n    svg.querySelectorAll(\".dot\").forEach((dot) =\u003e {\n      dot.addEventListener(\"pointerenter\", () =\u003e { if (!pinned) setActive(dot.dataset.id); });\n      dot.addEventListener(\"pointerleave\", () =\u003e { if (!pinned) setActive(null); });\n      dot.addEventListener(\"click\", (event) =\u003e {\n        event.stopPropagation();\n        pinned = pinned === dot.dataset.id ? null : dot.dataset.id;\n        setActive(pinned);\n      });\n    });\n    if (table) {\n      table.querySelectorAll(\"tbody tr\").forEach((row) =\u003e {\n        row.addEventListener(\"pointerenter\", () =\u003e { if (!pinned) setActive(row.dataset.id); });\n        row.addEventListener(\"pointerleave\", () =\u003e { if (!pinned) setActive(null); });\n        row.addEventListener(\"click\", (event) =\u003e {\n          event.stopPropagation();\n          pinned = pinned === row.dataset.id ? null : row.dataset.id;\n          setActive(pinned);\n        });\n      });\n    }\n    applyFilter();\n  }\n  document.querySelectorAll(\".switcher button\").forEach((btn) =\u003e {\n    btn.addEventListener(\"click\", (event) =\u003e {\n      event.stopPropagation();\n      const key = btn.dataset.key;\n      if (!CHARTS[key]) return;\n      activeKey = key;\n      pinned = null;\n      filter = null;\n      document.querySelectorAll(\".switcher button\").forEach((other) =\u003e {\n        const on = other.dataset.key === key;\n        other.classList.toggle(\"is-active\", on);\n        other.setAttribute(\"aria-selected\", on ? \"true\" : \"false\");\n      });\n      renderScatter(CHARTS[key]);\n      bind();\n    });\n  });\n  const legend = document.getElementById(\"legend\");\n  if (legend) {\n    legend.addEventListener(\"click\", (event) =\u003e {\n      const btn = event.target.closest(\".legend-filter\");\n      if (!btn) return;\n      event.stopPropagation();\n      const value = btn.dataset.filterValue;\n      filter = filter === value ? null : value;\n      applyFilter();\n    });\n  }\n  document.addEventListener(\"click\", () =\u003e { pinned = null; setActive(null); });\n  document.addEventListener(\"keydown\", (event) =\u003e { if (event.key === \"Escape\") { pinned = null; setActive(null); } });\n  bind();\n}\n\nrenderScatter(CHARTS[activeKey]);\ninstallInteractions();\n\n\u003c/script\u003e\n\u003c/body\u003e\n\u003c/html\u003e"])</script><script>self.__next_f.push([1,"44:[\"$\",\"$L5e\",\"a73d6462cc95\",{\"html\":\"$5f\",\"title\":\"Gateway cost vs accuracy (Document / Video)\",\"height\":810,\"caption\":\"$undefined\",\"framed\":false}]\n45:[\"$\",\"p\",\"098cf09fc081\",{\"className\":\"my-5 text-blog-body text-blog-article\",\"children\":[\"On documents, two models land in the optimal quadrant, score 70 or better under $3 per thousand pages, and both are open-weight models on the Gateway. \",[\"$\",\"code\",\"6f8c272581e7\",{\"className\":\"rounded-md bg-primary/10 px-1.5 py-0.5 font-mono text-code text-primary\",\"children\":[\"infly/infinity-parser2-pro\"]}],\" scores about 79 at roughly $2.10 (per 1K pages), and \",[\"$\",\"code\",\"60fea3335129\",{\"className\":\"rounded-md bg-primary/10 px-1.5 py-0.5 font-mono text-code text-primary\",\"children\":[\"dots.mocr\"]}],\" about 74 at roughly $0.78. No commercial parser makes it into that box.\"]}]\n46:[\"$\",\"p\",\"ed012ec3e499\",{\"className\":\"my-5 text-blog-body text-blog-article\",\"children\":[[\"$\",\"code\",\"a37e879c65bd\",{\"className\":\"rounded-md bg-primary/10 px-1.5 py-0.5 font-mono text-code text-primary\",\"children\":[\"infinity-parser2-pro\"]}],\" also matches or beats 7 of the 8 commercial parsers on the chart, including Gemini 3 Flash, Mistral OCR 4, Azure DI and Extend 2.0, at 2-12x less. AWS Textract sits about 24 points lower and costs 7x more. The one parser above it is LlamaParse in its cost-effective tier at roughly 80.5, a point and a half of accuracy for about twice the price.\"]}]\n47:[\"$\",\"p\",\"864ec0bbcea3\",{\"className\":\"my-5 text-blog-body text-blog-article\",\"children\":[\"Switch to the video benchmark and the picture is similar. Three models clear 70 under $10 per thousand clips, and two are open-weight models on the Gateway: \",[\"$\",\"code\",\"65e0cbcfc6be\",{\"className\":\"rounded-md bg-primary/10 px-1.5 py-0.5 font-mono text-code text-primary\",\"children\":[\"qwen3.8-27b\"]}],\" at about 75.5 for roughly $5.50 (per 1K clips), and \",[\"$\",\"code\",\"c3c6fa63ddab\",{\"className\":\"rounded-md bg-primary/10 px-1.5 py-0.5 font-mono text-code text-primary\",\"children\":[\"muse-glimmer-30b\"]}],\" at about 74 for roughly $1.50. \",[\"$\",\"code\",\"1754830c82da\",{\"className\":\"rounded-md bg-primary/10 px-1.5 py-0.5 font-mono text-code text-primary\",\"children\":[\"qwen3.8-27b\"]}],\" lands above GPT-5.6 Terra, while \",[\"$\",\"code\",\"62b97b7dedec\",{\"className\":\"rounded-md bg-primary/10 px-1.5 py-0.5 font-mono text-code text-primary\",\"children\":[\"muse-glimmer-30b\"]}],\" matches GPT-5, at a fraction of the $22 those cost. Gemini 3.7 Flash tops the chart at about 82, eight points up and roughly 6x the price of \",[\"$\",\"code\",\"d4a7fe274897\",{\"className\":\"rounded-md bg-primary/10 px-1.5 py-0.5 font-mono text-code text-primary\",\"children\":[\"muse-glimmer-30b\"]}],\".\"]}]\n48:[\"$\",\"p\",\"053a7c4e0da2\",{\"className\":\"my-5 text-blog-body text-blog-article\",\"children\":[\"In other words: open-weight models are competitive on accuracy while often being significantly cheaper. Which point on that frontier is yours depends on your use case, and the Gateway is what makes switching between them easy.\"]}]\n49:[\"$\",\"h2\",\"a9c2224b1002\",{\"id\":\"choosing-the-model-is-the-hard-part\",\"className\":\"mt-10 mb-1 scroll-mt-28 font-sans text-blog-h2 font-semibold text-primary-mid\",\"children\":[\"Choosing the model is the hard part\"]}]\n4a:[\"$\",\"p\",\"2d93173a7d17\",{\"className\":\"my-5 text-blog-body text-blog-article\",\"children\":[\"Why does anyone send documents to a frontier API? Because no single small model wins everywhere. Healthcare forms, construction drawings and legal contracts have different winners, and the winner changes with scan quality, language and layout density.\"]}]\n4b:[\"$\",\"p\",\"751da96c3208\",{\"className\":\"my-5 text-blog-body text-blog-article\",\"children\":[\"Evaluating candidates is expensive for reasons unrelated to the models. ONNX, GGUF, and PyTorch checkpoints need different runtimes, and some can't share a process at all. Every model returns a different output shape, so each candidate needs its own parser. And you run out of VRAM long before you run out of candidates. So teams do the rational thing: pick the one API that handles everything and absorb the markup.\"]}]\n4c:"])</script><script>self.__next_f.push([1,"[\"$\",\"p\",\"add70f80d3f2\",{\"className\":\"my-5 text-blog-body text-blog-article\",\"children\":[\"We know because we hit it first. Orion tool calls each request to multiple underlying models because no single model leads across localization, segmentation, and video.\"]}]\n4d:[\"$\",\"p\",\"24d695f9312f\",{\"className\":\"my-5 text-blog-body text-blog-article\",\"children\":[\"The Gateway's product isn't any single model. It's making the choice reversible. When every model runs on one API, changing models is as simple as changing a parameter: same endpoint, same request shape, same output contract.\"]}]\n4e:[\"$\",\"figure\",\"c43b4c7037ef\",{\"className\":\"my-6 overflow-hidden rounded-xl border border-border bg-white\",\"children\":[\"$\",\"div\",null,{\"className\":\"blog-code-shiki overflow-x-auto\",\"dangerouslySetInnerHTML\":{\"__html\":\"\u003cpre class=\\\"shiki github-light\\\" style=\\\"background-color:#fff;color:#24292e\\\" tabindex=\\\"0\\\"\u003e\u003ccode\u003e\u003cspan class=\\\"line\\\"\u003e\u003cspan style=\\\"color:#E36209\\\"\u003e-\u003c/span\u003e\u003cspan style=\\\"color:#24292E\\\"\u003e model=\\\"rednote-hilab/dots.mocr\\\",\u003c/span\u003e\u003c/span\u003e\\n\u003cspan class=\\\"line\\\"\u003e\u003cspan style=\\\"color:#E36209\\\"\u003e+\u003c/span\u003e\u003cspan style=\\\"color:#24292E\\\"\u003e model=\\\"infly/infinity-parser2-pro\\\",\u003c/span\u003e\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e\"}}]}]\n4f:[\"$\",\"p\",\"cc54e7ee614d\",{\"className\":\"my-5 text-blog-body text-blog-article\",\"children\":[\"Everything else in your code stays identical.\"]}]\n50:[\"$\",\"h2\",\"acc98b2cd6bf\",{\"id\":\"what-the-gateway-is\",\"className\":\"mt-10 mb-1 scroll-mt-28 font-sans text-blog-h2 font-semibold text-primary-mid\",\"children\":[\"What the Gateway is\"]}]\n51:[\"$\",\"p\",\"e5a81cde714e\",{\"className\":\"my-5 text-blog-body text-blog-article\",\"children\":[\"Try the models in the \",[\"$\",\"a\",\"679e266911f2\",{\"href\":\"https://docs.vlm.run/gateway/models\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"className\":\"text-navy underline decoration-primary/30 underline-offset-[3px] transition-colors hover:text-primary\",\"children\":[\"Gateway model catalog\"]}],\" today. Alongside the OCR models above, it covers layout detection with reading order, captioning and detection, visual chat over images, video and PDFs, embeddings, and audio transcription. Each model is served behind the standard \",[\"$\",\"code\",\"ec32968b140a\",{\"className\":\"rounded-md bg-primary/10 px-1.5 py-0.5 font-mono text-code text-primary\",\"children\":[\"chat.completions\"]}],\", \",[\"$\",\"code\",\"e0e51e582e1b\",{\"className\":\"rounded-md bg-primary/10 px-1.5 py-0.5 font-mono text-code text-primary\",\"children\":[\"embeddings\"]}],\", or \",[\"$\",\"code\",\"f236310a67b5\",{\"className\":\"rounded-md bg-primary/10 px-1.5 py-0.5 font-mono text-code text-primary\",\"children\":[\"transcriptions\"]}],\" interface.\"]}]\n52:[\"$\",\"p\",\"def91e166569\",{\"className\":\"my-5 text-blog-body text-blog-article\",\"children\":[\"Five runtimes sit behind one router, each model an isolated plugin, so conflicting dependency stacks coexist. Models stay resident rather than cold-starting per request, which is what keeps latency predictable and prices low.\"]}]\n53:[\"$\",\"p\",\"dd10da1b5aac\",{\"className\":\"my-5 text-blog-body text-blog-article\",\"children\":[\"The Gateway also handles the work around the model. PDFs are rasterized page by page across parallel workers, with \",[\"$\",\"code\",\"ec4780a2ac82\",{\"className\":\"rounded-md bg-primary/10 px-1.5 py-0.5 font-mono text-code text-primary\",\"children\":[\"document_dpi\"]}],\", \",[\"$\",\"code\",\"a62436bc9bd4\",{\"className\":\"rounded-md bg-primary/10 px-1.5 py-0.5 font-mono text-code text-primary\",\"children\":[\"document_pages\"]}],\", and \",[\"$\",\"code\",\"37ed804337d0\",{\"className\":\"rounded-md bg-primary/10 px-1.5 py-0.5 font-mono text-code text-primary\",\"children\":[\"stream: true\"]}],\" controlling raster quality, page range, and incremental delivery. A page that fails is retried or marked rather than killing the document. Output comes back normalized: markdown with page markers, a unified bounding-box schema, self-describing JSON. Every response carries metered \",[\"$\",\"code\",\"6beb6ccd7bb1\",{\"className\":\"rounded-md bg-primary/10 px-1.5 py-0.5 font-mono text-code text-primary\",\"children\":[\"usage.cost\"]}],\" and an \",[\"$\",\"code\",\"8ba55e443eb5\",{\"className\":\"rounded-md "])</script><script>self.__next_f.push([1,"bg-primary/10 px-1.5 py-0.5 font-mono text-code text-primary\",\"children\":[\"x-request-id\"]}],\". The output contract belongs to the Gateway, not the model. That's what makes the one-line swap real.\"]}]\n54:[\"$\",\"h2\",\"028431d96b1d\",{\"id\":\"build-your-own-agents\",\"className\":\"mt-10 mb-1 scroll-mt-28 font-sans text-blog-h2 font-semibold text-primary-mid\",\"children\":[\"Build your own agents\"]}]\n55:[\"$\",\"p\",\"e674096c232b\",{\"className\":\"my-5 text-blog-body text-blog-article\",\"children\":[\"An MCP server at \",[\"$\",\"code\",\"ec7c17ce2cb4\",{\"className\":\"rounded-md bg-primary/10 px-1.5 py-0.5 font-mono text-code text-primary\",\"children\":[\"https://gateway.vlm.run/mcp\"]}],\" exposes \",[\"$\",\"code\",\"490b19e8f23c\",{\"className\":\"rounded-md bg-primary/10 px-1.5 py-0.5 font-mono text-code text-primary\",\"children\":[\"read_document\"]}],\", \",[\"$\",\"code\",\"d92d52e6ab75\",{\"className\":\"rounded-md bg-primary/10 px-1.5 py-0.5 font-mono text-code text-primary\",\"children\":[\"read_video\"]}],\", and \",[\"$\",\"code\",\"23433ec2d2e2\",{\"className\":\"rounded-md bg-primary/10 px-1.5 py-0.5 font-mono text-code text-primary\",\"children\":[\"read_audio\"]}],\", so any MCP-compatible framework (Pydantic AI, LangChain, Mastra, OpenAI Agents SDK, Claude Code) consumes visual content through the same pipeline, auth, and billing. Most of the models in our catalog is open-weight: which means you can run it in your VPC, fine-tune it on your data, own the weights. Enterprise deployments will support BYOK, private VPC, and BAAs for HIPAA.\"]}]\n56:[\"$\",\"h2\",\"7fd83e523f3b\",{\"id\":\"get-started\",\"className\":\"mt-10 mb-1 scroll-mt-28 font-sans text-blog-h2 font-semibold text-primary-mid\",\"children\":[\"Get started\"]}]\n57:[\"$\",\"p\",\"b55b5dadd60b\",{\"className\":\"my-5 text-blog-body text-blog-article\",\"children\":[\"The visual frontier just moved. Your AI bill should too.\"]}]\n58:[\"$\",\"p\",\"eee5a40ca054\",{\"className\":\"my-5 text-blog-body text-blog-article\",\"children\":[\"All endpoints support anonymous access with IP-based rate limits, the Gateway is free during alpha, and the published prices are already live, so the cost signals you build against today are the ones you'll use in production. Point your OpenAI SDK at \",[\"$\",\"code\",\"87506c535dcb\",{\"className\":\"rounded-md bg-primary/10 px-1.5 py-0.5 font-mono text-code text-primary\",\"children\":[\"https://gateway.vlm.run/v1/openai\"]}],\", or list the catalog from your terminal:\"]}]\n60:Tc4c,"])</script><script>self.__next_f.push([1,"\u003cpre class=\"shiki github-light\" style=\"background-color:#fff;color:#24292e\" tabindex=\"0\"\u003e\u003ccode\u003e\u003cspan class=\"line\"\u003e\u003cspan style=\"color:#6A737D\"\u003e# List the models on the gateway\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan style=\"color:#6F42C1\"\u003euvx\u003c/span\u003e\u003cspan style=\"color:#032F62\"\u003e vlmrun\u003c/span\u003e\u003cspan style=\"color:#032F62\"\u003e gw\u003c/span\u003e\u003cspan style=\"color:#032F62\"\u003e models\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan style=\"color:#6A737D\"\u003e# Run GLM-OCR, dots.mocr, Deepseek OCR 2 on a document\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan style=\"color:#6F42C1\"\u003euvx\u003c/span\u003e\u003cspan style=\"color:#032F62\"\u003e vlmrun\u003c/span\u003e\u003cspan style=\"color:#032F62\"\u003e gw\u003c/span\u003e\u003cspan style=\"color:#032F62\"\u003e chat\u003c/span\u003e\u003cspan style=\"color:#005CC5\"\u003e -m\u003c/span\u003e\u003cspan style=\"color:#032F62\"\u003e glm-ocr\u003c/span\u003e\u003cspan style=\"color:#D73A49\"\u003e \u0026#x3C;\u003c/span\u003e\u003cspan style=\"color:#032F62\"\u003edo\u003c/span\u003e\u003cspan style=\"color:#24292E\"\u003ec\u003c/span\u003e\u003cspan style=\"color:#D73A49\"\u003e\u003e\u003c/span\u003e\u003cspan style=\"color:#032F62\"\u003e.pdf\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan style=\"color:#6F42C1\"\u003euvx\u003c/span\u003e\u003cspan style=\"color:#032F62\"\u003e vlmrun\u003c/span\u003e\u003cspan style=\"color:#032F62\"\u003e gw\u003c/span\u003e\u003cspan style=\"color:#032F62\"\u003e chat\u003c/span\u003e\u003cspan style=\"color:#005CC5\"\u003e -m\u003c/span\u003e\u003cspan style=\"color:#032F62\"\u003e dots.mocr\u003c/span\u003e\u003cspan style=\"color:#D73A49\"\u003e \u0026#x3C;\u003c/span\u003e\u003cspan style=\"color:#032F62\"\u003edo\u003c/span\u003e\u003cspan style=\"color:#24292E\"\u003ec\u003c/span\u003e\u003cspan style=\"color:#D73A49\"\u003e\u003e\u003c/span\u003e\u003cspan style=\"color:#032F62\"\u003e.pdf\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan style=\"color:#6F42C1\"\u003euvx\u003c/span\u003e\u003cspan style=\"color:#032F62\"\u003e vlmrun\u003c/span\u003e\u003cspan style=\"color:#032F62\"\u003e gw\u003c/span\u003e\u003cspan style=\"color:#032F62\"\u003e chat\u003c/span\u003e\u003cspan style=\"color:#005CC5\"\u003e -m\u003c/span\u003e\u003cspan style=\"color:#032F62\"\u003e deepseek-ocr-2\u003c/span\u003e\u003cspan style=\"color:#D73A49\"\u003e \u0026#x3C;\u003c/span\u003e\u003cspan style=\"color:#032F62\"\u003edo\u003c/span\u003e\u003cspan style=\"color:#24292E\"\u003ec\u003c/span\u003e\u003cspan style=\"color:#D73A49\"\u003e\u003e\u003c/span\u003e\u003cspan style=\"color:#032F62\"\u003e.pdf\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan style=\"color:#6A737D\"\u003e# Run qwen3.5-0.8b on image / video\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan style=\"color:#6F42C1\"\u003euvx\u003c/span\u003e\u003cspan style=\"color:#032F62\"\u003e vlmrun\u003c/span\u003e\u003cspan style=\"color:#032F62\"\u003e gw\u003c/span\u003e\u003cspan style=\"color:#032F62\"\u003e chat\u003c/span\u003e\u003cspan style=\"color:#005CC5\"\u003e -m\u003c/span\u003e\u003cspan style=\"color:#032F62\"\u003e qwen3.5-0.8b\u003c/span\u003e\u003cspan style=\"color:#005CC5\"\u003e  -p\u003c/span\u003e\u003cspan style=\"color:#032F62\"\u003e \"describe the image\"\u003c/span\u003e\u003cspan style=\"color:#D73A49\"\u003e \u0026#x3C;\u003c/span\u003e\u003cspan style=\"color:#032F62\"\u003eimag\u003c/span\u003e\u003cspan style=\"color:#24292E\"\u003ee\u003c/span\u003e\u003cspan style=\"color:#D73A49\"\u003e\u003e\u003c/span\u003e\u003cspan style=\"color:#032F62\"\u003e.png\u003c/span\u003e\u003c/span\u003e\n\u003cspan class=\"line\"\u003e\u003cspan style=\"color:#6F42C1\"\u003euvx\u003c/span\u003e\u003cspan style=\"color:#032F62\"\u003e vlmrun\u003c/span\u003e\u003cspan style=\"color:#032F62\"\u003e gw\u003c/span\u003e\u003cspan style=\"color:#032F62\"\u003e chat\u003c/span\u003e\u003cspan style=\"color:#005CC5\"\u003e -m\u003c/span\u003e\u003cspan style=\"color:#032F62\"\u003e qwen3.5-0.8b\u003c/span\u003e\u003cspan style=\"color:#005CC5\"\u003e  -p\u003c/span\u003e\u003cspan style=\"color:#032F62\"\u003e \"describe the video\"\u003c/span\u003e\u003cspan style=\"color:#D73A49\"\u003e \u0026#x3C;\u003c/span\u003e\u003cspan style=\"color:#032F62\"\u003evide\u003c/span\u003e\u003cspan style=\"color:#24292E\"\u003eo\u003c/span\u003e\u003cspan style=\"color:#D73A49\"\u003e\u003e\u003c/span\u003e\u003cspan style=\"color:#032F62\"\u003e.mp4\u003c/span\u003e\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e"])</script><script>self.__next_f.push([1,"59:[\"$\",\"figure\",\"3053dcef5676\",{\"className\":\"my-6 overflow-hidden rounded-xl border border-border bg-white\",\"children\":[\"$\",\"div\",null,{\"className\":\"blog-code-shiki overflow-x-auto\",\"dangerouslySetInnerHTML\":{\"__html\":\"$60\"}}]}]\n5a:[\"$\",\"p\",\"a7474978ae11\",{\"className\":\"my-5 text-blog-body text-blog-article\",\"children\":[\"For more detail, see the \",[\"$\",\"a\",\"debcdc74914e\",{\"href\":\"https://docs.vlm.run/gateway/introduction\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"className\":\"text-navy underline decoration-primary/30 underline-offset-[3px] transition-colors hover:text-primary\",\"children\":[\"docs\"]}],\". Join the discussion on \",[\"$\",\"a\",\"b856b44c63f4\",{\"href\":\"https://discord.gg/BsKVhq3DgF\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"className\":\"text-navy underline decoration-primary/30 underline-offset-[3px] transition-colors hover:text-primary\",\"children\":[\"Discord\"]}],\".\"]}]\n5b:[\"$\",\"p\",\"b9032bc0ef6c\",{\"className\":\"my-5 text-blog-body text-blog-article\",\"children\":[[\"$\",\"a\",\"a13ed3430534\",{\"href\":\"https://docs.vlm.run/gateway/quickstart\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"className\":\"text-navy underline decoration-primary/30 underline-offset-[3px] transition-colors hover:text-primary\",\"children\":[\"Quickstart\"]}],\" · \",[\"$\",\"a\",\"d8c2819a0e04\",{\"href\":\"https://docs.vlm.run/gateway/models\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"className\":\"text-navy underline decoration-primary/30 underline-offset-[3px] transition-colors hover:text-primary\",\"children\":[\"Model catalog\"]}],\" · \",[\"$\",\"a\",\"10a5f025e6c9\",{\"href\":\"https://docs.vlm.run/gateway/mcp-server\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"className\":\"text-navy underline decoration-primary/30 underline-offset-[3px] transition-colors hover:text-primary\",\"children\":[\"MCP server\"]}]]}]\n5c:[\"$\",\"$L61\",\"3ec9fdded0cb\",{\"value\":{\"_key\":\"3ec9fdded0cb\",\"_type\":\"codeStageEmbed\",\"embedKey\":\"documentMarkdown\"}}]\n5d:[\"$\",\"p\",\"715cce8a6f23\",{\"className\":\"my-5 text-blog-body text-blog-article\",\"children\":[\"\"]}]\n"])</script></body></html>