const SHOW_TABLE = false;
const WIDTH = 1020;
const HEIGHT = 662;
const PAD = { top: 20, right: 28, bottom: 68, left: 78 };
const AXIS_CHROME = &quot;&lt;g transform=\&quot;rotate(-90 96 181)\&quot;&gt;&lt;text x=\&quot;96\&quot; y=\&quot;181\&quot; font-size=\&quot;14\&quot; font-weight=\&quot;600\&quot; fill=\&quot;#3B82F6\&quot;&gt;MORE ACCURATE&lt;/text&gt;&lt;g transform=\&quot;translate(232 177)\&quot; fill=\&quot;none\&quot; stroke=\&quot;#3B82F6\&quot; stroke-width=\&quot;1.55\&quot; stroke-linecap=\&quot;round\&quot; stroke-linejoin=\&quot;round\&quot;&gt;&lt;path d=\&quot;M 0 0 H 9.6 M 6.3 -3.15 L 9.8 0 L 6.3 3.15\&quot;/&gt;&lt;/g&gt;&lt;/g&gt;&lt;g transform=\&quot;translate(88 578)\&quot; fill=\&quot;none\&quot; stroke=\&quot;#3B82F6\&quot; stroke-width=\&quot;1.55\&quot; stroke-linecap=\&quot;round\&quot; stroke-linejoin=\&quot;round\&quot;&gt;&lt;path d=\&quot;M 11 0 H 1.4 M 4.7 -3.15 L 1.2 0 L 4.7 3.15\&quot;/&gt;&lt;/g&gt;&lt;text x=\&quot;103\&quot; y=\&quot;582\&quot; font-size=\&quot;14\&quot; font-weight=\&quot;600\&quot; fill=\&quot;#3B82F6\&quot; text-anchor=\&quot;start\&quot;&gt;CHEAPER&lt;/text&gt;&lt;text x=\&quot;967\&quot; y=\&quot;582\&quot; font-size=\&quot;14\&quot; font-weight=\&quot;600\&quot; fill=\&quot;#3B82F6\&quot; text-anchor=\&quot;end\&quot;&gt;PRICIER&lt;/text&gt;&lt;g transform=\&quot;translate(971 578)\&quot; fill=\&quot;none\&quot; stroke=\&quot;#3B82F6\&quot; stroke-width=\&quot;1.55\&quot; stroke-linecap=\&quot;round\&quot; stroke-linejoin=\&quot;round\&quot;&gt;&lt;path d=\&quot;M 0 0 H 9.6 M 6.3 -3.15 L 9.8 0 L 6.3 3.15\&quot;/&gt;&lt;/g&gt;&lt;svg x=\&quot;940\&quot; y=\&quot;532.1538461538462\&quot; width=\&quot;44\&quot; height=\&quot;33.84615384615385\&quot; viewBox=\&quot;0 0 67.6 52\&quot; aria-hidden=\&quot;true\&quot; style=\&quot;pointer-events:none\&quot;&gt;&lt;path d=\&quot;M 4.21 6.45 C 4.21 2.888 7.098 0 10.66 0 L 19.08 0 L 19.08 4.3 L 10.66 4.3 C 9.473 4.3 8.51 5.263 8.51 6.45 L 8.51 23.335 C 8.51 24.522 7.547 25.485 6.36 25.485 L 6.36 26.515 C 7.547 26.515 8.51 27.478 8.51 28.665 L 8.51 45.55 C 8.51 46.737 9.473 47.7 10.66 47.7 L 19.08 47.7 L 19.08 52 L 10.66 52 C 7.098 52 4.21 49.112 4.21 45.55 L 4.21 28.15 L 0 28.15 L 0 23.85 L 4.21 23.85 Z\&quot; fill=\&quot;#3B82F6\&quot; fill-opacity=\&quot;0.5\&quot;/&gt;&lt;path d=\&quot;M 17.788 24.387 L 13.015 11.125 L 16.911 11.125 L 20.11 20.672 L 23.258 11.125 L 27.077 11.125 L 22.303 24.387 Z\&quot; fill=\&quot;#3B82F6\&quot; fill-opacity=\&quot;0.5\&quot;/&gt;&lt;path d=\&quot;M 27.773 24.387 L 27.773 6.326 L 31.411 6.326 L 31.411 24.387 Z\&quot; fill=\&quot;#3B82F6\&quot; fill-opacity=\&quot;0.5\&quot;/&gt;&lt;path d=\&quot;M 49.299 10.97 C 52.034 10.97 54.201 12.518 54.201 16.776 L 54.201 24.387 L 50.563 24.387 L 50.563 16.982 C 50.563 14.995 49.84 13.963 48.267 13.963 C 46.693 13.963 45.635 15.124 45.635 17.137 L 45.635 24.387 L 41.997 24.387 L 41.997 16.982 C 41.997 14.995 41.274 13.963 39.674 13.963 C 38.101 13.963 37.068 15.176 37.068 17.163 L 37.068 24.387 L 33.43 24.387 L 33.43 11.125 L 36.604 11.125 L 36.94 12.776 C 37.739 11.744 38.9 10.996 40.835 10.97 C 42.461 10.944 43.983 11.538 44.809 13.215 C 45.738 11.796 47.286 10.97 49.299 10.97 Z\&quot; fill=\&quot;#3B82F6\&quot; fill-opacity=\&quot;0.5\&quot;/&gt;&lt;path d=\&quot;M 23.399 29.401 L 24.019 29.401 L 24.019 32.704 L 22.574 32.704 C 20.406 32.704 19.581 34.149 19.581 36.161 L 19.581 42.664 L 15.943 42.664 L 15.943 29.401 L 19.245 29.401 L 19.581 31.388 C 20.303 30.201 21.335 29.401 23.399 29.401 Z\&quot; fill=\&quot;#3B82F6\&quot; fill-opacity=\&quot;0.5\&quot;/&gt;&lt;path d=\&quot;M 33.977 36.032 L 33.977 29.401 L 37.615 29.401 L 37.615 42.664 L 34.39 42.664 L 34.055 41.064 C 33.203 42.096 32.042 42.818 30.159 42.818 C 27.424 42.818 24.895 41.451 24.895 36.755 L 24.895 29.401 L 28.533 29.401 L 28.533 36.265 C 28.533 38.638 29.307 39.8 31.113 39.8 C 32.92 39.8 33.977 38.484 33.977 36.032 Z\&quot; fill=\&quot;#3B82F6\&quot; fill-opacity=\&quot;0.5\&quot;/&gt;&lt;path d=\&quot;M 47.24 29.246 C 50.104 29.246 52.556 30.769 52.556 35.31 L 52.556 42.664 L 48.918 42.664 L 48.918 35.671 C 48.918 33.426 48.066 32.239 46.234 32.239 C 44.351 32.239 43.267 33.581 43.267 35.878 L 43.267 42.664 L 39.629 42.664 L 39.629 29.401 L 42.803 29.401 L 43.138 31.053 C 43.989 30.021 45.202 29.246 47.24 29.246 Z\&quot; fill=\&quot;#3B82F6\&quot; fill-opacity=\&quot;0.5\&quot;/&gt;&lt;path d=\&quot;M 64.052 6.45 C 64.052 2.888 61.164 0 57.602 0 L 49.182 0 L 49.182 4.3 L 57.602 4.3 C 58.789 4.3 59.752 5.263 59.752 6.45 L 59.752 23.335 C 59.752 24.522 60.715 25.485 61.902 25.485 L 61.902 26.515 C 60.715 26.515 59.752 27.478 59.752 28.665 L 59.752 45.55 C 59.752 46.737 58.789 47.7 57.602 47.7 L 49.182 47.7 L 49.182 52 L 57.602 52 C 61.164 52 64.052 49.112 64.052 45.55 L 64.052 28.15 L 68.262 28.15 L 68.262 23.85 L 64.052 23.85 Z\&quot; fill=\&quot;#3B82F6\&quot; fill-opacity=\&quot;0.5\&quot;/&gt;&lt;/svg&gt;&quot;;

function clamp(n, min, max) { return Math.min(max, Math.max(min, n)); }
function escapeSvgText(value) {
  return String(value).replace(/&amp;/g, &quot;&amp;amp;&quot;).replace(/&lt;/g, &quot;&amp;lt;&quot;).replace(/&gt;/g, &quot;&amp;gt;&quot;);
}
function escapeAttr(value) { return escapeSvgText(value).replace(/&quot;/g, &quot;&amp;quot;&quot;); }
function formatCost(value) {
  const rounded = Math.round(value * 1000) / 1000;
  if (Number.isInteger(rounded)) return &quot;$&quot; + rounded.toFixed(0);
  const cents = Math.round(value * 100) / 100;
  if (Math.abs(cents - rounded) &lt; 1e-9) return &quot;$&quot; + cents.toFixed(2);
  return &quot;$&quot; + rounded.toFixed(3);
}
function formatScore(value) {
  return Number.isInteger(value) ? value + &quot;%&quot; : value.toFixed(1) + &quot;%&quot;;
}
function dominates(a, b) {
  return a.score &gt;= b.score &amp;&amp; a.cost &lt;= b.cost &amp;&amp; (a.score &gt; b.score || a.cost &lt; b.cost);
}
function sortByParetoFrontier(points) {
  var remaining = points.slice();
  var ranked = [];
  while (remaining.length) {
    var front = remaining.filter(function (p) {
      return !remaining.some(function (q) { return q.id !== p.id &amp;&amp; dominates(q, p); });
    }).sort(function (a, b) { return a.cost - b.cost || b.score - a.score; });
    var frontIds = {};
    front.forEach(function (p) { frontIds[p.id] = true; });
    ranked = ranked.concat(front);
    remaining = remaining.filter(function (p) { return !frontIds[p.id]; });
  }
  return ranked;
}
function xOf(chart, cost) {
  const t = (Math.log(cost) - Math.log(chart.xMin)) / (Math.log(chart.xMax) - Math.log(chart.xMin));
  return PAD.left + clamp(t, 0, 1) * (WIDTH - PAD.left - PAD.right);
}
function yOf(chart, score) {
  const t = (score - chart.yMin) / (chart.yMax - chart.yMin);
  return PAD.top + (1 - clamp(t, 0, 1)) * (HEIGHT - PAD.top - PAD.bottom);
}

function renderLegend(chart) {
  const legend = document.getElementById(&quot;legend&quot;);
  if (!legend) return;
  legend.innerHTML =
    &#x27;&lt;button class=&quot;legend-filter&quot; type=&quot;button&quot; aria-pressed=&quot;false&quot; data-filter-value=&quot;gateway&quot;&gt;&lt;i class=&quot;swatch&quot; style=&quot;background:#1265FF&quot;&gt;&lt;/i&gt;Gateway&lt;/button&gt;&#x27; +
    &#x27;&lt;button class=&quot;legend-filter&quot; type=&quot;button&quot; aria-pressed=&quot;false&quot; data-filter-value=&quot;market&quot;&gt;&lt;i class=&quot;swatch&quot; style=&quot;background:#94A3B8&quot;&gt;&lt;/i&gt;Market&lt;/button&gt;&#x27; +
    &#x27;&lt;span class=&quot;legend-item&quot;&gt;&lt;i class=&quot;swatch swatch-attractive&quot;&gt;&lt;/i&gt;&#x27; + escapeSvgText(chart.attractiveLabel) + &#x27;&lt;/span&gt;&#x27;;
}

function renderScatter(chart) {
  const plotW = WIDTH - PAD.left - PAD.right;
  const plotH = HEIGHT - PAD.top - PAD.bottom;
  const description = chart.points.map((p) =&gt; p.label + &quot; &quot; + formatScore(p.score) + &quot; at &quot; + formatCost(p.cost)).join(&quot;; &quot;);
  const titleEl = document.getElementById(&quot;chart-title&quot;);
  if (titleEl) titleEl.textContent = chart.title;
  renderLegend(chart);

  let svg = &#x27;&lt;svg viewBox=&quot;0 0 &#x27; + WIDTH + &#x27; &#x27; + HEIGHT + &#x27;&quot; width=&quot;100%&quot; height=&quot;auto&quot; preserveAspectRatio=&quot;xMidYMid meet&quot; role=&quot;img&quot; aria-label=&quot;&#x27; + escapeAttr(chart.title) + &#x27;&quot; aria-describedby=&quot;chart-desc&quot;&gt;&#x27;;
  svg += &#x27;&lt;desc id=&quot;chart-desc&quot;&gt;&#x27; + escapeSvgText(description) + &#x27;&lt;/desc&gt;&#x27;;
  chart.yTicks.forEach((tick) =&gt; {
    const y = yOf(chart, tick);
    svg += &#x27;&lt;line x1=&quot;&#x27; + PAD.left + &#x27;&quot; y1=&quot;&#x27; + y + &#x27;&quot; x2=&quot;&#x27; + (PAD.left + plotW) + &#x27;&quot; y2=&quot;&#x27; + y + &#x27;&quot; stroke=&quot;#EEF2F7&quot; stroke-width=&quot;1&quot;/&gt;&#x27;;
  });
  chart.xTicks.forEach((tick) =&gt; {
    const x = xOf(chart, tick);
    svg += &#x27;&lt;line x1=&quot;&#x27; + x + &#x27;&quot; y1=&quot;&#x27; + PAD.top + &#x27;&quot; x2=&quot;&#x27; + x + &#x27;&quot; y2=&quot;&#x27; + (PAD.top + plotH) + &#x27;&quot; stroke=&quot;#EEF2F7&quot; stroke-width=&quot;1&quot;/&gt;&#x27;;
  });
  const attractiveX = xOf(chart, Math.min(chart.attractiveMaxCost, chart.xMax));
  const attractiveTop = yOf(chart, chart.yMax);
  const attractiveBottom = yOf(chart, chart.attractiveMinScore);
  svg += &#x27;&lt;rect x=&quot;&#x27; + PAD.left + &#x27;&quot; y=&quot;&#x27; + attractiveTop + &#x27;&quot; width=&quot;&#x27; + Math.max(0, attractiveX - PAD.left) + &#x27;&quot; height=&quot;&#x27; + Math.max(0, attractiveBottom - attractiveTop) + &#x27;&quot; fill=&quot;#1265FF&quot; fill-opacity=&quot;0.07&quot; pointer-events=&quot;none&quot;/&gt;&#x27;;
  chart.yTicks.forEach((tick) =&gt; {
    const y = yOf(chart, tick);
    svg += &#x27;&lt;text x=&quot;&#x27; + (PAD.left - 10) + &#x27;&quot; y=&quot;&#x27; + (y + 4) + &#x27;&quot; font-size=&quot;15&quot; fill=&quot;#9CA3AF&quot; text-anchor=&quot;end&quot;&gt;&#x27; + tick + &#x27;%&lt;/text&gt;&#x27;;
  });
  chart.xTicks.forEach((tick) =&gt; {
    const x = xOf(chart, tick);
    svg += &#x27;&lt;text x=&quot;&#x27; + x + &#x27;&quot; y=&quot;&#x27; + (PAD.top + plotH + 24) + &#x27;&quot; font-size=&quot;15&quot; fill=&quot;#9CA3AF&quot; text-anchor=&quot;middle&quot;&gt;$&#x27; + tick + &#x27;&lt;/text&gt;&#x27;;
  });
  svg += &#x27;&lt;line x1=&quot;&#x27; + PAD.left + &#x27;&quot; y1=&quot;&#x27; + (PAD.top + plotH) + &#x27;&quot; x2=&quot;&#x27; + (PAD.left + plotW) + &#x27;&quot; y2=&quot;&#x27; + (PAD.top + plotH) + &#x27;&quot; stroke=&quot;#E5E7EB&quot; stroke-width=&quot;1&quot;/&gt;&#x27;;
  svg += &#x27;&lt;line x1=&quot;&#x27; + PAD.left + &#x27;&quot; y1=&quot;&#x27; + PAD.top + &#x27;&quot; x2=&quot;&#x27; + PAD.left + &#x27;&quot; y2=&quot;&#x27; + (PAD.top + plotH) + &#x27;&quot; stroke=&quot;#E5E7EB&quot; stroke-width=&quot;1&quot;/&gt;&#x27;;
  svg += &#x27;&lt;text x=&quot;16&quot; y=&quot;&#x27; + (PAD.top + plotH / 2) + &#x27;&quot; font-size=&quot;13.5&quot; font-weight=&quot;500&quot; letter-spacing=&quot;0.12em&quot; fill=&quot;#9CA3AF&quot; text-anchor=&quot;middle&quot; transform=&quot;rotate(-90 16 &#x27; + (PAD.top + plotH / 2) + &#x27;)&quot;&gt;&#x27; + escapeSvgText(chart.yLabel.toUpperCase()) + &#x27;&lt;/text&gt;&#x27;;
  svg += &#x27;&lt;text x=&quot;&#x27; + (PAD.left + plotW / 2) + &#x27;&quot; y=&quot;&#x27; + (PAD.top + plotH + 52) + &#x27;&quot; font-size=&quot;13.5&quot; font-weight=&quot;500&quot; letter-spacing=&quot;0.12em&quot; fill=&quot;#9CA3AF&quot; text-anchor=&quot;middle&quot;&gt;&#x27; + escapeSvgText(chart.xLabel.toUpperCase()) + &#x27;&lt;/text&gt;&#x27;;
  svg += AXIS_CHROME;

  chart.points.forEach((point) =&gt; {
    const x = xOf(chart, point.cost);
    const y = yOf(chart, point.score);
    const isGateway = point.group === &quot;gateway&quot;;
    const fill = isGateway ? &quot;#1265FF&quot; : &quot;#94A3B8&quot;;
    const labelFill = isGateway ? &quot;#0F172A&quot; : &quot;#64748B&quot;;
    const r = isGateway ? 6.5 : 5.5;
    svg += &#x27;&lt;g class=&quot;dot&quot; tabindex=&quot;0&quot; role=&quot;button&quot; aria-pressed=&quot;false&quot; data-id=&quot;&#x27; + escapeAttr(point.id) + &#x27;&quot; data-category=&quot;&#x27; + escapeAttr(point.label) + &#x27;&quot; data-model=&quot;&#x27; + escapeAttr(isGateway ? &quot;Gateway&quot; : &quot;Market&quot;) + &#x27;&quot; data-value=&quot;&#x27; + escapeAttr(formatScore(point.score) + &quot; · &quot; + formatCost(point.cost)) + &#x27;&quot; data-color=&quot;&#x27; + fill + &#x27;&quot;&gt;&#x27;;
    svg += &#x27;&lt;circle cx=&quot;&#x27; + x + &#x27;&quot; cy=&quot;&#x27; + y + &#x27;&quot; r=&quot;14&quot; fill=&quot;transparent&quot;/&gt;&#x27;;
    svg += &#x27;&lt;circle cx=&quot;&#x27; + x + &#x27;&quot; cy=&quot;&#x27; + y + &#x27;&quot; r=&quot;&#x27; + r + &#x27;&quot; fill=&quot;&#x27; + fill + &#x27;&quot; stroke=&quot;#fff&quot; stroke-width=&quot;1.5&quot;/&gt;&#x27;;
    svg += &#x27;&lt;text class=&quot;point-label&quot; x=&quot;&#x27; + (x + point.lx) + &#x27;&quot; y=&quot;&#x27; + (y + point.ly) + &#x27;&quot; font-size=&quot;16&quot; font-weight=&quot;&#x27; + (isGateway ? 600 : 500) + &#x27;&quot; fill=&quot;&#x27; + labelFill + &#x27;&quot; text-anchor=&quot;&#x27; + point.anchor + &#x27;&quot;&gt;&#x27; + escapeSvgText(point.label) + &#x27;&lt;/text&gt;&#x27;;
    svg += &#x27;&lt;/g&gt;&#x27;;
  });
  svg += &#x27;&lt;/svg&gt;&#x27;;
  document.getElementById(&quot;chart&quot;).innerHTML = svg;

  const tableRoot = document.getElementById(&quot;table&quot;);
  if (SHOW_TABLE &amp;&amp; tableRoot) {
    const rows = sortByParetoFrontier(chart.points);
    const modelCol = chart.modelColumn || &quot;Model&quot;;
    const costCol = chart.costColumn || &quot;Cost&quot;;
    let table = &#x27;&lt;table class=&quot;data-table&quot; id=&quot;data-table&quot;&gt;&lt;thead&gt;&lt;tr&gt;&#x27;;
    table += &#x27;&lt;th scope=&quot;col&quot;&gt;&#x27; + escapeSvgText(modelCol) + &#x27;&lt;/th&gt;&#x27;;
    table += &#x27;&lt;th scope=&quot;col&quot;&gt;Accuracy&lt;/th&gt;&#x27;;
    table += &#x27;&lt;th scope=&quot;col&quot;&gt;&#x27; + escapeSvgText(costCol) + &#x27;&lt;/th&gt;&#x27;;
    table += &#x27;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;&#x27;;
    rows.forEach((point) =&gt; {
      const isGateway = point.group === &quot;gateway&quot;;
      const fill = isGateway ? &quot;#1265FF&quot; : &quot;#0F172A&quot;;
      table += &#x27;&lt;tr data-id=&quot;&#x27; + escapeAttr(point.id) + &#x27;&quot;&gt;&#x27;;
      table += &#x27;&lt;td&gt;&lt;span class=&quot;model-cell&quot; style=&quot;color:&#x27; + fill + &#x27;&quot;&gt;&#x27; + escapeSvgText(point.label) + &#x27;&lt;/span&gt;&lt;/td&gt;&#x27;;
      table += &#x27;&lt;td class=&quot;num&quot;&gt;&#x27; + formatScore(point.score) + &#x27;&lt;/td&gt;&#x27;;
      table += &#x27;&lt;td class=&quot;num&quot;&gt;&#x27; + formatCost(point.cost) + &#x27;&lt;/td&gt;&#x27;;
      table += &#x27;&lt;/tr&gt;&#x27;;
    });
    table += &#x27;&lt;/tbody&gt;&lt;/table&gt;&#x27;;
    tableRoot.innerHTML = table;
  }
}

function setActive(id) {
  const svg = document.querySelector(&quot;#chart svg&quot;);
  const table = document.getElementById(&quot;data-table&quot;);
  if (!svg) return;
  svg.classList.toggle(&quot;has-active&quot;, Boolean(id));
  if (table) table.classList.toggle(&quot;has-active&quot;, Boolean(id));
  svg.querySelectorAll(&quot;.dot&quot;).forEach((dot) =&gt; {
    const on = Boolean(id) &amp;&amp; dot.dataset.id === id;
    dot.classList.toggle(&quot;is-active&quot;, on);
    dot.setAttribute(&quot;aria-pressed&quot;, on ? &quot;true&quot; : &quot;false&quot;);
  });
  if (table) {
    table.querySelectorAll(&quot;tbody tr&quot;).forEach((row) =&gt; {
      row.classList.toggle(&quot;is-active&quot;, Boolean(id) &amp;&amp; row.dataset.id === id);
    });
  }
}

function installInteractions() {
  let pinned = null;
  let filter = null;
  function applyFilter() {
    const svg = document.querySelector(&quot;#chart svg&quot;);
    if (!svg) return;
    svg.classList.toggle(&quot;has-filter&quot;, Boolean(filter));
    svg.querySelectorAll(&quot;.dot&quot;).forEach((dot) =&gt; {
      const group = dot.dataset.model === &quot;Gateway&quot; ? &quot;gateway&quot; : &quot;market&quot;;
      dot.classList.toggle(&quot;is-filtered&quot;, !filter || group === filter);
    });
    document.querySelectorAll(&quot;#legend .legend-filter&quot;).forEach((btn) =&gt; {
      const on = btn.dataset.filterValue === filter;
      btn.classList.toggle(&quot;is-active&quot;, on);
      btn.setAttribute(&quot;aria-pressed&quot;, on ? &quot;true&quot; : &quot;false&quot;);
    });
  }
  function bind() {
    const svg = document.querySelector(&quot;#chart svg&quot;);
    const table = document.getElementById(&quot;data-table&quot;);
    if (!svg) return;
    svg.querySelectorAll(&quot;.dot&quot;).forEach((dot) =&gt; {
      dot.addEventListener(&quot;pointerenter&quot;, () =&gt; { if (!pinned) setActive(dot.dataset.id); });
      dot.addEventListener(&quot;pointerleave&quot;, () =&gt; { if (!pinned) setActive(null); });
      dot.addEventListener(&quot;click&quot;, (event) =&gt; {
        event.stopPropagation();
        pinned = pinned === dot.dataset.id ? null : dot.dataset.id;
        setActive(pinned);
      });
    });
    if (table) {
      table.querySelectorAll(&quot;tbody tr&quot;).forEach((row) =&gt; {
        row.addEventListener(&quot;pointerenter&quot;, () =&gt; { if (!pinned) setActive(row.dataset.id); });
        row.addEventListener(&quot;pointerleave&quot;, () =&gt; { if (!pinned) setActive(null); });
        row.addEventListener(&quot;click&quot;, (event) =&gt; {
          event.stopPropagation();
          pinned = pinned === row.dataset.id ? null : row.dataset.id;
          setActive(pinned);
        });
      });
    }
    applyFilter();
  }
  document.querySelectorAll(&quot;.switcher button&quot;).forEach((btn) =&gt; {
    btn.addEventListener(&quot;click&quot;, (event) =&gt; {
      event.stopPropagation();
      const key = btn.dataset.key;
      if (!CHARTS[key]) return;
      activeKey = key;
      pinned = null;
      filter = null;
      document.querySelectorAll(&quot;.switcher button&quot;).forEach((other) =&gt; {
        const on = other.dataset.key === key;
        other.classList.toggle(&quot;is-active&quot;, on);
        other.setAttribute(&quot;aria-selected&quot;, on ? &quot;true&quot; : &quot;false&quot;);
      });
      renderScatter(CHARTS[key]);
      bind();
    });
  });
  const legend = document.getElementById(&quot;legend&quot;);
  if (legend) {
    legend.addEventListener(&quot;click&quot;, (event) =&gt; {
      const btn = event.target.closest(&quot;.legend-filter&quot;);
      if (!btn) return;
      event.stopPropagation();
      const value = btn.dataset.filterValue;
      filter = filter === value ? null : value;
      applyFilter();
    });
  }
  document.addEventListener(&quot;click&quot;, () =&gt; { pinned = null; setActive(null); });
  document.addEventListener(&quot;keydown&quot;, (event) =&gt; { if (event.key === &quot;Escape&quot;) { pinned = null; setActive(null); } });
  bind();
}

renderScatter(CHARTS[activeKey]);
installInteractions();

&lt;/script&gt;

&lt;script&gt;
(() =&gt; {
  const embedId = &quot;_R_9kmlubsnq5iulb_&quot;;
  const sendHeight = () =&gt; {
    // Prefer body metrics. documentElement.scrollHeight often mirrors the
    // iframe viewport, which prevents shrinking below the fallback height.
    const height = Math.max(
      document.body?.scrollHeight || 0,
      document.body?.offsetHeight || 0
    );
    if (height &gt; 0) {
      parent.postMessage({ type: &quot;vlm-inline-html-resize&quot;, embedId, height }, &quot;*&quot;);
    }
  };

  window.addEventListener(&quot;load&quot;, sendHeight);
  requestAnimationFrame(sendHeight);
  setTimeout(sendHeight, 250);

  if (typeof ResizeObserver !== &quot;undefined&quot;) {
    const observer = new ResizeObserver(sendHeight);
    if (document.body) observer.observe(document.body);
    if (document.documentElement) observer.observe(document.documentElement);
  }
})();
&lt;/script&gt;&lt;/body&gt;
&lt;/html&gt;" loading="lazy" sandbox="allow-scripts" class="block w-full overflow-hidden border-0 bg-transparent" scrolling="no" style="height:810px;overflow:hidden"></iframe></figure><p class="my-5 text-blog-body text-blog-article">On documents, two models land in the optimal quadrant, score 70 or better under $3 per thousand pages, and both are open-weight models on the Gateway. <code class="rounded-md bg-primary/10 px-1.5 py-0.5 font-mono text-code text-primary">infly/infinity-parser2-pro</code> scores about 79 at roughly $2.10 (per 1K pages), and <code class="rounded-md bg-primary/10 px-1.5 py-0.5 font-mono text-code text-primary">dots.mocr</code> about 74 at roughly $0.78. No commercial parser makes it into that box.</p><p class="my-5 text-blog-body text-blog-article"><code class="rounded-md bg-primary/10 px-1.5 py-0.5 font-mono text-code text-primary">infinity-parser2-pro</code> also matches or beats 7 of the 8 commercial parsers on the chart, including Gemini 3 Flash, Mistral OCR 4, Azure DI and Extend 2.0, at 2-12x less. AWS Textract sits about 24 points lower and costs 7x more. The one parser above it is LlamaParse in its cost-effective tier at roughly 80.5, a point and a half of accuracy for about twice the price.</p><p class="my-5 text-blog-body text-blog-article">Switch to the video benchmark and the picture is similar. Three models clear 70 under $10 per thousand clips, and two are open-weight models on the Gateway: <code class="rounded-md bg-primary/10 px-1.5 py-0.5 font-mono text-code text-primary">qwen3.8-27b</code> at about 75.5 for roughly $5.50 (per 1K clips), and <code class="rounded-md bg-primary/10 px-1.5 py-0.5 font-mono text-code text-primary">muse-glimmer-30b</code> at about 74 for roughly $1.50. <code class="rounded-md bg-primary/10 px-1.5 py-0.5 font-mono text-code text-primary">qwen3.8-27b</code> lands above GPT-5.6 Terra, while <code class="rounded-md bg-primary/10 px-1.5 py-0.5 font-mono text-code text-primary">muse-glimmer-30b</code> matches GPT-5, at a fraction of the $22 those cost. Gemini 3.7 Flash tops the chart at about 82, eight points up and roughly 6x the price of <code class="rounded-md bg-primary/10 px-1.5 py-0.5 font-mono text-code text-primary">muse-glimmer-30b</code>.</p><p class="my-5 text-blog-body text-blog-article">In other words: open-weight models are competitive on accuracy while often being significantly cheaper. Which point on that frontier is yours depends on your use case, and the Gateway is what makes switching between them easy.</p><h2 id="choosing-the-model-is-the-hard-part" class="mt-10 mb-1 scroll-mt-28 font-sans text-blog-h2 font-semibold text-primary-mid">Choosing the model is the hard part</h2><p class="my-5 text-blog-body text-blog-article">Why does anyone send documents to a frontier API? Because no single small model wins everywhere. Healthcare forms, construction drawings and legal contracts have different winners, and the winner changes with scan quality, language and layout density.</p><p class="my-5 text-blog-body text-blog-article">Evaluating candidates is expensive for reasons unrelated to the models. ONNX, GGUF, and PyTorch checkpoints need different runtimes, and some can&#x27;t share a process at all. Every model returns a different output shape, so each candidate needs its own parser. And you run out of VRAM long before you run out of candidates. So teams do the rational thing: pick the one API that handles everything and absorb the markup.</p><p class="my-5 text-blog-body text-blog-article">We know because we hit it first. Orion tool calls each request to multiple underlying models because no single model leads across localization, segmentation, and video.</p><p class="my-5 text-blog-body text-blog-article">The Gateway&#x27;s product isn&#x27;t any single model. It&#x27;s making the choice reversible. When every model runs on one API, changing models is as simple as changing a parameter: same endpoint, same request shape, same output contract.</p><figure class="my-6 overflow-hidden rounded-xl border border-border bg-white"><div class="blog-code-shiki overflow-x-auto"><pre class="shiki github-light" style="background-color:#fff;color:#24292e" tabindex="0"><code><span class="line"><span style="color:#E36209">-</span><span style="color:#24292E"> model="rednote-hilab/dots.mocr",</span></span>
<span class="line"><span style="color:#E36209">+</span><span style="color:#24292E"> model="infly/infinity-parser2-pro",</span></span></code></pre></div></figure><p class="my-5 text-blog-body text-blog-article">Everything else in your code stays identical.</p><h2 id="what-the-gateway-is" class="mt-10 mb-1 scroll-mt-28 font-sans text-blog-h2 font-semibold text-primary-mid">What the Gateway is</h2><p class="my-5 text-blog-body text-blog-article">Try the models in the <a href="https://docs.vlm.run/gateway/models" target="_blank" rel="noopener noreferrer" class="text-navy underline decoration-primary/30 underline-offset-[3px] transition-colors hover:text-primary">Gateway model catalog</a> today. Alongside the OCR models above, it covers layout detection with reading order, captioning and detection, visual chat over images, video and PDFs, embeddings, and audio transcription. Each model is served behind the standard <code class="rounded-md bg-primary/10 px-1.5 py-0.5 font-mono text-code text-primary">chat.completions</code>, <code class="rounded-md bg-primary/10 px-1.5 py-0.5 font-mono text-code text-primary">embeddings</code>, or <code class="rounded-md bg-primary/10 px-1.5 py-0.5 font-mono text-code text-primary">transcriptions</code> interface.</p><p class="my-5 text-blog-body text-blog-article">Five runtimes sit behind one router, each model an isolated plugin, so conflicting dependency stacks coexist. Models stay resident rather than cold-starting per request, which is what keeps latency predictable and prices low.</p><p class="my-5 text-blog-body text-blog-article">The Gateway also handles the work around the model. PDFs are rasterized page by page across parallel workers, with <code class="rounded-md bg-primary/10 px-1.5 py-0.5 font-mono text-code text-primary">document_dpi</code>, <code class="rounded-md bg-primary/10 px-1.5 py-0.5 font-mono text-code text-primary">document_pages</code>, and <code class="rounded-md bg-primary/10 px-1.5 py-0.5 font-mono text-code text-primary">stream: true</code> controlling raster quality, page range, and incremental delivery. A page that fails is retried or marked rather than killing the document. Output comes back normalized: markdown with page markers, a unified bounding-box schema, self-describing JSON. Every response carries metered <code class="rounded-md bg-primary/10 px-1.5 py-0.5 font-mono text-code text-primary">usage.cost</code> and an <code class="rounded-md bg-primary/10 px-1.5 py-0.5 font-mono text-code text-primary">x-request-id</code>. The output contract belongs to the Gateway, not the model. That&#x27;s what makes the one-line swap real.</p><h2 id="build-your-own-agents" class="mt-10 mb-1 scroll-mt-28 font-sans text-blog-h2 font-semibold text-primary-mid">Build your own agents</h2><p class="my-5 text-blog-body text-blog-article">An MCP server at <code class="rounded-md bg-primary/10 px-1.5 py-0.5 font-mono text-code text-primary">https://gateway.vlm.run/mcp</code> exposes <code class="rounded-md bg-primary/10 px-1.5 py-0.5 font-mono text-code text-primary">read_document</code>, <code class="rounded-md bg-primary/10 px-1.5 py-0.5 font-mono text-code text-primary">read_video</code>, and <code class="rounded-md bg-primary/10 px-1.5 py-0.5 font-mono text-code text-primary">read_audio</code>, so any MCP-compatible framework (Pydantic AI, LangChain, Mastra, OpenAI Agents SDK, Claude Code) consumes visual content through the same pipeline, auth, and billing. Most of the models in our catalog is open-weight: which means you can run it in your VPC, fine-tune it on your data, own the weights. Enterprise deployments will support BYOK, private VPC, and BAAs for HIPAA.</p><h2 id="get-started" class="mt-10 mb-1 scroll-mt-28 font-sans text-blog-h2 font-semibold text-primary-mid">Get started</h2><p class="my-5 text-blog-body text-blog-article">The visual frontier just moved. Your AI bill should too.</p><p class="my-5 text-blog-body text-blog-article">All endpoints support anonymous access with IP-based rate limits, the Gateway is free during alpha, and the published prices are already live, so the cost signals you build against today are the ones you&#x27;ll use in production. Point your OpenAI SDK at <code class="rounded-md bg-primary/10 px-1.5 py-0.5 font-mono text-code text-primary">https://gateway.vlm.run/v1/openai</code>, or list the catalog from your terminal:</p><figure class="my-6 overflow-hidden rounded-xl border border-border bg-white"><div class="blog-code-shiki overflow-x-auto"><pre class="shiki github-light" style="background-color:#fff;color:#24292e" tabindex="0"><code><span class="line"><span style="color:#6A737D"># List the models on the gateway</span></span>
<span class="line"><span style="color:#6F42C1">uvx</span><span style="color:#032F62"> vlmrun</span><span style="color:#032F62"> gw</span><span style="color:#032F62"> models</span></span>
<span class="line"></span>
<span class="line"><span style="color:#6A737D"># Run GLM-OCR, dots.mocr, Deepseek OCR 2 on a document</span></span>
<span class="line"><span style="color:#6F42C1">uvx</span><span style="color:#032F62"> vlmrun</span><span style="color:#032F62"> gw</span><span style="color:#032F62"> chat</span><span style="color:#005CC5"> -m</span><span style="color:#032F62"> glm-ocr</span><span style="color:#D73A49"> &#x3C;</span><span style="color:#032F62">do</span><span style="color:#24292E">c</span><span style="color:#D73A49">></span><span style="color:#032F62">.pdf</span></span>
<span class="line"><span style="color:#6F42C1">uvx</span><span style="color:#032F62"> vlmrun</span><span style="color:#032F62"> gw</span><span style="color:#032F62"> chat</span><span style="color:#005CC5"> -m</span><span style="color:#032F62"> dots.mocr</span><span style="color:#D73A49"> &#x3C;</span><span style="color:#032F62">do</span><span style="color:#24292E">c</span><span style="color:#D73A49">></span><span style="color:#032F62">.pdf</span></span>
<span class="line"><span style="color:#6F42C1">uvx</span><span style="color:#032F62"> vlmrun</span><span style="color:#032F62"> gw</span><span style="color:#032F62"> chat</span><span style="color:#005CC5"> -m</span><span style="color:#032F62"> deepseek-ocr-2</span><span style="color:#D73A49"> &#x3C;</span><span style="color:#032F62">do</span><span style="color:#24292E">c</span><span style="color:#D73A49">></span><span style="color:#032F62">.pdf</span></span>
<span class="line"></span>
<span class="line"><span style="color:#6A737D"># Run qwen3.5-0.8b on image / video</span></span>
<span class="line"><span style="color:#6F42C1">uvx</span><span style="color:#032F62"> vlmrun</span><span style="color:#032F62"> gw</span><span style="color:#032F62"> chat</span><span style="color:#005CC5"> -m</span><span style="color:#032F62"> qwen3.5-0.8b</span><span style="color:#005CC5">  -p</span><span style="color:#032F62"> "describe the image"</span><span style="color:#D73A49"> &#x3C;</span><span style="color:#032F62">imag</span><span style="color:#24292E">e</span><span style="color:#D73A49">></span><span style="color:#032F62">.png</span></span>
<span class="line"><span style="color:#6F42C1">uvx</span><span style="color:#032F62"> vlmrun</span><span style="color:#032F62"> gw</span><span style="color:#032F62"> chat</span><span style="color:#005CC5"> -m</span><span style="color:#032F62"> qwen3.5-0.8b</span><span style="color:#005CC5">  -p</span><span style="color:#032F62"> "describe the video"</span><span style="color:#D73A49"> &#x3C;</span><span style="color:#032F62">vide</span><span style="color:#24292E">o</span><span style="color:#D73A49">></span><span style="color:#032F62">.mp4</span></span></code></pre></div></figure><p class="my-5 text-blog-body text-blog-article">For more detail, see the <a href="https://docs.vlm.run/gateway/introduction" target="_blank" rel="noopener noreferrer" class="text-navy underline decoration-primary/30 underline-offset-[3px] transition-colors hover:text-primary">docs</a>. Join the discussion on <a href="https://discord.gg/BsKVhq3DgF" target="_blank" rel="noopener noreferrer" class="text-navy underline decoration-primary/30 underline-offset-[3px] transition-colors hover:text-primary">Discord</a>.</p><p class="my-5 text-blog-body text-blog-article"><a href="https://docs.vlm.run/gateway/quickstart" target="_blank" rel="noopener noreferrer" class="text-navy underline decoration-primary/30 underline-offset-[3px] transition-colors hover:text-primary">Quickstart</a> · <a href="https://docs.vlm.run/gateway/models" target="_blank" rel="noopener noreferrer" class="text-navy underline decoration-primary/30 underline-offset-[3px] transition-colors hover:text-primary">Model catalog</a> · <a href="https://docs.vlm.run/gateway/mcp-server" target="_blank" rel="noopener noreferrer" class="text-navy underline decoration-primary/30 underline-offset-[3px] transition-colors hover:text-primary">MCP server</a></p><figure class="my-8"><div class="relative flex items-center justify-center overflow-hidden bg-[#eef4fb] p-3 sm:p-4 lg:p-5 rounded-[20px] border border-border shadow-[0_1px_0_rgba(16,42,86,0.03)]"><div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-cover bg-center opacity-50" style="background-image:url(/images/textures/code-bg.png)"></div><div aria-hidden="true" class="absolute inset-0 bg-[#eef4fb]/70"></div><div aria-hidden="true" class="pointer-events-none absolute -inset-2 opacity-80" style="background:radial-gradient(60% 50% at 50% 50%, rgba(18,101,255,0.18) 0%, rgba(18,101,255,0) 70%);filter:blur(8px)"></div><div class="relative w-full max-w-[560px] xl:max-w-[640px]"><div class="group relative w-full min-w-0 overflow-hidden border border-black/[0.08] bg-white/60 shadow-[0_8px_30px_rgba(16,42,86,0.04)] backdrop-blur-[4px] rounded-[12px]"><button type="button" class="absolute right-2.5 top-2.5 z-10 flex cursor-pointer items-center gap-1.5 rounded-md bg-white/95 p-1.5 text-[11px] font-medium transition-all duration-150 invisible text-muted opacity-0 hover:text-navy group-hover:visible group-hover:opacity-100 focus-visible:visible focus-visible:opacity-100" aria-label="Copy code"><svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true"><rect x="4" y="4" width="7" height="7" rx="1" stroke="currentColor" stroke-width="1.2"></rect><path d="M3 8H2a1 1 0 01-1-1V2a1 1 0 011-1h5a1 1 0 011 1v1" stroke="currentColor" stroke-width="1.2"></path></svg></button><div class="flex min-w-0 w-full overflow-x-auto lg:no-scrollbar min-h-[320px] px-4 py-3.5 bg-transparent"><pre class="min-w-0 flex-1 whitespace-pre font-mono text-[12px] leading-[16px]"><code class="block min-w-max"><span class="text-[#0000ff]">from</span><span class="text-[#000000]"> openai </span><span class="text-[#0000ff]">import</span><span class="text-[#000000]"> OpenAI

client = OpenAI</span><span class="text-[#0431fa]">(</span><span class="text-[#000000]">base_url=</span><span class="text-[#a31515]">&quot;https://gateway.vlm.run/v1/openai/&quot;</span><span class="text-[#000000]">,
                api_key=</span><span class="text-[#a31515]">&quot;&lt;VLM_RUN_API_KEY&gt;&quot;</span><span class="text-[#0431fa]">)</span><span class="text-[#000000]">

resp = client.chat.completions.create</span><span class="text-[#0431fa]">(</span><span class="text-[#000000]">
    model=</span><span class="text-[#a31515]">&quot;rednote-hilab/dots.mocr&quot;</span><span class="text-[#000000]">,
    messages=</span><span class="text-[#319331]">[</span><span class="text-[#7b3814]">{</span><span class="text-[#a31515]">&quot;role&quot;</span><span class="text-[#000000]">: </span><span class="text-[#a31515]">&quot;user&quot;</span><span class="text-[#000000]">, </span><span class="text-[#a31515]">&quot;content&quot;</span><span class="text-[#000000]">: </span><span class="text-[#0431fa]">[</span><span class="text-[#000000]">
        </span><span class="text-[#319331]">{</span><span class="text-[#a31515]">&quot;type&quot;</span><span class="text-[#000000]">: </span><span class="text-[#a31515]">&quot;document_url&quot;</span><span class="text-[#000000]">, </span><span class="text-[#a31515]">&quot;document_url&quot;</span><span class="text-[#000000]">: </span><span class="text-[#7b3814]">{</span><span class="text-[#a31515]">&quot;url&quot;</span><span class="text-[#000000]">: </span><span class="text-[#a31515]">&quot;invoice.pdf&quot;</span><span class="text-[#7b3814]">}</span><span class="text-[#319331]">}</span><span class="text-[#000000]">,
    </span><span class="text-[#0431fa]">]</span><span class="text-[#7b3814]">}</span><span class="text-[#319331]">]</span><span class="text-[#000000]">,
    extra_body=</span><span class="text-[#319331]">{</span><span class="text-[#a31515]">&quot;method&quot;</span><span class="text-[#000000]">: </span><span class="text-[#a31515]">&quot;markdown&quot;</span><span class="text-[#319331]">}</span><span class="text-[#000000]">,
</span><span class="text-[#0431fa]">)</span><span class="text-[#000000]">
print</span><span class="text-[#0431fa]">(</span><span class="text-[#000000]">resp.choices</span><span class="text-[#319331]">[</span><span class="text-[#098658]">0</span><span class="text-[#319331]">]</span><span class="text-[#000000]">.message.content</span><span class="text-[#0431fa]">)</span><span class="text-[#000000]">

</span><span class="text-[#008000]"># &lt;document page=&quot;1&quot;&gt;</span><span class="text-[#000000]">
</span><span class="text-[#008000]"># ## Invoice #1042</span><span class="text-[#000000]">
</span><span class="text-[#008000]"># | Item      | Qty | Amount |</span><span class="text-[#000000]">
</span><span class="text-[#008000]"># | API seats |  12 | $1,200 |</span><span class="text-[#000000]">
</span><span class="text-[#008000]"># &lt;/document&gt;</span><span class="text-[#000000]">
</span></code></pre></div></div></div></div></figure><p class="my-5 text-blog-body text-blog-article"></p></div></div></div></div><section class="mt-14" aria-labelledby="related-posts-heading"><div class="relative left-1/2 w-screen max-w-[100vw] -translate-x-1/2 border-y border-border py-6 lg:py-8"><div class="mx-auto max-w-[1168px] px-5 sm:px-8 lg:px-16"><div class="mx-auto flex max-w-5xl flex-col gap-6 sm:flex-row sm:items-end sm:justify-between"><h2 id="related-posts-heading" class="font-serif text-display-sm text-navy">Related posts</h2><a href="/blog" class="inline-flex items-center justify-center gap-1.5 cursor-pointer transition-[transform,box-shadow,background-color,opacity] duration-300 ease-out hover:opacity-90 hover:-translate-y-px no-underline font-medium bg-primary-dark text-white rounded-[20px] border border-primary-border shadow-btn text-label px-3 py-2 shrink-0">View all<svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M5.5 3.5L9 7l-3.5 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg></a></div></div></div><div class="mx-auto max-w-[1168px] px-5 sm:px-8 lg:px-16 mt-10"><div class="mx-auto grid max-w-5xl grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3"><article class="flex flex-col overflow-hidden rounded border border-border bg-white transition-colors duration-200 hover:border-primary-mid"><a class="relative block overflow-hidden rounded-t bg-surface aspect-[16/9]" href="/blog/orion-2"><img alt="Introducing Orion 2, our most capable visual agent. It writes and executes vision programs on the fly: faster, cheaper, more reliable." loading="lazy" width="800" height="450" decoding="async" data-nimg="1" class="h-full w-full rounded-[2px] object-cover" style="color:transparent" srcSet="/_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2F12pgkx8l%2Fproduction%2Fa032668facaddc17f9d0bba0f31b6f721c737dff-2400x1350.png&amp;w=828&amp;q=75 1x, /_next/image?url=https