x-1">Book a Demo</a><a href="https://app.vlm.run/sign-in" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-1.5 cursor-pointer transition-[transform,box-shadow,background-color,opacity] duration-300 ease-out hover:opacity-90 hover:-translate-y-px no-underline font-medium bg-primary-dark text-white rounded-[20px] border border-primary-border shadow-btn text-label px-3 py-2 flex-1">Dashboard<svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M5.5 3.5L9 7l-3.5 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg></a></div></div></header><div class="h-[68px]" aria-hidden="true"></div><main class="relative"><script type="application/ld+json">{"@context":"https://schema.org","@type":"Article","headline":"Introducing the VLM Run Gateway: Unified API for Visual Intelligence","description":"One OpenAI-compatible endpoint for specialized VLMs. Swap models in a line, and stop paying frontier prices to read images, documents and videos.","url":"https://vlm.run/blog/introducing-gateway","datePublished":"2026-09-01T07:30:00.000Z","author":[{"@type":"Person","name":"Sudeep Pillai"},{"@type":"Person","name":"Dinesh Reddy"},{"@type":"Person","name":"Jeremy Park"}],"publisher":{"@id":"https://vlm.run/#organization"},"mainEntityOfPage":"https://vlm.run/blog/introducing-gateway"}</script><header class="border-b border-border bg-surface"><div class="w-full px-0 pt-12 lg:pt-14 pb-0"><div class="flex w-full flex-col items-center"><h1 class="max-w-[23rem] px-6 text-balance text-center font-serif text-[30px] leading-[1.08] tracking-[-0.025em] text-navy antialiased sm:max-w-2xl sm:text-heading-lg lg:max-w-none lg:px-0 lg:leading-[110%] lg:tracking-[-0.02em]">Introducing the VLM Run Gateway: Unified API for Visual Intelligence</h1><time dateTime="2026-09-01T07:30:00.000Z" class="mt-5 block hyphens-manual text-center font-sans text-body-lg font-medium leading-[140%] antialiased" style="color:var(--blog-meta)">Sep 1, 2026</time><div class="mt-10 flex min-h-16 w-full flex-wrap items-center justify-center gap-x-[10px] gap-y-[10px] border-t border-border px-6 py-[10px] sm:px-0" aria-label="Authors"><div class="flex items-center gap-2.5 shrink-0"><div class="flex-shrink-0 overflow-hidden bg-primary-tint rounded-md" style="width:32px;height:32px"><img alt="Sudeep Pillai" loading="lazy" width="32" height="32" decoding="async" data-nimg="1" class="w-full h-full object-cover" style="color:transparent" srcSet="/_next/image?url=https%3A%2F%2Fframerusercontent.com%2Fimages%2Fl2iTMxJuCMUp4vTlGYn8s3esQ.png%3Fwidth%3D512%26height%3D512&amp;w=32&amp;q=75 1x, /_next/image?url=https%3A%2F%2Fframerusercontent.com%2Fimages%2Fl2iTMxJuCMUp4vTlGYn8s3esQ.png%3Fwidth%3D512%26height%3D512&amp;w=64&amp;q=75 2x" src="/_next/image?url=https%3A%2F%2Fframerusercontent.com%2Fimages%2Fl2iTMxJuCMUp4vTlGYn8s3esQ.png%3Fwidth%3D512%26height%3D512&amp;w=64&amp;q=75"/></div><div class="flex flex-col"><span class="text-body-md font-medium leading-[140%] opacity-80 [color:var(--blog-meta)]">Sudeep Pillai</span></div></div><div class="flex items-center gap-2.5 shrink-0"><div class="flex-shrink-0 overflow-hidden bg-primary-tint rounded-md" style="width:32px;height:32px"><img alt="Dinesh Reddy" loading="lazy" width="32" height="32" decoding="async" data-nimg="1" class="w-full h-full object-cover" style="color:transparent" srcSet="/_next/image?url=https%3A%2F%2Fframerusercontent.com%2Fimages%2FOJiLOdPP754buiT6MpeoHyBQ.jpeg%3Fwidth%3D200%26height%3D200&amp;w=32&amp;q=75 1x, /_next/image?url=https%3A%2F%2Fframerusercontent.com%2Fimages%2FOJiLOdPP754buiT6MpeoHyBQ.jpeg%3Fwidth%3D200%26height%3D200&amp;w=64&amp;q=75 2x" src="/_next/image?url=https%3A%2F%2Fframerusercontent.com%2Fimages%2FOJiLOdPP754buiT6MpeoHyBQ.jpeg%3Fwidth%3D200%26height%3D200&amp;w=64&amp;q=75"/></div><div class="flex flex-col"><span class="text-body-md font-medium leading-[140%] opacity-80 [color:var(--blog-meta)]">Dinesh Reddy</span></div></div><div class="flex items-center gap-2.5 shrink-0"><div class="flex-shrink-0 overflow-hidden bg-primary-tint rounded-md" style="width:32px;height:32px"><img alt="Jeremy Park" loading="lazy" width="32" height="32" decoding="async" data-nimg="1" class="w-full h-full object-cover" style="color:transparent" srcSet="/_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2F12pgkx8l%2Fproduction%2Fe30f3b16c7f30157bc5dc99a061d86763750bfdd-192x192.jpg&amp;w=32&amp;q=75 1x, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2F12pgkx8l%2Fproduction%2Fe30f3b16c7f30157bc5dc99a061d86763750bfdd-192x192.jpg&amp;w=64&amp;q=75 2x" src="/_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2F12pgkx8l%2Fproduction%2Fe30f3b16c7f30157bc5dc99a061d86763750bfdd-192x192.jpg&amp;w=64&amp;q=75"/></div><div class="flex flex-col"><span class="text-body-md font-medium leading-[140%] opacity-80 [color:var(--blog-meta)]">Jeremy Park</span></div></div></div></div></div></header><div class="overflow-x-clip bg-body py-14 lg:py-16"><div class="mx-auto max-w-[1168px] px-6 lg:px-8"><div class="flex flex-col gap-10 lg:grid lg:grid-cols-[200px_minmax(0,1fr)] lg:items-start lg:gap-10"><aside class="hidden w-full self-start text-left lg:sticky lg:top-28 lg:block lg:overflow-hidden lg:border-r lg:pr-4"><nav id="table-of-contents" aria-label="Table of contents" class="hidden w-full scroll-mt-28 flex-col items-stretch gap-2.5 text-left lg:flex"><p class="w-full text-left text-body-sm font-semibold uppercase leading-4 tracking-[0.03em] text-primary-mid">Table of contents</p><ul class="flex w-full list-none flex-col gap-2.5 p-0 text-left"><li class="w-full text-left"><a href="#you-dont-need-a-trillion-parameter-vlm" class="block w-full max-w-full overflow-hidden break-words text-left text-label leading-[1.5] transition-colors font-normal text-black/50 hover:text-black/70">You don&#x27;t need a trillion parameter VLM</a></li><li class="w-full text-left"><a href="#choosing-the-model-is-the-hard-part" class="block w-full max-w-full overflow-hidden break-words text-left text-label leading-[1.5] transition-colors font-normal text-black/50 hover:text-black/70">Choosing the model is the hard part</a></li><li class="w-full text-left"><a href="#what-the-gateway-is" class="block w-full max-w-full overflow-hidden break-words text-left text-label leading-[1.5] transition-colors font-normal text-black/50 hover:text-black/70">What the Gateway is</a></li><li class="w-full text-left"><a href="#build-your-own-agents" class="block w-full max-w-full overflow-hidden break-words text-left text-label leading-[1.5] transition-colors font-normal text-black/50 hover:text-black/70">Build your own agents</a></li><li class="w-full text-left"><a href="#get-started" class="block w-full max-w-full overflow-hidden break-words text-left text-label leading-[1.5] transition-colors font-normal text-black/50 hover:text-black/70">Get started</a></li></ul></nav></aside><div class="min-w-0 lg:max-w-3xl lg:justify-self-center"><div class="mb-10 lg:mb-12"><div class="w-full bg-white p-3"><div class="aspect-[16/9] w-full overflow-hidden"><img alt="Introducing the VLM Run Gateway. One OpenAI-compatible endpoint for specialized open-weight visual models." width="1200" height="675" decoding="async" data-nimg="1" class="h-full w-full object-cover" style="color:transparent" srcSet="/_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2F12pgkx8l%2Fproduction%2Fbf5a62a2b6192ed6bf33fe2635ea93cc4dbdd062-2400x1350.png&amp;w=1200&amp;q=75 1x, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2F12pgkx8l%2Fproduction%2Fbf5a62a2b6192ed6bf33fe2635ea93cc4dbdd062-2400x1350.png&amp;w=3840&amp;q=75 2x" src="/_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2F12pgkx8l%2Fproduction%2Fbf5a62a2b6192ed6bf33fe2635ea93cc4dbdd062-2400x1350.png&amp;w=3840&amp;q=75"/></div></div></div><div class="blog-article prose-none max-w-none [&amp;&gt;*:first-child]:mt-0"><p class="my-5 text-blog-body text-blog-article">Since the Orion agent launch in November, our customers have run hundreds of thousands of requests spanning millions of tool calls in production every month, across healthcare claims, construction submittals, legal contracts, and faxes. One question came back more than any other: <em class="italic text-inherit">which models are you running underneath, and can we call them directly?</em></p><p class="my-5 text-blog-body text-blog-article">We listened and gave them early access to the models through our gateway. Today, we&#x27;re opening access to everyone.</p><p class="my-5 text-blog-body text-blog-article">The <strong class="font-bold text-inherit">VLM Run Gateway</strong> runs open-weight VLMs, OCR VLMs, embodied VLMs, and specialized ViTs behind one OpenAI-compatible API, at a fraction of commercial API pricing. Because they all share one interface, you can run and compare results on your own data and pick your own point on the cost/accuracy frontier by changing a single parameter. Point <code class="rounded-md bg-primary/10 px-1.5 py-0.5 font-mono text-code text-primary">base_url</code> at <code class="rounded-md bg-primary/10 px-1.5 py-0.5 font-mono text-code text-primary">https://gateway.vlm.run/v1/openai</code> and every model takes the request shape your OpenAI SDK already uses. It&#x27;s <a href="https://www.vlm.run/product/gateway" target="_blank" rel="noopener noreferrer" class="text-navy underline decoration-primary/30 underline-offset-[3px] transition-colors hover:text-primary">free during alpha</a>, so try it on your own documents, images, and videos today.</p><figure class="my-8"><div class="overflow-hidden rounded-xl border border-border bg-navy-dark"><video class="aspect-video w-full object-contain" src="/videos/gateway-launch.mp4" controls="" playsInline="" preload="metadata" muted="" loop="" aria-label="Test inline video"></video></div></figure><h2 id="you-dont-need-a-trillion-parameter-vlm" class="mt-10 mb-1 scroll-mt-28 font-sans text-blog-h2 font-semibold text-primary-mid">You don&#x27;t need a trillion parameter VLM</h2><p class="my-5 text-blog-body text-blog-article">Parsing a documents, understanding images, summarizing videos: the best model for the job is rarely the biggest one. <code class="rounded-md bg-primary/10 px-1.5 py-0.5 font-mono text-code text-primary">zai-org/glm-ocr</code> is 0.9B parameters, <code class="rounded-md bg-primary/10 px-1.5 py-0.5 font-mono text-code text-primary">rednote-hilab/dots.mocr</code> 3B. Both are trained on page images at document-native resolutions, and it shows: over 3,000 output tokens/sec on commodity hardware, a fraction of the vision tokens a general-purpose VLM burns on the same page, and small enough to run on older GPUs, which is what makes on-prem and VPC deployment tractable.</p><p class="my-5 text-blog-body text-blog-article">Frontier VLMs are built for open-ended reasoning, &quot;figure out what this means&quot; rather than &quot;read this,&quot; and there they remain the right call. On documents they fail repeatably: dense multi-column tables, low-DPI fax scans, overlaid stamps and handwriting, non-Latin scripts. For extraction, OCR, and layout, they&#x27;re an expensive default nobody chose deliberately.</p><p class="my-5 text-blog-body text-blog-article">To test this, we evaluated six OCR models on the Gateway against eight commercial document parsers on <a href="https://huggingface.co/datasets/llamaindex/ParseBench" target="_blank" rel="noopener noreferrer" class="text-navy underline decoration-primary/30 underline-offset-[3px] transition-colors hover:text-primary">ParseBench</a>, and three open-weight VLMs on the Gateway against the frontier VLMs on <a href="https://huggingface.co/datasets/OpenGVLab/MVBench" target="_blank" rel="noopener noreferrer" class="text-navy underline decoration-primary/30 underline-offset-[3px] transition-colors hover:text-primary">MVBench</a>. Every model is plotted at its measured cost, per thousand pages for documents and per thousand clips for video:</p><figure class="my-8"><iframe title="Gateway cost vs accuracy (Document / Video)" srcDoc="&lt;!DOCTYPE html&gt;
&lt;html lang=&quot;en&quot;&gt;
&lt;head&gt;
&lt;meta charset=&quot;UTF-8&quot;&gt;
&lt;meta name=&quot;viewport&quot; content=&quot;width=device-width, initial-scale=1.0&quot;&gt;
&lt;title&gt;ParseBench vs. cost per 1K pages&lt;/title&gt;
&lt;link rel=&quot;preconnect&quot; href=&quot;https://fonts.googleapis.com&quot;&gt;
&lt;link rel=&quot;preconnect&quot; href=&quot;https://fonts.gstatic.com&quot; crossorigin&gt;
&lt;link href=&quot;https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&amp;display=swap&quot; rel=&quot;stylesheet&quot;&gt;

&lt;style&gt;
  :root {
    --card: #FFFFFF;
    --border: #E5E7EB;
    --ink: #111827;
    --ink-muted: #6B7280;
    --ink-faint: #9CA3AF;
    --gateway: #1265FF;
    --market: #94A3B8;
    --row-active: #F8FAFF;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  html, body { background: transparent; overflow: hidden; }
  body {
    font-family: Inter, -apple-system, BlinkMacSystemFont, &quot;Segoe UI&quot;, sans-serif;
    color: var(--ink);
    padding: 0;
    -webkit-font-smoothing: antialiased;
  }
  .accuracy-card {
    width: 100%;
    max-width: 1020px;
    margin: 0 auto;
    background: var(--card);
    border: 1px solid var(--border);
    overflow: hidden;
    padding: 22px 26px 20px;
  }
  .card-head {
    display: flex;
    flex-wrap: wrap;
    flex-shrink: 0;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 14px;
  }
  .accuracy-card h2 {
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--ink);
    min-width: 0;
  }
  .switcher {
    display: flex;
    flex-shrink: 0;
    border: 1px solid var(--border);
  }
  .switcher button {
    appearance: none;
    min-width: 92px;
    padding: 6px 14px;
    font: inherit;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--ink-muted);
    background: #fff;
    border: 0;
    cursor: pointer;
  }
  .switcher button.is-active {
    background: #1F5ACA;
    color: #fff;
  }
  .plot-rule {
    border-top: 1px solid var(--border);
    padding-top: 16px;
  }
  .plot-rule.has-table { margin-bottom: 20px; }
  .legend {
    display: flex;
    flex-wrap: wrap;
    flex-shrink: 0;
    gap: 16px;
    font-size: 14px;
    font-weight: 500;
    color: var(--ink-muted);
    margin-bottom: 12px;
  }
  .legend-filter {
    appearance: none;
    -webkit-appearance: none;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    border: 0;
    background: transparent;
    color: inherit;
    cursor: pointer;
    font: inherit;
    padding: 0;
    margin: 0;
    text-align: left;
  }
  .legend-filter:hover,
  .legend-filter:focus-visible,
  .legend-filter.is-active { color: var(--ink); }
  .swatch {
    width: 12px;
    height: 12px;
    border-radius: 4px;
    display: inline-block;
  }
  .swatch-attractive {
    background: rgba(18, 101, 255, 0.12);
    box-shadow: inset 0 0 0 1px #3B82F6;
  }
  .legend-item {
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }
  .chart-scroll { overflow: hidden; }
  .plot-wrap { position: relative; width: 100%; min-width: 0; }
  svg { display: block; width: 100%; height: auto; overflow: hidden; }
  svg text { font-family: Inter, -apple-system, BlinkMacSystemFont, &quot;Segoe UI&quot;, sans-serif; }
  .dot { cursor: pointer; outline: none; }
  svg.has-active .dot { opacity: 0.18; }
  svg.has-active .dot.is-active { opacity: 1; }
  svg.has-filter .dot { opacity: 0.22; }
  svg.has-filter .dot.is-filtered { opacity: 1; }
  svg.has-filter.has-active .dot.is-filtered { opacity: 0.22; }
  svg.has-filter.has-active .dot.is-filtered.is-active { opacity: 1; }
  .data-table {
    width: 100%;
    min-width: 480px;
    border-collapse: collapse;
  }
  .table-scroll { overflow-x: auto; }
  .data-table th {
    padding: 0 16px 10px 0;
    font-size: 10.5px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-faint);
    text-align: right;
  }
  .data-table th:first-child { text-align: left; }
  .data-table th:last-child { padding-right: 0; }
  .data-table td {
    padding: 10px 16px 10px 0;
    font-size: 12.5px;
    border-top: 1px solid #F3F4F6;
    font-variant-numeric: tabular-nums;
  }
  .data-table td:last-child { padding-right: 0; }
  .data-table tbody tr { cursor: pointer; }
  .data-table tbody tr.is-active { background: var(--row-active); }
  .data-table.has-active tbody tr { opacity: 0.32; }
  .data-table.has-active tbody tr.is-active { opacity: 1; }
  .model-cell {
    font-weight: 500;
    letter-spacing: -0.01em;
  }
  .num { text-align: right; }
  .caption {
    margin-top: 16px;
    font-size: 12px;
    line-height: 1.5;
    color: var(--ink-muted);
  }
  .chart-tooltip {
    position: fixed;
    z-index: 20;
    left: 0;
    top: 0;
    min-width: 176px;
    pointer-events: none;
    opacity: 0;
    transform: translate3d(-999px, -999px, 0) scale(0.98);
    transition: opacity 120ms ease, transform 120ms ease;
    border: 1px solid rgba(203, 213, 225, 0.9);
    background: rgba(255, 255, 255, 0.96);
    padding: 12px 14px;
    color: var(--ink);
    backdrop-filter: blur(10px);
  }
  .chart-tooltip.visible {
    opacity: 1;
    transform: translate3d(var(--tooltip-x), var(--tooltip-y), 0) scale(1);
  }
  .tooltip-category {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: -0.01em;
    margin-bottom: 8px;
  }
  .tooltip-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    font-size: 12.5px;
    color: var(--ink-muted);
  }
  .tooltip-model { display: flex; align-items: center; gap: 7px; }
  .tooltip-swatch { width: 10px; height: 10px; border-radius: 3px; flex: 0 0 auto; }
  .tooltip-value { color: var(--ink); font-weight: 700; font-variant-numeric: tabular-nums; }
  @media (max-width: 720px) {
    .accuracy-card { padding: 18px 14px 16px; }
    .legend { gap: 10px; font-size: 11.5px; }
    .chart-tooltip { display: none; }
    .point-label { display: none; }
  }
&lt;/style&gt;
&lt;/head&gt;
&lt;body&gt;
