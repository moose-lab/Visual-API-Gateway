const CHARTS = {&quot;document&quot;:{&quot;title&quot;:&quot;ParseBench vs. cost per 1K pages&quot;,&quot;yLabel&quot;:&quot;ParseBench score&quot;,&quot;xLabel&quot;:&quot;Cost per 1K pages (USD)&quot;,&quot;attractiveLabel&quot;:&quot;Attractive: score ≥ 70, price ≤ $2 / 1k pages&quot;,&quot;attractiveMinScore&quot;:70,&quot;attractiveMaxCost&quot;:2,&quot;modelColumn&quot;:&quot;Model&quot;,&quot;costColumn&quot;:&quot;Cost / 1K pages&quot;,&quot;caption&quot;:&quot;ParseBench 3-dimension average. Gateway sell from the 2026-08-30 catalog reprice (PR #280, output normalised to 500 tokens). Infinity Parser2 Pro: 3-dim average 79.4; overall 74.3 is the published ParseBench aggregate. Commercial prices from the ParseBench leaderboard.&quot;,&quot;xMin&quot;:0.1,&quot;xMax&quot;:50,&quot;xTicks&quot;:[0.1,0.5,1,5,10,50],&quot;yMin&quot;:45,&quot;yMax&quot;:92,&quot;yTicks&quot;:[50,60,70,80,90],&quot;points&quot;:[{&quot;id&quot;:&quot;paddleocr-vl&quot;,&quot;label&quot;:&quot;PaddleOCR-VL&quot;,&quot;group&quot;:&quot;gateway&quot;,&quot;score&quot;:67.9,&quot;cost&quot;:0.366,&quot;lx&quot;:10,&quot;ly&quot;:16,&quot;anchor&quot;:&quot;start&quot;,&quot;onFrontier&quot;:true},{&quot;id&quot;:&quot;glm-ocr&quot;,&quot;label&quot;:&quot;GLM-OCR&quot;,&quot;group&quot;:&quot;gateway&quot;,&quot;score&quot;:48.8,&quot;cost&quot;:0.384,&quot;lx&quot;:10,&quot;ly&quot;:14,&quot;anchor&quot;:&quot;start&quot;},{&quot;id&quot;:&quot;unlimited-ocr&quot;,&quot;label&quot;:&quot;Unlimited-OCR&quot;,&quot;group&quot;:&quot;gateway&quot;,&quot;score&quot;:52.7,&quot;cost&quot;:0.502,&quot;lx&quot;:10,&quot;ly&quot;:-10,&quot;anchor&quot;:&quot;start&quot;},{&quot;id&quot;:&quot;deepseek-ocr-2&quot;,&quot;label&quot;:&quot;DeepSeek-OCR-2&quot;,&quot;group&quot;:&quot;gateway&quot;,&quot;score&quot;:65.9,&quot;cost&quot;:0.683,&quot;lx&quot;:10,&quot;ly&quot;:16,&quot;anchor&quot;:&quot;start&quot;},{&quot;id&quot;:&quot;dots-mocr&quot;,&quot;label&quot;:&quot;dots.mocr&quot;,&quot;group&quot;:&quot;gateway&quot;,&quot;score&quot;:74.1,&quot;cost&quot;:0.765,&quot;lx&quot;:12,&quot;ly&quot;:18,&quot;anchor&quot;:&quot;start&quot;,&quot;onFrontier&quot;:true},{&quot;id&quot;:&quot;infinity-parser2-pro&quot;,&quot;label&quot;:&quot;Infinity Parser2 Pro&quot;,&quot;group&quot;:&quot;gateway&quot;,&quot;score&quot;:79.4,&quot;cost&quot;:2,&quot;lx&quot;:-10,&quot;ly&quot;:-14,&quot;anchor&quot;:&quot;end&quot;,&quot;onFrontier&quot;:true},{&quot;id&quot;:&quot;llamaparse-ce&quot;,&quot;label&quot;:&quot;LlamaParse CE&quot;,&quot;group&quot;:&quot;market&quot;,&quot;score&quot;:80.4,&quot;cost&quot;:3.75,&quot;lx&quot;:8,&quot;ly&quot;:-14,&quot;anchor&quot;:&quot;start&quot;,&quot;onFrontier&quot;:true},{&quot;id&quot;:&quot;mistral-ocr-4&quot;,&quot;label&quot;:&quot;Mistral OCR 4&quot;,&quot;group&quot;:&quot;market&quot;,&quot;score&quot;:76.6,&quot;cost&quot;:4,&quot;lx&quot;:0,&quot;ly&quot;:18,&quot;anchor&quot;:&quot;middle&quot;},{&quot;id&quot;:&quot;extend-light&quot;,&quot;label&quot;:&quot;Extend Light&quot;,&quot;group&quot;:&quot;market&quot;,&quot;score&quot;:73.1,&quot;cost&quot;:6.25,&quot;lx&quot;:8,&quot;ly&quot;:18,&quot;anchor&quot;:&quot;start&quot;},{&quot;id&quot;:&quot;gemini-3-flash&quot;,&quot;label&quot;:&quot;Gemini 3 Flash&quot;,&quot;group&quot;:&quot;market&quot;,&quot;score&quot;:78.1,&quot;cost&quot;:6.5,&quot;lx&quot;:8,&quot;ly&quot;:-12,&quot;anchor&quot;:&quot;start&quot;},{&quot;id&quot;:&quot;azure-di&quot;,&quot;label&quot;:&quot;Azure DI&quot;,&quot;group&quot;:&quot;market&quot;,&quot;score&quot;:74.3,&quot;cost&quot;:10,&quot;lx&quot;:0,&quot;ly&quot;:-12,&quot;anchor&quot;:&quot;middle&quot;},{&quot;id&quot;:&quot;aws-textract&quot;,&quot;label&quot;:&quot;AWS Textract&quot;,&quot;group&quot;:&quot;market&quot;,&quot;score&quot;:54.4,&quot;cost&quot;:15,&quot;lx&quot;:0,&quot;ly&quot;:16,&quot;anchor&quot;:&quot;middle&quot;},{&quot;id&quot;:&quot;reducto&quot;,&quot;label&quot;:&quot;Reducto&quot;,&quot;group&quot;:&quot;market&quot;,&quot;score&quot;:71.1,&quot;cost&quot;:23.8,&quot;lx&quot;:0,&quot;ly&quot;:16,&quot;anchor&quot;:&quot;middle&quot;},{&quot;id&quot;:&quot;extend-2&quot;,&quot;label&quot;:&quot;Extend (2.0)&quot;,&quot;group&quot;:&quot;market&quot;,&quot;score&quot;:76.6,&quot;cost&quot;:25,&quot;lx&quot;:-8,&quot;ly&quot;:-10,&quot;anchor&quot;:&quot;end&quot;}]},&quot;video&quot;:{&quot;title&quot;:&quot;MVBench vs. cost per 1K clips&quot;,&quot;yLabel&quot;:&quot;MVBench score&quot;,&quot;xLabel&quot;:&quot;Cost per 1K clips (USD)&quot;,&quot;attractiveLabel&quot;:&quot;Attractive: score ≥ 70, price ≤ $10 / 1k clips&quot;,&quot;attractiveMinScore&quot;:70,&quot;attractiveMaxCost&quot;:10,&quot;modelColumn&quot;:&quot;Model&quot;,&quot;costColumn&quot;:&quot;Cost / 1K clips&quot;,&quot;caption&quot;:&quot;MVBench accuracy (4,000 multiple-choice items, ~5–35 s clips). Gateway costs from catalog video $/hour converted to $/1k 20 s clips. Commercial dollars are published clip-cost family proxies.&quot;,&quot;xMin&quot;:0.1,&quot;xMax&quot;:50,&quot;xTicks&quot;:[0.1,0.5,1,5,10,50],&quot;yMin&quot;:62,&quot;yMax&quot;:86,&quot;yTicks&quot;:[62,66,70,74,78,82,86],&quot;points&quot;:[{&quot;id&quot;:&quot;qwen3.5-0.8b&quot;,&quot;label&quot;:&quot;qwen3.5-0.8b&quot;,&quot;group&quot;:&quot;gateway&quot;,&quot;score&quot;:68.7,&quot;cost&quot;:0.4,&quot;lx&quot;:10,&quot;ly&quot;:16,&quot;anchor&quot;:&quot;start&quot;,&quot;onFrontier&quot;:true},{&quot;id&quot;:&quot;muse-glimmer-30b&quot;,&quot;label&quot;:&quot;muse-glimmer-30b&quot;,&quot;group&quot;:&quot;gateway&quot;,&quot;score&quot;:74,&quot;cost&quot;:1.62,&quot;lx&quot;:0,&quot;ly&quot;:-14,&quot;anchor&quot;:&quot;middle&quot;,&quot;onFrontier&quot;:true},{&quot;id&quot;:&quot;gemini-2.5-flash&quot;,&quot;label&quot;:&quot;Gemini 2.5 Flash&quot;,&quot;group&quot;:&quot;market&quot;,&quot;score&quot;:67,&quot;cost&quot;:5,&quot;lx&quot;:0,&quot;ly&quot;:18,&quot;anchor&quot;:&quot;middle&quot;},{&quot;id&quot;:&quot;qwen3.8-27b&quot;,&quot;label&quot;:&quot;qwen3.8-27b&quot;,&quot;group&quot;:&quot;gateway&quot;,&quot;score&quot;:75.5,&quot;cost&quot;:5.51,&quot;lx&quot;:0,&quot;ly&quot;:-14,&quot;anchor&quot;:&quot;middle&quot;,&quot;onFrontier&quot;:true},{&quot;id&quot;:&quot;gemini-3.7-flash&quot;,&quot;label&quot;:&quot;Gemini 3.7 Flash&quot;,&quot;group&quot;:&quot;market&quot;,&quot;score&quot;:82.2,&quot;cost&quot;:9,&quot;lx&quot;:0,&quot;ly&quot;:-14,&quot;anchor&quot;:&quot;middle&quot;,&quot;onFrontier&quot;:true},{&quot;id&quot;:&quot;gemini-2.5-pro&quot;,&quot;label&quot;:&quot;Gemini 2.5 Pro&quot;,&quot;group&quot;:&quot;market&quot;,&quot;score&quot;:70.6,&quot;cost&quot;:15,&quot;lx&quot;:0,&quot;ly&quot;:-14,&quot;anchor&quot;:&quot;middle&quot;},{&quot;id&quot;:&quot;gemini-3-pro&quot;,&quot;label&quot;:&quot;Gemini 3 Pro&quot;,&quot;group&quot;:&quot;market&quot;,&quot;score&quot;:70.4,&quot;cost&quot;:20,&quot;lx&quot;:8,&quot;ly&quot;:16,&quot;anchor&quot;:&quot;start&quot;},{&quot;id&quot;:&quot;gpt-5&quot;,&quot;label&quot;:&quot;GPT-5&quot;,&quot;group&quot;:&quot;market&quot;,&quot;score&quot;:74.1,&quot;cost&quot;:25,&quot;lx&quot;:8,&quot;ly&quot;:16,&quot;anchor&quot;:&quot;start&quot;},{&quot;id&quot;:&quot;gpt-5.6-terra&quot;,&quot;label&quot;:&quot;GPT-5.6 Terra&quot;,&quot;group&quot;:&quot;market&quot;,&quot;score&quot;:75,&quot;cost&quot;:25,&quot;lx&quot;:0,&quot;ly&quot;:-14,&quot;anchor&quot;:&quot;middle&quot;},{&quot;id&quot;:&quot;claude-opus-4.8&quot;,&quot;label&quot;:&quot;Claude Opus 4.8&quot;,&quot;group&quot;:&quot;market&quot;,&quot;score&quot;:67.1,&quot;cost&quot;:35,&quot;lx&quot;:-8,&quot;ly&quot;:16,&quot;anchor&quot;:&quot;end&quot;}]}};
