  "additionalProperties": false,
  "description": "HIPAA Authorization to Release / Disclose PHI.",
  "properties": {
    "subject": {
      "anyOf": [
        {
          "$ref": "#/$defs/Person"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Patient whose PHI is being released"
    },
    "authorized_representative": {
      "anyOf": [
        {
          "$ref": "#/$defs/AuthorizedRepresentative"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Person signing on behalf of the patient"
    },
    "receiver": {
      "anyOf": [
        {
          "$ref": "#/$defs/ReleaseParty"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Party authorized to receive PHI"
    },
    "disclosing_party": {
      "anyOf": [
        {
          "$ref": "#/$defs/ReleaseParty"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Provider/facility releasing PHI"
    },
    "purpose": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Purpose of disclosure",
      "title": "Purpose"
    },
    "information_disclosed": {
      "description": "Record categories authorized for release",
      "items": {
        "type": "string"
      },
      "title": "Information Disclosed",
      "type": "array"
    },
    "record_period_start": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Record Period Start"
    },
    "record_period_end": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Record Period End"
    },
    "effective_period_start": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "When authorization takes effect",
      "title": "Effective Period Start"
    },
    "effective_period_end": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "When authorization expires",
      "title": "Effective Period End"
    },
    "expiration_event": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Event-based expiration if no fixed date",
      "title": "Expiration Event"
    },
    "redisclosure_permitted": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Redisclosure Permitted"
    },
    "right_to_revoke_acknowledged": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Right To Revoke Acknowledged"
    },
    "signature_date": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Signature Date"
    },
    "signed_by_name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Name of signer (patient or representative)",
      "title": "Signed By Name"
    },
    "witness_name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Witness Name"
    },
    "witness_signature_date": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Witness Signature Date"
    }
  },
