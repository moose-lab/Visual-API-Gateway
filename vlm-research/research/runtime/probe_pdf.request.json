{
  "method": "POST",
  "url": "https://gateway.vlm.run/v1/openai/chat/completions",
  "auth": "Bearer [REDACTED]",
  "body": {
    "model": "paddleocr/pp-ocrv6",
    "messages": [
      {
        "role": "user",
        "content": [
          {
            "type": "document_url",
            "document_url": {
              "url": "data:application/pdf;base64,"
            }
          }
        ]
      }
    ],
    "method": "text",
    "document_max_pages": 2,
    "document_dpi": 96
  }
}